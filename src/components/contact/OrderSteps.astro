---
import { orderSteps } from '../../data/process';
import TrackLabel from '../ui/TrackLabel.astro';
---

<section id="commande" class="section order" data-chapter="Commande">
  <div class="wrap">
    <header class="section-head">
      <TrackLabel track="V2" index="02" label="Commande" />
      <h2 class="h2" data-reveal="lines">Comment se passe <span class="serif">une commande.</span></h2>
      <p class="lead" data-reveal="fade">
        Pas de formulaire ni de paiement d’avance : tout se règle en discutant, et vous payez une fois la vidéo
        livrée.
      </p>
    </header>

    <ol class="order__list" data-reveal="wipe" data-reveal-start="top 82%">
      {
        orderSteps.map((step, i) => (
          <li class:list={['order__step', step.note && 'order__step--note']}>
            <span class="order__num">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="order__title">{step.title}</h3>
              <p class="order__text">{step.text}</p>
              {step.note && <span class="order__note mono">{step.note}</span>}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .order__list {
    display: grid;
    border-top: 1px solid var(--line);
  }

  @media (min-width: 72rem) {
    .order__list {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      border-top: 0;
      gap: 1rem;
    }
  }

  .order__step {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1rem;
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 72rem) {
    .order__step {
      grid-template-columns: 1fr;
      align-content: start;
      gap: 2.5rem;
      padding: 1.75rem 0 0;
      border-top: 1px solid var(--line-strong);
      border-bottom: 0;
    }
  }

  .order__num {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-rec-bright);
  }

  .order__step--note {
    border-top-color: rgb(255 77 90 / 0.55);
  }

  .order__note {
    display: inline-block;
    margin-top: 0.9rem;
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgb(255 77 90 / 0.4);
    background: rgb(229 22 42 / 0.12);
    color: var(--color-rec-bright);
    font-size: 0.55rem;
  }

  .order__title {
    font-size: 1.3rem;
    font-weight: 560;
    letter-spacing: -0.025em;
    line-height: 1.2;
  }

  .order__text {
    margin-top: 0.6rem;
    color: var(--color-fog-300);
    font-size: 0.95rem;
    max-width: 36ch;
  }
</style>
