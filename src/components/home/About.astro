---
/**
 * Accueil : « Qui monte », sur papier (la fiche de production).
 * Textes : src/data/about.ts. Portrait : l'avatar Discord (src/data/coulisses.ts → discordProfile).
 */
import { getImage } from 'astro:assets';
import { about } from '../../data/about';
import { discordProfile } from '../../data/coulisses';
import { site } from '../../config/site';
import { projectsIn } from '../../lib/portfolio';
import Icon from '../ui/Icon.astro';

const avatar = await getImage({ src: discordProfile.avatar, width: 192, height: 192, format: 'webp' });
const [intro, ...rest] = about.paragraphs;
/** Le renvoi vers le portfolio n'apparaît que si un projet crypto / trading est réellement en ligne. */
const proof = projectsIn('crypto-trading')[0] ?? null;
---

<section id="qui" class="who paper" data-spy="methode" aria-labelledby="who-title">
  <div class="wrap who__grid">
    <div class="who__id">
      <p class="label">Qui monte</p>
      <img class="who__avatar" src={avatar.src} width="96" height="96" alt="" loading="lazy" decoding="async" />
      <p class="who__handle">
        <strong>{site.name}</strong>
        {site.discord.handle && <span>{site.discord.handle} sur Discord</span>}
      </p>
    </div>

    <div class="who__main">
      <h2 class="h-title" id="who-title" data-reveal>{about.title.join(' ')}</h2>
      {intro && <p class="who__intro">{intro}</p>}
      <div class="who__rest">
        {rest.map((p) => <p>{p}</p>)}
      </div>
    </div>

    <ol class="who__expertise" aria-label="Ce que je connais de l’intérieur">
      {
        about.expertise.map((e) => (
          <li>
            <h3>{e.title}</h3>
            <p>{e.text}</p>
          </li>
        ))
      }
    </ol>

    <div class="who__foot">
      <p class="who__interests">
        <span class="label">Centres d’intérêt</span>
        {about.interests.join(' · ')}
      </p>
      <p class="who__note">{about.note}</p>
      {
        proof && (
          <a class="who__proof" href={proof.href}>
            En pratique : {proof.editType.toLowerCase()} pour {proof.creator}
            <Icon name="arrow" />
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .who {
    padding-block: clamp(5rem, 10vw, 8.5rem);
  }

  .who__grid {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: clamp(2rem, 5vw, 4.5rem) clamp(2rem, 6vw, 6rem);
  }

  .who__id {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .who__avatar {
    width: 6rem;
    height: 6rem;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 1px var(--rule);
  }

  .who__handle {
    display: grid;
    gap: 0.15rem;
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .who__handle span {
    color: var(--fg-soft);
  }

  .who__main {
    display: grid;
    gap: 1.6rem;
  }

  .who__intro {
    max-width: 44rem;
    font-size: clamp(1.15rem, 1.6vw, 1.4rem);
    font-weight: 520;
    line-height: 1.45;
    letter-spacing: -0.012em;
  }

  .who__rest {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 2.5rem;
    max-width: 52rem;
    color: var(--fg-soft);
  }

  .who__expertise {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--rule-strong);
  }

  .who__expertise li {
    padding: 1.5rem clamp(1rem, 2.5vw, 2.25rem) 0 0;
  }

  .who__expertise li + li {
    padding-left: clamp(1rem, 2.5vw, 2.25rem);
    border-left: 1px solid var(--rule);
  }

  .who__expertise h3 {
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
    font-weight: 820;
    font-stretch: 125%;
    letter-spacing: -0.03em;
    line-height: 1;
    text-transform: uppercase;
  }

  .who__expertise p {
    margin-top: 0.8rem;
    color: var(--fg-soft);
    font-size: 0.95rem;
  }

  .who__foot {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
    gap: 1rem 2.5rem;
    align-items: start;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }

  .who__interests {
    display: grid;
    gap: 0.4rem;
    font-weight: 560;
  }

  .who__note {
    color: var(--fg-soft);
    font-size: 0.9rem;
  }

  .who__proof {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-underline-offset: 0.3em;
  }

  .who__proof :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
  }

  @media (max-width: 56rem) {
    .who__grid,
    .who__rest,
    .who__expertise,
    .who__foot {
      grid-template-columns: 1fr;
    }

    .who__id {
      grid-template-columns: auto 1fr;
      align-items: center;
    }

    .who__id .label {
      grid-column: 1 / -1;
    }

    .who__expertise li,
    .who__expertise li + li {
      padding: 1.25rem 0;
      border-left: 0;
      border-bottom: 1px solid var(--rule);
    }
  }
</style>
