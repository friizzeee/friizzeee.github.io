---
/**
 * Accueil : « Behind the Edit », la démonstration de montage qui se termine sur le profil Discord.
 *
 * Mise en scène (grand écran, animations autorisées) : la scène se fige pendant le défilement.
 *  1. Le moniteur se redresse face au visiteur, la vidéo démarre (muette) et éclaire la page de ses LED.
 *  2. La timeline sous l'image suit la lecture : chapitres cliquables, moments forts marqués.
 *  3. Raccord : la caméra pousse dans le carton de fin, l'image s'éteint, la bande LED rouge reste
 *     à sa place ; la carte Discord prend la place du moniteur. Sur la timeline, la tête de lecture
 *     dépasse la fin de la vidéo et entre dans le clip suivant, « Votre projet ».
 * Téléphone et « animations réduites » : les mêmes éléments, les uns sous les autres.
 * Données : src/data/coulisses.ts · comportement : src/scripts/modules/coulisses.ts
 */
import { getImage } from 'astro:assets';
import { coulisses as c } from '../../data/coulisses';
import { site } from '../../config/site';
import Icon from '../ui/Icon.astro';
import DiscordCta from '../ui/DiscordCta.astro';
import DiscordProfileCard from '../ui/DiscordProfileCard.astro';

/** Part de la timeline occupée par la vidéo ; le reste est le clip « Votre projet ». */
const SHARE = 0.82;

const poster = await getImage({ src: c.poster, width: 1920, format: 'webp', quality: 82 });
const endFrame = await getImage({ src: c.endFrame, width: 1920, format: 'webp', quality: 82 });

const clock = (s: number): string => `${Math.floor(s / 60)}:${String(Math.floor(s % 60)).padStart(2, '0')}`;
const chapters = c.chapters.map((ch, i) => {
  const end = c.chapters[i + 1]?.start ?? c.duration;
  return { ...ch, len: end - ch.start, name: ch.num ? `${ch.num} ${ch.label}` : ch.label };
});
const playerChapters = JSON.stringify(chapters.map((ch) => ({ t: ch.start, l: ch.name })));
const nextLen = c.duration * (1 / SHARE - 1);
const first = chapters[0];
---

<section
  id="coulisses"
  class="section coul"
  data-chapter="Coulisses"
  data-coul
  data-duration={c.duration}
  data-captions={JSON.stringify(chapters.map((ch) => ch.text))}
>
  <div class="wrap">
    <header class="section-head coul__head">
      <h2 class="h2" data-reveal="lines">Behind <span class="serif">the Edit.</span></h2>
      <p class="lead" data-reveal="fade">
        42 secondes dans FilmCraft : Victoire Royale, un but de Rocket League et le best-of de Marty, repris à la
        timeline. Coupes, étalonnage, ralenti, titres et sous-titres, puis le résultat.
      </p>
    </header>
  </div>

  <div class="coul__scene" data-coul-scene>
    <div class="coul__frame-wrap" data-coul-wrap>
      <canvas class="coul__ambient" width="48" height="27" aria-hidden="true" data-coul-ambient></canvas>
      <span class="coul__wall" aria-hidden="true" data-coul-wall></span>
      <span class="coul__led" aria-hidden="true" data-coul-led></span>

      <div class="coul__frame" data-coul-frame data-follow-area>
        <video
          class="coul__video"
          src={c.file}
          data-src-light={c.fileLight}
          poster={poster.src}
          width="1920"
          height="1080"
          preload="none"
          muted
          playsinline
          controls
          aria-label={`${c.title}. Vidéo muette au départ, 42 secondes.`}
          data-coul-video></video>
        <img class="coul__end" src={endFrame.src} width="1920" height="1080" alt="" loading="lazy" decoding="async" data-coul-end />
        <span class="corners coul__corners" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <button type="button" class="coul__hit" data-play-for="coulisses-film" tabindex="-1" aria-hidden="true"></button>
        <span class="coul__follow" aria-hidden="true" data-follow>
          <Icon name="volume" />
          <span>Avec le son</span>
        </span>
        <button type="button" class="coul__start" hidden data-coul-start>
          <Icon name="play" />
          <span>Lire la démonstration</span>
        </button>
      </div>
    </div>

    <div class="coul__deck" data-coul-deck data-scrubber-avoid>
      <div class="coul__controls">
        <button type="button" class="coul__btn" data-coul-toggle aria-label="Lire">
          <span class="coul__i-play"><Icon name="play" /></span>
          <span class="coul__i-pause"><Icon name="pause" /></span>
          <span class="coul__i-replay"><Icon name="replay" /></span>
        </button>
        <button type="button" class="coul__btn" data-coul-sound aria-pressed="false" aria-label="Activer le son">
          <span class="coul__i-mute"><Icon name="mute" /></span>
          <span class="coul__i-volume"><Icon name="volume" /></span>
        </button>
        <span class="coul__tc mono" aria-hidden="true" data-coul-tc>00:00:00:00</span>
      </div>

      <div class="coul__rail" data-coul-rail data-share={SHARE}>
        <ol class="coul__clips" aria-label="Chapitres de la démonstration">
          {
            chapters.map((ch) => (
              <li class="coul__clip" style={`--len:${ch.len};--led:${ch.led}`} data-coul-clip data-start={ch.start} data-len={ch.len} data-name={ch.name}>
                <button type="button" data-coul-seek={ch.start}>
                  <span class="sr-only">
                    Aller à {clock(ch.start)} : {ch.name}
                  </span>
                  <span class="coul__clip-name" aria-hidden="true">
                    {ch.num && <span class="coul__clip-num">{ch.num}</span>}
                    <span class="coul__clip-label">{ch.num ? ch.label : ch.start === 0 ? '' : ch.label}</span>
                  </span>
                </button>
              </li>
            ))
          }
          <li class="coul__clip coul__clip--next" style={`--len:${nextLen.toFixed(2)}`} data-coul-next>
            <span class="coul__clip-name">
              <span class="coul__clip-label">Votre projet</span>
            </span>
          </li>
        </ol>
        {
          c.markers.map((m) => (
            <button
              type="button"
              class="coul__marker"
              style={`--at:${((m.at / c.duration) * SHARE * 100).toFixed(3)}%`}
              data-coul-seek={m.at}
              data-coul-marker={m.at}
            >
              <span class="coul__marker-label">
                <span class="sr-only">Moment fort à {clock(m.at)} : </span>
                {m.label}
              </span>
            </button>
          ))
        }
        <span class="coul__playhead" aria-hidden="true" data-coul-head></span>
      </div>

      <button type="button" class="btn coul__expand" data-play-for="coulisses-film" data-coul-expand>
        <span class="btn__label">
          <span>Regarder avec le son</span>
          <span aria-hidden="true">Regarder avec le son</span>
        </span>
        <span class="btn__icon" aria-hidden="true"><Icon name="expand" /></span>
      </button>
      <button
        type="button"
        id="coulisses-film"
        hidden
        data-play
        data-kind="file"
        data-src={c.file}
        data-src-light={c.fileLight}
        data-poster={poster.src}
        data-ratio="16:9"
        data-title={c.title}
        data-length="0:42"
        data-chapters={playerChapters}
        data-meta="Coulisses · FilmCraft"
        data-credits={c.credits}></button>
    </div>

    <div class="coul__meta">
      <p class="coul__caption">
        <strong data-coul-cap-title>{first?.name}</strong>
        <span data-coul-cap-text>{first?.text}</span>
      </p>
      <p class="coul__credit">
        Musique : « Brain Dance », Kevin MacLeod (incompetech.com),{' '}
        <a href="https://creativecommons.org/licenses/by/4.0/deed.fr" target="_blank" rel="noopener noreferrer"
          >licence CC BY 4.0</a
        >.
      </p>
    </div>

    <div class="coul__contact" data-coul-contact data-scrubber-avoid>
      <div class="coul__pitch">
        <h3 class="coul__title" data-coul-pitch>
          La prochaine séquence, <span class="serif">c’est la vôtre.</span>
        </h3>
        <p class="coul__lead" data-coul-pitch>
          Écrivez-moi sur Discord avec quelques mots sur votre vidéo : on en parle, puis on démarre.
        </p>
        <div data-coul-pitch>
          <DiscordCta label="Envoyer un message" />
        </div>
        {
          site.discord.handle && (
            <button type="button" class="coul__handle" data-copy={site.discord.handle} data-coul-pitch>
              <span class="coul__handle-key">Pseudo Discord</span>
              <span class="coul__handle-value">{site.discord.handle}</span>
              <span class="coul__handle-copy">
                <Icon name="copy" />
                <span data-copy-label>Copier</span>
              </span>
            </button>
          )
        }
      </div>
      <DiscordProfileCard />
    </div>
  </div>
</section>

<style>
  .coul {
    isolation: isolate;
    border-top: 1px solid var(--line);
    overflow-x: clip;
  }

  .coul__head .h2 {
    max-width: 12ch;
  }

  /* ═══ Scène : par défaut (téléphone, animations réduites, sans JS), tout se lit de haut en bas ═══ */
  .coul__scene {
    position: relative;
    display: grid;
    gap: 1.25rem;
    width: min(100% - 2 * var(--gutter), 92rem);
    margin-inline: auto;
  }

  .coul__frame-wrap {
    position: relative;
    z-index: 1;
    transform-origin: 50% 100%;
  }

  /* Les LED de la vidéo débordent sur la page : une copie minuscule de l'image, très floutée. */
  .coul__ambient {
    position: absolute;
    inset: -8% -5%;
    z-index: -1;
    width: 110%;
    height: 116%;
    opacity: 0.5;
    filter: blur(48px) saturate(1.4);
    pointer-events: none;
  }

  .coul__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: #000;
    transform-origin: 55% 45%;
    box-shadow:
      0 0 0 1px var(--line-strong),
      0 30px 60px -30px rgb(0 0 0 / 0.9),
      0 60px 140px -50px rgb(0 0 0 / 0.95);
  }

  .coul__video,
  .coul__end {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover; /* 16:9 dans un cadre 16:9 : rien n'est rogné ni étiré */
  }

  .coul__end {
    opacity: 0;
    pointer-events: none;
  }

  .coul__corners {
    inset: 1rem;
    opacity: 0.8;
  }

  .coul__hit {
    position: absolute;
    inset: 0;
    z-index: 2;
    cursor: pointer;
  }

  /* Pastille qui suit la souris : un clic ouvre le lecteur avec le son */
  .coul__follow {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    height: 3rem;
    padding-inline: 1rem 1.2rem;
    border-radius: 999px;
    background: var(--color-rec);
    color: #fff;
    font-size: 0.88rem;
    font-weight: 500;
    translate: -50% -50%;
    box-shadow: 0 14px 34px -10px rgb(229 22 42 / 0.9);
    opacity: 0;
    scale: 0.8;
    pointer-events: none;
    transition:
      opacity 0.35s ease,
      scale 0.5s var(--ease-expo);
  }

  .coul__follow :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .coul__frame:hover .coul__follow {
      opacity: 1;
      scale: 1;
    }
  }

  /* Lecture automatique refusée ou animations réduites : un vrai bouton de lecture */
  .coul__start {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 4;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 3.5rem;
    padding-inline: 1.2rem 1.5rem;
    border-radius: 999px;
    background: var(--color-rec);
    color: #fff;
    font-weight: 500;
    translate: -50% -50%;
    box-shadow: 0 18px 40px -12px rgb(229 22 42 / 0.85);
  }

  .coul__start :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  /* LED et lueur du mur : n'existent que pendant le raccord (grand écran) */
  .coul__led,
  .coul__wall {
    display: none;
  }

  /* ═══ Pupitre : commandes, timeline, lecteur ═══ */
  .coul__deck {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'rail rail'
      'controls expand';
    align-items: center;
    gap: 0.9rem 1rem;
  }

  .coul__controls {
    grid-area: controls;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .coul__btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    background: rgb(255 255 255 / 0.03);
    color: var(--color-fog-100);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease,
      scale 0.3s var(--ease-expo);
  }

  .coul__btn:hover {
    border-color: rgb(255 255 255 / 0.4);
    background: rgb(255 255 255 / 0.08);
  }

  .coul__btn:active {
    scale: 0.94;
  }

  .coul__btn > span {
    grid-area: 1 / 1;
    display: grid;
  }

  .coul__btn :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .coul__i-pause,
  .coul__i-replay,
  .coul__i-volume,
  .is-playing .coul__i-play,
  .is-ended .coul__i-play,
  .is-ended .coul__i-pause,
  [aria-pressed='true'] .coul__i-mute {
    visibility: hidden;
  }

  .is-playing:not(.is-ended) .coul__i-pause,
  .is-ended .coul__i-replay,
  [aria-pressed='true'] .coul__i-volume {
    visibility: visible;
  }

  .coul__tc {
    margin-left: 0.4rem;
    color: var(--color-fog-300);
    font-size: 0.7rem;
    font-variant-numeric: tabular-nums;
  }

  .coul__expand {
    grid-area: expand;
    justify-self: end;
    height: 2.75rem;
    padding-inline: 1.1rem 0.35rem;
    font-size: 0.86rem;
  }

  .coul__expand .btn__icon {
    width: 2.05rem;
    height: 2.05rem;
  }

  /* ── Timeline : un clip par partie, largeur proportionnelle à sa durée ── */
  .coul__rail {
    grid-area: rail;
    position: relative;
    height: 3.1rem;
  }

  .coul__clips {
    display: flex;
    height: 100%;
  }

  .coul__clip {
    --fill: 0;
    position: relative;
    flex: var(--len) 1 0%;
    min-width: 0;
  }

  /* Le bloc visible est rentré de 1,5 px : les proportions restent exactes, les clips restent séparés */
  .coul__clip::before,
  .coul__clip::after {
    content: '';
    position: absolute;
    inset: 0 1.5px;
    border-radius: 5px;
    pointer-events: none;
  }

  .coul__clip::before {
    border-top: 2px solid color-mix(in srgb, var(--led) 75%, transparent);
    background: color-mix(in srgb, var(--led) 13%, var(--color-ink-850));
  }

  /* Partie déjà lue */
  .coul__clip::after {
    background: color-mix(in srgb, var(--led) 30%, transparent);
    transform: scaleX(var(--fill));
    transform-origin: left center;
  }

  .coul__clip > button {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    width: 100%;
    height: 100%;
    padding: 0 0.6rem 0.55rem;
    border-radius: 5px;
    color: var(--color-fog-100);
    text-align: left;
    transition: background-color 0.3s ease;
  }

  .coul__clip > button:hover {
    background: rgb(255 255 255 / 0.05);
  }

  .coul__clip-name {
    display: flex;
    gap: 0.4rem;
    min-width: 0;
    overflow: hidden;
    font-size: 0.78rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1;
    white-space: nowrap;
  }

  .coul__clip-num {
    color: color-mix(in srgb, var(--led) 55%, #fff);
    font-variant-numeric: tabular-nums;
  }

  .coul__clip-label {
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* Le clip suivant n'est pas encore tourné : le motif « média hors ligne » du site */
  .coul__clip--next {
    --led: var(--color-rec);
  }

  .coul__clip--next::before {
    border: 1px dashed rgb(255 77 90 / 0.4);
    background-color: rgb(229 22 42 / 0.04);
    background-image: repeating-linear-gradient(-45deg, rgb(255 77 90 / 0.07) 0 1px, transparent 1px 10px);
  }

  .coul__clip--next::after {
    background: linear-gradient(90deg, rgb(229 22 42 / 0.55), rgb(255 77 90 / 0.85));
    box-shadow: 0 0 24px rgb(229 22 42 / 0.5);
  }

  .coul__clip--next .coul__clip-name {
    position: absolute;
    inset: auto 0.6rem 0.55rem;
    z-index: 1;
    color: var(--color-rec-bright);
  }

  /* Fin de la vidéo : le clip suivant appelle une fois, comme un repère de montage */
  .coul__clip--next.is-cued::before {
    animation: coul-cue 1.6s var(--ease-expo) 2;
  }

  /* ── Moments forts ── */
  .coul__marker {
    position: absolute;
    left: var(--at);
    top: -0.85rem;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    translate: -50% 0;
  }

  .coul__marker::before {
    content: '';
    width: 0.55rem;
    height: 0.55rem;
    rotate: 45deg;
    border-radius: 2px;
    background: var(--color-fog-100);
    box-shadow: 0 0 0 3px var(--color-ink-950);
    transition:
      background-color 0.3s ease,
      scale 0.4s var(--ease-expo);
  }

  .coul__marker-label {
    position: absolute;
    bottom: calc(100% + 0.2rem);
    left: 50%;
    padding: 0.35rem 0.6rem;
    border-radius: 999px;
    background: var(--color-fog-100);
    color: var(--color-ink-950);
    font-size: 0.74rem;
    font-weight: 600;
    white-space: nowrap;
    translate: -50% 6px;
    opacity: 0;
    pointer-events: none;
    transition:
      opacity 0.3s ease,
      translate 0.5s var(--ease-expo);
  }

  .coul__marker:hover::before,
  .coul__marker:focus-visible::before,
  .coul__marker.is-hit::before {
    background: var(--color-rec-bright);
    scale: 1.35;
  }

  .coul__marker:hover .coul__marker-label,
  .coul__marker:focus-visible .coul__marker-label,
  .coul__marker.is-hit .coul__marker-label {
    opacity: 1;
    translate: -50% 0;
  }

  .coul__marker.is-hit .coul__marker-label {
    background: var(--color-rec);
    color: #fff;
  }

  .coul__playhead {
    position: absolute;
    top: -0.35rem;
    bottom: 0;
    left: 0;
    z-index: 2;
    width: 2px;
    margin-left: -1px;
    border-radius: 2px;
    background: var(--color-rec-bright);
    box-shadow: 0 0 12px rgb(255 77 90 / 0.8);
    pointer-events: none;
    will-change: transform;
  }

  .coul__playhead::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 0.6rem;
    height: 0.45rem;
    border-radius: 2px 2px 50% 50%;
    background: inherit;
    translate: -50% 0;
  }

  /* ── Légende du moment + crédit musique ── */
  .coul__meta {
    position: relative;
    z-index: 2;
    display: grid;
    gap: 0.6rem;
  }

  .coul__caption {
    display: grid;
    gap: 0.2rem;
    max-width: 64ch;
    min-height: 3.2em;
    color: var(--color-fog-300);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  .coul__caption strong {
    color: var(--color-fog-100);
    font-weight: 560;
  }

  .coul__credit {
    color: var(--color-fog-400);
    font-size: 0.74rem;
  }

  .coul__credit a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
    text-decoration-color: rgb(255 255 255 / 0.3);
  }

  .coul__credit a:hover {
    color: var(--color-fog-100);
  }

  /* ═══ Contact : la prochaine séquence ═══ */
  .coul__contact {
    position: relative;
    z-index: 3;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    justify-items: start;
    margin-top: clamp(2rem, 6vw, 4rem);
    padding-top: clamp(3rem, 8vw, 5rem);
  }

  /* Sur téléphone, la bande LED du décor sépare la vidéo de la carte */
  .coul__contact::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    width: 100vw;
    height: 2px;
    translate: -50% 0;
    background: linear-gradient(90deg, transparent, var(--color-rec) 20%, #ff6b75 50%, var(--color-rec) 80%, transparent);
    box-shadow:
      0 0 18px 2px rgb(229 22 42 / 0.75),
      0 -40px 120px 10px rgb(229 22 42 / 0.22);
  }

  .coul__pitch {
    display: grid;
    gap: 1.4rem;
    max-width: 34rem;
  }

  .coul__title {
    font-size: clamp(2.2rem, 4.6vw, 4.4rem);
    font-weight: 560;
    letter-spacing: -0.04em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .coul__title .serif {
    font-size: 1.08em;
    line-height: 0.8;
  }

  .coul__lead {
    max-width: 42ch;
    color: var(--color-fog-300);
    font-size: clamp(1rem, 1.2vw, 1.12rem);
    line-height: 1.6;
  }

  .coul__handle {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 2.75rem;
    padding: 0.4rem 0.45rem 0.4rem 1rem;
    border-radius: 999px;
