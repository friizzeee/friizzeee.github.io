---
import DiscordButton from '../ui/DiscordButton.astro';
import Button from '../ui/Button.astro';
---

<section id="contact-cta" class="cta" data-chapter="Contact">
  <div class="cta__bg" aria-hidden="true">
    <div class="cta__glow" data-parallax="10"></div>
    <div class="cta__rings">
      <i></i><i></i><i></i>
    </div>
  </div>

  <div class="wrap cta__inner">
    <p class="cta__eyebrow mono" data-reveal="fade">
      <span class="rec-dot"></span>
      Prêt quand vous l’êtes
    </p>
    <h2 class="cta__title h-display" data-reveal="lines">On lance <span class="serif">le montage ?</span></h2>
    <p class="cta__lead lead" data-reveal="fade">
      Expliquez-moi votre projet sur Discord : on en parle, je vous confirme le délai et le tarif, puis on démarre. Vous payez une fois la vidéo livrée.
    </p>
    <div class="cta__actions" data-reveal="fade" data-reveal-delay="0.15" data-scrubber-avoid>
      <DiscordButton size="lg" />
      <Button href="/contact" size="lg">Comment ça se passe</Button>
    </div>
  </div>
</section>

<style>
  .cta {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(7rem, 16vw, 14rem);
    text-align: center;
  }

  .cta__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .cta__glow {
    position: absolute;
    left: 50%;
    top: 55%;
    width: min(70rem, 140vw);
    aspect-ratio: 1.6;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(229 22 42 / 0.38), rgb(92 8 18 / 0.2) 50%, transparent);
    filter: blur(40px);
    translate: -50% -50%;
  }

  .cta__rings {
    position: absolute;
    left: 50%;
    top: 55%;
    translate: -50% -50%;
  }

  .cta__rings i {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 20rem;
    height: 20rem;
    border-radius: 50%;
    border: 1px solid rgb(255 77 90 / 0.25);
    translate: -50% -50%;
    animation: ring 6s linear infinite;
    opacity: 0;
  }

  .cta__rings i:nth-child(2) {
    animation-delay: 2s;
  }

  .cta__rings i:nth-child(3) {
    animation-delay: 4s;
  }

  .cta__inner {
    display: grid;
    justify-items: center;
    gap: 2rem;
  }

  .cta__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-fog-300);
  }

  .cta__title {
    font-size: clamp(3.2rem, 12vw, 12.5rem);
  }

  .cta__lead {
    margin-inline: auto;
    text-align: center;
  }

  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
    margin-top: 0.5rem;
  }

  @keyframes ring {
    0% {
      opacity: 0;
      scale: 0.4;
    }
    20% {
      opacity: 1;
    }
    100% {
      opacity: 0;
      scale: 3.4;
    }
  }
</style>
