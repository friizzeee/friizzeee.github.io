---
import { Image } from 'astro:assets';
import { site } from '../../config/site';
import { heroReel } from '../../lib/portfolio';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';

/**
 * Moniteur du hero : il montre le vrai montage vedette du portfolio (aucune image inventée).
 * Sans projet vedette, le hero s'affiche simplement sans moniteur.
 */
const reel = heroReel;
const reelPoster = reel?.poster ?? null;
const reelCut = reel?.compression ?? null;
const reelMix = reel?.facts.find((f) => f.value.includes('LUFS'))?.value ?? null;
/** Boucle muette du moniteur : champ `heroLoop` du projet dans src/data/portfolio.ts (voir README). */
const reelLoop = reel?.heroLoop ?? null;

/** Échappe le HTML, passe *texte* en italique serif et remplace le point final par le point REC. */
function renderLine(line: string, isLast: boolean): string {
  let html = line.replace(/[&<>"']/g, (c) => `&#${c.charCodeAt(0)};`);
  html = html.replace(/\*(.+?)\*/g, '<em class="serif">$1</em>');
  if (isLast && html.endsWith('.')) {
    html = `${html.slice(0, -1)}<span class="hero__dot" aria-hidden="true"></span>`;
  }
  return html;
}

const lines = site.heroTitle.map((line, i) => renderLine(line, i === site.heroTitle.length - 1));
const plainTitle = site.heroTitle.join(' ').replace(/\*/g, '');

/** Mini timeline décorative : pistes et clips d'un logiciel de montage. */
const tracks = [
  {
    id: 'V2',
    kind: 'gfx',
    clips: [
      { x: 6, w: 9, label: 'Titre' },
      { x: 31, w: 7, label: 'Texte' },
      { x: 58, w: 13, label: 'Sous-titres' },
      { x: 86, w: 9, label: 'CTA' },
    ],
  },
  {
    id: 'V1',
    kind: 'video',
    clips: [
      { x: 0, w: 14, label: 'Hook' },
      { x: 14.3, w: 21, label: 'Story' },
      { x: 35.6, w: 12, label: 'B-roll' },
      { x: 47.9, w: 26, label: 'Acte II' },
      { x: 74.2, w: 25.8, label: 'Outro' },
    ],
  },
  {
    id: 'A1',
    kind: 'audio',
    clips: [
      { x: 0, w: 47.5, label: 'Musique' },
      { x: 48, w: 52, label: 'Musique' },
    ],
  },
] as const;

const rulerMarks = ['00:00', '02:00', '04:00', '06:00', '08:00', '10:00'];
---

<section id="top" class="hero" data-chapter="Intro" data-hero-root>
  <div class="hero__bg" aria-hidden="true" data-hero-bg>
    <div class="hero__layer" data-depth="-28"><div class="hero__aura hero__aura--a"></div></div>
    <div class="hero__layer" data-depth="36"><div class="hero__aura hero__aura--b"></div></div>
    <div class="hero__glow" data-hero-glow></div>
    <div class="hero__ruler" data-depth="10"></div>
    <div class="hero__dots" data-hero-dots></div>
    <div class="hero__scan"></div>
    <div class="hero__vignette"></div>
  </div>

  <div class="hero__frame wrap" aria-hidden="true" data-hero data-hero-frame>
    <div class="corners" data-depth="12"><i></i><i></i><i></i><i></i></div>
    <span class="hero__tag hero__tag--tl mono"
      ><span class="rec-dot"></span>REC <span class="hero__tc" data-live-tc>00:00:00:00</span></span
    >
    <span class="hero__tag hero__tag--tr mono">SEQ 01 — {site.name}</span>
  </div>

  <div class="hero__content wrap" data-hero-content>
    <p class="hero__eyebrow mono" data-hero>
      <span data-scramble>Monteur vidéo freelance</span><span class="hero__eyebrow-sep" aria-hidden="true"
      ></span><span data-scramble>YouTube · TikTok · Reels</span>
    </p>

    <h1 class="hero__title h-display" data-hero data-depth="-8" aria-label={plainTitle}>
      {
        lines.map((line) => (
          <span class="hero__line" aria-hidden="true">
            <span class="hero__line-inner" data-hero-line set:html={line} />
          </span>
        ))
      }
    </h1>

    <div class="hero__row">
      <p class="hero__lead lead" data-hero>{site.heroLead}</p>
      <div class="hero__ctas" data-hero>
        <Button href="/contact" variant="primary">Me contacter</Button>
        <Button href="/#portfolio" icon="arrow-down" rotateIcon={false}>Découvrir mes montages</Button>
      </div>
    </div>

    {
      reel && reelPoster && (
        <a
          href={reel.href}
          class="hero__monitor"
          data-hero
          data-hero-monitor
          data-cut-label={reel.title}
          aria-label={`Voir le projet « ${reel.title} »`}
        >
          <span class="hero__monitor-depth" data-depth="20">
            <span class="monitor" data-monitor>
              <span class="monitor__body" data-monitor-body>
                <span class="monitor__bar mono" aria-hidden="true">
                  <span class="monitor__src">
                    <i class="monitor__led" />
                    PGM · V1
                  </span>
                  <span class="monitor__tc" data-monitor-tc>
                    00:00:00:00
                  </span>
                </span>
                <span class="monitor__screen">
                  <Image
                    src={reelPoster}
                    alt=""
                    widths={[480, 720, 960]}
                    sizes="(min-width: 64rem) 38vw, 92vw"
                    loading="eager"
                    class="monitor__poster"
                  />
                  {reelLoop && (
                    <video
                      class="monitor__video"
                      muted
                      loop
                      playsinline
                      preload="none"
                      data-src={reelLoop}
                      data-monitor-video
                      aria-hidden="true"
                    />
                  )}
                  <span class="monitor__shade" aria-hidden="true" />
                  <span class="corners monitor__corners" aria-hidden="true">
                    <i />
                    <i />
                    <i />
                    <i />
                  </span>
                  <span class="monitor__flash" aria-hidden="true" data-monitor-flash />
                </span>
                <span class="monitor__progress" aria-hidden="true">
                  <i data-monitor-progress />
                </span>
                <span class="monitor__foot" aria-hidden="true">
                  <span class="monitor__name">
                    <span class="mono">Extrait du portfolio</span>
                    <span class="monitor__title">{reel.title}</span>
                  </span>
                  <span class="monitor__go">
                    <Icon name="play" />
                  </span>
                </span>
              </span>

              {reelCut && (
                <span class="hero__chip hero__chip--cut" aria-hidden="true" data-hero-chip>
                  <span class="mono">Rush → montage</span>
                  <span class="hero__chip-val">
                    {reelCut.raw} <i class="hero__chip-arrow" /> <b>{reelCut.final}</b>
                  </span>
                </span>
              )}
              {reelMix && (
                <span class="hero__chip hero__chip--mix" aria-hidden="true" data-hero-chip>
                  <span class="hero__vu">
                    <i />
                    <i />
                    <i />
                    <i />
                    <i />
                  </span>
                  <span class="hero__chip-val">{reelMix}</span>
                </span>
              )}
            </span>
          </span>
        </a>
      )
    }
  </div>

  <div class="hero__strip wrap" aria-hidden="true">
    <div class="strip" data-hero data-hero-strip>
      <div class="strip__ruler">
        <span class="strip__id"></span>
        <div class="strip__marks">
          {rulerMarks.map((m) => <span class="mono">{m}</span>)}
        </div>
      </div>
      {
        tracks.map((track) => (
          <div class="strip__track">
            <span class="strip__id mono">{track.id}</span>
            <div class="strip__lane">
              {track.clips.map((clip) => (
                <span
                  class:list={['strip__clip', `strip__clip--${track.kind}`]}
                  style={`left:${clip.x}%;width:${clip.w}%`}
                  data-strip-clip
                >
                  <span class="mono">{clip.label}</span>
                </span>
              ))}
            </div>
          </div>
        ))
      }
      <div class="strip__area" data-strip>
        <span class="strip__head" data-strip-head><i></i></span>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-top: calc(var(--header-h) + 2rem);
    overflow: hidden;
  }

  /* ── Arrière-plan ───────────────────────────── */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  /* Calques de profondeur : ils glissent légèrement avec la souris (JS) */
  .hero__layer {
    position: absolute;
    inset: 0;
  }

  .hero__aura {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    will-change: transform;
  }

  /* Balayage lumineux très lent, comme le faisceau d'un projecteur */
  .hero__scan {
    position: absolute;
    inset: -20% -40%;
    background: linear-gradient(
      100deg,
      transparent 42%,
      rgb(255 255 255 / 0.025) 48%,
      rgb(255 77 90 / 0.05) 50%,
      rgb(255 255 255 / 0.025) 52%,
      transparent 58%
    );
    animation: scan 14s cubic-bezier(0.65, 0, 0.35, 1) infinite;
    pointer-events: none;
  }

  .hero__aura--a {
    right: -12%;
    bottom: -30%;
    width: 70vmax;
    height: 55vmax;
    background: radial-gradient(closest-side, rgb(229 22 42 / 0.32), rgb(92 8 18 / 0.18) 55%, transparent);
    animation: drift-a 22s ease-in-out infinite alternate;
  }

  .hero__aura--b {
    left: -18%;
    top: -25%;
    width: 55vmax;
    height: 45vmax;
    background: radial-gradient(closest-side, rgb(160 160 180 / 0.08), transparent);
    animation: drift-b 26s ease-in-out infinite alternate;
  }

  .hero__glow {
    position: absolute;
    top: 0;
    left: 0;
    width: 34rem;
    height: 34rem;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(255 77 90 / 0.16), transparent);
    pointer-events: none;
    opacity: 0;
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__glow {
      opacity: 1;
    }
  }

  .hero__ruler {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(90deg, rgb(255 255 255 / 0.035) 1px, transparent 1px);
    background-size: calc(100% / 12) 100%;
    -webkit-mask-image: radial-gradient(ellipse 80% 70% at 50% 45%, #000 20%, transparent 80%);
    mask-image: radial-gradient(ellipse 80% 70% at 50% 45%, #000 20%, transparent 80%);
  }

  .hero__vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 120% 90% at 50% 40%, transparent 55%, rgb(6 6 7 / 0.85)),
      linear-gradient(180deg, transparent 70%, var(--color-ink-950));
  }

  /* ── Cadre viseur ───────────────────────────── */
  .hero__frame {
    position: absolute;
    top: calc(var(--header-h) + 0.75rem);
    left: 50%;
    height: calc(100% - var(--header-h) - 12.5rem);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .hero__tag {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-fog-400);
    font-size: 0.64rem;
  }

  .hero__tag--tl {
    top: 1.1rem;
    left: 1.4rem;
    color: var(--color-fog-300);
  }

  .hero__tag--tr {
    top: 1.1rem;
    right: 1.4rem;
  }

  .hero__tc {
    font-variant-numeric: tabular-nums;
  }

  /* ── Contenu ────────────────────────────────── */
  .hero__content {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-block: 3.5rem 2.5rem;
  }

  .hero__eyebrow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.9rem;
    margin-bottom: 1.75rem;
    color: var(--color-fog-400);
  }

  /* Petit trait entre les deux parties ; sur mobile, elles passent l'une sous l'autre */
  .hero__eyebrow-sep {
    width: 1.75rem;
    height: 1px;
    background: linear-gradient(90deg, var(--color-rec-bright), var(--line-strong));
  }

  .hero__eyebrow > span:last-child {
    color: var(--color-fog-300);
  }

  @media (max-width: 47.99rem) {
    .hero__eyebrow {
      flex-direction: column;
      align-items: flex-start;
    }

    .hero__eyebrow-sep {
      display: none;
    }
  }

  .hero__title {
    font-size: clamp(2.6rem, 12.4vw, 4.75rem);
  }

  @media (min-width: 48rem) {
    .hero__title {
      font-size: clamp(4.75rem, 9.6vw, 11.5rem);
    }
  }

  .hero__line {
    display: block;
    overflow: hidden;
    /* Marge pour l'italique et les jambages, sans décaler le texte */
    padding: 0.02em 0.1em 0.09em;
    margin: -0.02em -0.1em -0.09em;
  }

  .hero__line-inner {
    display: block;
  }

  .hero__line:nth-child(2) {
    padding-left: clamp(0rem, 9vw, 9rem);
  }

  .hero__title :global(em) {
    color: var(--color-fog-100);
  }

  .hero__title :global(.hero__dot) {
    display: inline-block;
    width: 0.15em;
    height: 0.15em;
    margin-left: 0.05em;
    border-radius: 50%;
    background: var(--color-rec);
    box-shadow: 0 0 0.35em rgb(229 22 42 / 0.75);
    animation: rec-blink 1.6s steps(1, end) infinite;
  }

  .hero__row {
    display: grid;
    gap: 2rem;
    align-items: end;
    margin-top: clamp(2rem, 4vw, 3.5rem);
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (min-width: 64rem) {
    .hero__row {
      grid-template-columns: 1fr auto;
      gap: 4rem;
    }
  }

  /* ── Trame de points révélée par la lumière de la souris ── */
  .hero__dots {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgb(255 255 255 / 0.2) 1px, transparent 1.5px);
    background-size: 26px 26px;
    -webkit-mask-image: radial-gradient(19rem circle at var(--gx, 74%) var(--gy, 40%), #000, transparent 72%);
    mask-image: radial-gradient(19rem circle at var(--gx, 74%) var(--gy, 40%), #000, transparent 72%);
    opacity: 0.6;
  }

  /* ── Moniteur « programme » : le vrai montage, dès l'arrivée ── */
  .hero__eyebrow,
  .hero__title,
  .hero__row {
    position: relative;
    z-index: 2;
  }

  .hero__title {
    text-shadow: 0 2px 40px rgb(6 6 7 / 0.55);
  }

  .hero__monitor {
    position: relative;
    z-index: 1;
    display: block;
    margin-top: 3rem;
    border-radius: var(--radius-lg);
  }

  .hero__monitor-depth {
    display: block;
    perspective: 1400px;
  }

  .monitor {
    position: relative;
    display: block;
    transform-style: preserve-3d;
  }

  /* Halo sous le moniteur : la lumière de l'écran qui déborde */
  .monitor::before {
    content: '';
    position: absolute;
    inset: 12% -6% -14%;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(229 22 42 / 0.32), transparent);
    filter: blur(34px);
    transform: translateZ(-60px);
    pointer-events: none;
  }

  .monitor__body {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-strong);
    background: var(--color-ink-900);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.08),
      0 2px 4px rgb(0 0 0 / 0.5),
      0 40px 80px -30px rgb(0 0 0 / 0.95),
      0 70px 120px -50px rgb(229 22 42 / 0.4);
    transition: border-color 0.5s ease;
  }

  .hero__monitor:hover .monitor__body,
  .hero__monitor:focus-visible .monitor__body {
    border-color: rgb(255 255 255 / 0.3);
  }

  .monitor__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 2rem;
    padding-inline: 0.85rem;
    border-bottom: 1px solid var(--line);
    background: rgb(255 255 255 / 0.025);
    color: var(--color-fog-400);
    font-size: 0.56rem;
  }

  .monitor__src {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-fog-300);
  }

  .monitor__led {
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 50%;
    background: var(--color-rec);
    box-shadow: 0 0 8px rgb(229 22 42 / 0.9);
  }

  .monitor__tc {
    font-variant-numeric: tabular-nums;
  }

  .monitor__screen {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #000;
  }

  .monitor__screen :global(.monitor__poster),
  .monitor__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      scale 1.4s var(--ease-expo),
      opacity 0.8s ease;
  }

  .monitor__video {
    opacity: 0;
  }

  .monitor:global(.is-live) .monitor__video {
    opacity: 1;
  }

  .hero__monitor:hover .monitor__screen :global(.monitor__poster),
  .hero__monitor:hover .monitor__video {
    scale: 1.04;
  }

  /* Le bord gauche s'assombrit : le titre passe devant l'image sans perdre en lisibilité */
  .monitor__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgb(6 6 7 / 0.9), rgb(6 6 7 / 0.5) 32%, transparent 62%),
      linear-gradient(0deg, rgb(6 6 7 / 0.78), transparent 42%);
  }

  .monitor__corners {
    inset: 0.8rem;
  }

  .monitor__corners :global(i) {
    border-color: rgb(255 255 255 / 0.5);
    transition: translate 0.7s var(--ease-expo);
  }

  /* Le bas de l'image porte déjà le titre : seuls les coins du haut restent */
  .monitor__corners :global(i:nth-child(n + 3)) {
    display: none;
  }

  .hero__monitor:hover .monitor__corners :global(i:nth-child(1)) {
    translate: 5px 5px;
  }
  .hero__monitor:hover .monitor__corners :global(i:nth-child(2)) {
    translate: -5px 5px;
  }
  .hero__monitor:hover .monitor__corners :global(i:nth-child(3)) {
    translate: 5px -5px;
  }
  .hero__monitor:hover .monitor__corners :global(i:nth-child(4)) {
    translate: -5px -5px;
  }

  /* Trait lumineux de l'allumage (animé en JS, invisible sinon) */
  .monitor__flash {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    background: #fff;
    box-shadow: 0 0 24px 4px rgb(255 255 255 / 0.7);
    opacity: 0;
    pointer-events: none;
  }

  .monitor__progress {
    position: absolute;
    inset: auto 0 0;
    height: 2px;
    background: rgb(255 255 255 / 0.1);
  }

  .monitor__progress i {
    position: absolute;
    inset: 0;
    background: var(--color-rec);
    transform: scaleX(var(--vp, 0));
    transform-origin: left;
  }

  .monitor__foot {
    position: absolute;
    inset: auto 1.1rem 1rem;
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .monitor__name {
    display: grid;
    gap: 0.3rem;
  }

  .monitor__name .mono {
    color: var(--color-fog-300);
    font-size: 0.54rem;
  }

  .monitor__title {
    color: #fff;
    font-size: 0.98rem;
    font-weight: 560;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .monitor__go {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: rgb(10 10 12 / 0.55);
    border: 1px solid rgb(255 255 255 / 0.25);
    color: #fff;
    transition:
      background-color 0.4s var(--ease-expo),
      border-color 0.4s ease,
      scale 0.6s var(--ease-expo);
  }

  .monitor__go :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
    margin-left: 2px;
  }

  .hero__monitor:hover .monitor__go,
  .hero__monitor:focus-visible .monitor__go {
    background: var(--color-rec);
    border-color: transparent;
    scale: 1.08;
  }

  /* ── Étiquettes flottantes : chiffres réels du montage ── */
  .hero__chip {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    padding: 0.55rem 0.8rem;
    border-radius: 0.75rem;
    border: 1px solid var(--line-strong);
    background: rgb(15 15 18 / 0.86);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.07),
      0 18px 36px -14px rgb(0 0 0 / 0.9);
    color: var(--color-fog-100);
    white-space: nowrap;
    transform: translateZ(46px);
    animation: chip-float 7s ease-in-out infinite alternate;
  }

  .hero__chip .mono {
    color: var(--color-fog-400);
    font-size: 0.52rem;
  }

  .hero__chip-val {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.84rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
  }

  .hero__chip-val b {
    color: var(--color-rec-bright);
    font-weight: 600;
  }

  .hero__chip-arrow {
    width: 0.9rem;
    height: 1px;
    background: var(--color-fog-400);
  }

  /* Mobile : les deux étiquettes s'accrochent sous le moniteur */
  .hero__chip--cut {
    right: 0.9rem;
    bottom: -1.9rem;
  }

  .hero__chip--mix {
    left: 0.9rem;
    bottom: -1.9rem;
    animation-delay: -3.5s;
  }

  @media (max-width: 63.99rem) {
    .hero__monitor {
      margin-bottom: 2rem;
    }
  }

  @media (min-width: 64rem) {
    .hero__chip--cut {
      top: -2.7rem;
      right: 1.75rem;
      bottom: auto;
    }

    .hero__chip--mix {
      left: 47%;
      bottom: -1.1rem;
    }
  }

  @media (max-width: 30rem) {
    .hero__chip--cut .mono {
      display: none;
    }
  }

  .hero__vu {
