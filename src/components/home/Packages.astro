---
/**
 * « Choose Your Editing Package » : deux façons de régler (en une fois, en fin de mois),
 * chacune avec une vidéo courte et une vidéo longue. Données : src/config/payment.ts.
 *
 * En tête, la claquette des offres de lancement (PromoSlate.astro). Puis chaque façon de régler a
 * sa bande : une frise (une vidéo puis un paiement / les prestations du mois puis un seul paiement),
 * son explication, puis ses deux offres. Les colonnes « courte » et « longue » sont les mêmes d'une bande à l'autre.
 * Le paiement se fait uniquement sur apa.app : chaque bouton est un simple lien.
 * Le site ne connecte aucun wallet et ne stocke rien. Comportements : src/scripts/modules/offers.ts.
 */
import {
  payment,
  billings,
  formats,
  formatUsd,
  formatDay,
  isApaLink,
  activePromo,
  promoPrice,
  packageFor,
  type Billing,
  type Package,
  type VideoFormat,
} from '../../config/payment';
import PromoSlate from './PromoSlate.astro';
import TrackLabel from '../ui/TrackLabel.astro';
import Button from '../ui/Button.astro';
import DiscordButton from '../ui/DiscordButton.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  /** id de la section (ancre du menu). */
  id?: string;
  /** Nom du chapitre dans la barre de lecture. */
  chapter?: string;
  track?: string;
  index?: string;
  /** Affiche l'encadré de sécurité sous les offres (page Contact). */
  withSafety?: boolean;
}

const { id = 'offres', chapter = 'Offres', track = 'V3', index = '05', withSafety = false } = Astro.props;

const formatOrder: VideoFormat[] = ['short', 'long'];
const modes = (Object.keys(billings) as Billing[]).map((key) => ({
  key,
  ...billings[key],
  offers: formatOrder.map((f) => packageFor(key, f)).filter((p): p is Package => p !== undefined),
}));

/** Cadre au vrai format de la vidéo, à côté du nom. */
const ratioOf: Record<VideoFormat, string> = { short: '9:16', long: '16:9' };

/** Nom complet lu par les lecteurs d'écran sur le bouton de paiement. */
const spoken = (p: Package): string =>
  `Payer sur Apa : ${formats[p.format].name}, ${billings[p.billing].title.toLowerCase()}, ${formatUsd(p.amount)} dollars (nouvel onglet)`;

/** Les promos en cours, pour la FAQ (chacune disparaît à sa date limite). */
const promoLines = payment.packages.flatMap((p) => {
  const promo = activePromo(p);
  if (!promo) return [];
  const until = promo.until ? `, jusqu’au ${formatDay(promo.until)} inclus` : '';
  return [
    {
      text: `${promo.code} : ${formatUsd(promoPrice(p, promo))} $ au lieu de ${formatUsd(p.amount)} $ (−${promo.percent} %) sur la ${formats[p.format].name.toLowerCase()} en ${billings[p.billing].title.toLowerCase()}${until}.`,
      until: promo.until,
    },
  ];
});

/** Date de fin commune des promos, pour la question « réductions permanentes ? ». */
const promoEnds = [...new Set(promoLines.map((l) => l.until).filter((u): u is string => Boolean(u)))];

/* Réponses tirées des pages Apa et des modalités fixées par nether. */
const faq: { q: string; a: string; codes?: typeof promoLines; until?: string }[] = [
  {
    q: 'Paiement en une fois ou en fin de mois : lequel choisir ?',
    a: 'Pour une vidéo précise, le paiement en une fois : vous réglez dès la vidéo livrée. Si nous travaillons ensemble régulièrement, le paiement en fin de mois : les prestations du mois sont réglées en une seule fois, à la fin du mois. Cette formule est proposée une fois qu’une relation de confiance est installée.',
  },
  {
    q: 'Le paiement en fin de mois est-il un abonnement ?',
    a: 'Non. Il n’y a ni abonnement ni prélèvement automatique. On convient ensemble des prestations du mois, je les réalise, puis vous réglez le tout en une seule fois à la fin du mois, sur la page Apa de l’offre.',
  },
  {
    q: 'Vidéo courte ou vidéo longue ?',
    a: 'La vidéo courte est un format vertical 9:16, pour TikTok et Instagram Reels. La vidéo longue est un format YouTube 16:9 de 10 minutes et plus, ma spécialité.',
  },
  ...(promoLines.length
    ? [
        {
          q: 'Comment utiliser un code promo ?',
          a: 'Copiez le code affiché sur l’offre, ouvrez sa page Apa avec le bouton, puis saisissez-le dans « Have a promo code? ». La réduction est appliquée par Apa au moment du paiement. Chaque code ne fonctionne que sur son offre.',
          codes: promoLines,
          until: promoEnds.length === 1 ? promoEnds[0] : undefined,
        },
      ]
    : []),
  ...(promoEnds.length === 1
    ? [
        {
          q: 'Les réductions sont-elles permanentes ?',
          a: `Non. Ce sont des offres de lancement, valables jusqu’au ${formatDay(promoEnds[0], true)} inclus. Passé cette date, les codes ne fonctionnent plus et les offres reviennent à leur prix normal.`,
          until: promoEnds[0],
        },
      ]
    : []),
  {
    q: 'Comment se passe le paiement ?',
    a: 'Rien n’est à payer pour commander : on définit d’abord le projet sur Discord. Le moment venu, le bouton de l’offre ouvre sa page Apa dans un nouvel onglet. Vous y payez en crypto : USDT, USDC, BTC, ETH, SOL et d’autres devises.',
  },
  ...(withSafety ? [] : [{ q: 'Comment reconnaître un vrai lien de paiement ?', a: payment.safety }]),
];
---

<section id={id} class="section pk" data-chapter={chapter}>
  <div class="pk__bg" aria-hidden="true"></div>

  <div class="wrap">
    <header class="section-head">
      <TrackLabel track={track} index={index} label="Offres" />
      <h2 class="h2" data-reveal="lines">Choose Your <span class="serif">Editing Package.</span></h2>
      <p class="lead" data-reveal="fade">{payment.intro}</p>
    </header>

    <PromoSlate id={id} />

    <!-- Petit écran : les deux modes sont loin l'un de l'autre, on peut sauter directement au bon -->
    <nav class="pk__jump" aria-label="Modes de paiement" data-reveal="fade">
      {
        modes.map((m) => (
          <a href={`#${id}-${m.key}`}>
            {m.title}
            <Icon name="arrow-down" />
          </a>
        ))
      }
    </nav>

    <div class="pk__modes" data-scrubber-avoid>
      {
        modes.map((m) => (
          <div
            class:list={['pk__mode', `pk__mode--${m.key}`]}
            id={`${id}-${m.key}`}
            role="group"
            aria-labelledby={`${id}-${m.key}-title`}
          >
            <div class="pk__cadence" aria-hidden="true" data-reveal="wipe">
              <div class="pk__cadence-track">
                <div class="pk__group">
                  <span class="pk__group-label mono">{m.cadence.label}</span>
                  <span class="pk__pay mono">{m.cadence.pay}</span>
                  <div class="pk__clips">
                    {m.cadence.clips.map((w) => (
                      <span class="pk__clip" style={`--grow:${w}`} />
                    ))}
                  </div>
                </div>
              </div>
            </div>

            <header class="pk__mode-head" data-reveal="fade">
              <h3 class="pk__mode-title" id={`${id}-${m.key}-title`}>
                {m.title}
              </h3>
              <p class="pk__mode-text">{m.text}</p>
              {m.note && <p class="pk__mode-note">{m.note}</p>}
              <p class="pk__mode-fit">
                <Icon name="check" />
                {m.fit}
              </p>
            </header>

            <ul class="pk__offers" data-reveal="cards" data-reveal-start="top 85%">
              {m.offers.map((p) => {
                const f = formats[p.format];
                const promo = activePromo(p);
                const featured = promo?.highlight === true;
                const reduced = promo ? promoPrice(p, promo) : p.amount;
                const fullPrice = (
                  <p class="pkg__amount">
                    {Number.isInteger(p.amount) ? (
                      <span data-count={p.amount} data-count-duration="1.6">
                        {formatUsd(p.amount)}
                      </span>
                    ) : (
                      formatUsd(p.amount)
                    )}
                    <span class="pkg__cur">$</span>
                  </p>
                );
                return (
                  <li
                    class:list={['pkg card', promo && 'pkg--promo', featured && 'pkg--featured']}
                    id={`${id}-${p.id}`}
                    data-tilt="3"
                    data-offer={p.id}
                    data-promo-until={promo?.until}
                  >
                    {featured && <span class="pkg__ring" aria-hidden="true" data-promo />}
                    <span class="corners pkg__corners" aria-hidden="true">
                      <i />
                      <i />
                      <i />
                      <i />
                    </span>

                    <div class="pkg__head">
                      <div>
                        <h4 class="h3 pkg__name">{f.name}</h4>
                        <p class="pkg__format mono">{f.spec}</p>
                      </div>
                      <span class:list={['pkg__frame', `pkg__frame--${p.format}`]} aria-hidden="true">
                        <span class="pkg__frame-rec" />
                        <span class="pkg__frame-ratio mono">{ratioOf[p.format]}</span>
                      </span>
                    </div>

                    <div class="pkg__price">
                      {promo ? (
                        <>
                          <p class="pkg__was" data-promo>
                            <s>
                              <span class="sr-only">Prix normal : </span>
                              {formatUsd(p.amount)}&nbsp;$
                            </s>
                            <span class="pkg__strike" aria-hidden="true" data-price-strike />
                          </p>
                          <p class="pkg__amount" data-promo data-price-from={p.amount} data-price-to={reduced}>
                            <span class="sr-only">Avec le code {promo.code} : </span>
                            <span data-price-value>{formatUsd(reduced)}</span>
                            <span class="pkg__cur">$</span>
                          </p>
                          <p class="pkg__unit mono" data-promo>
                            USD avec le code {promo.code}
                          </p>
                          <div class="pkg__expired" data-promo-off hidden>
                            {fullPrice}
                            <p class="pkg__unit mono">{m.unit}</p>
                          </div>
                          <span class="pkg__badge" data-promo>
                            −{promo.percent}&nbsp;%
                          </span>
                        </>
                      ) : (
                        <>
                          {fullPrice}
                          <p class="pkg__unit mono">{m.unit}</p>
                        </>
                      )}
                    </div>

                    <p class="pkg__desc">{f.description}</p>

                    <div class="pkg__extra">
                      {promo && (
                        <div class="pkg__promo" data-promo>
                          <button
                            type="button"
                            class="pkg__code"
                            data-copy={promo.code}
                            aria-label={`Copier le code ${promo.code}`}
                          >
                            <span class="pkg__code-value">{promo.code}</span>
                            <span class="pkg__code-action">
                              <Icon name="copy" />
                              <span data-copy-label aria-live="polite">
                                Copier
                              </span>
                            </span>
                          </button>
                          <p class="pkg__promo-text">À saisir sur la page Apa, dans «&nbsp;Have a promo code?&nbsp;».</p>
                          {promo.until && (
                            <p class="pkg__until">
                              <span class="rec-dot" aria-hidden="true" />
                              <span>
                                Offre limitée, jusqu’au <strong>{formatDay(promo.until, true)}</strong> inclus
                              </span>
                            </p>
                          )}
                        </div>
                      )}
                    </div>

                    <div class="pkg__foot">
                      {isApaLink(p.href) ? (
                        <Button
                          href={p.href}
                          external
                          variant={featured ? 'primary' : 'ghost'}
                          class="pkg__btn"
                          aria-label={spoken(p)}
                        >
                          {m.cta}
                        </Button>
                      ) : (
                        import.meta.env.DEV && (
                          <span class="pkg__warn mono" role="note">
                            ⚠ Lien Apa invalide dans src/config/payment.ts
                          </span>
                        )
                      )}
                      <span class="pkg__host mono">
                        <Icon name="shield" />
                        Paiement hébergé sur apa.app
                      </span>
                    </div>
                  </li>
                );
              })}
            </ul>
          </div>
        ))
      }
    </div>

    <div class="pk__after" data-scrubber-avoid>
      <div class="pk__start" data-reveal="fade">
        <h3 class="pk__side-title">Pas encore de projet en cours&nbsp;?</h3>
        <p>
          Commencez par un message sur Discord&nbsp;: rien n’est à payer pour commander. On définit ensemble le projet et
          l’offre qui lui correspond, puis vous réglez avec le bouton de cette offre.
        </p>
        <div class="pk__start-actions">
          <DiscordButton label="Parler de mon projet" />
          <Button href="/portfolio">Voir les montages</Button>
        </div>
      </div>

      <div class="pk__faq" data-reveal="fade">
        <h3 class="pk__side-title">Questions sur les offres</h3>
        {
          faq.map((item) => (
            <details class="pk__qa" name={`${id}-faq`} data-promo-until={item.until}>
              <summary>
                <span>{item.q}</span>
                <span class="pk__qa-icon" aria-hidden="true">
                  <Icon name="plus" />
                </span>
              </summary>
              <p>{item.a}</p>
              {item.codes && (
                <ul class="pk__qa-codes">
                  {item.codes.map((c) => (
                    <li data-promo-until={c.until}>{c.text}</li>
                  ))}
                </ul>
              )}
            </details>
          ))
        }
      </div>
    </div>

    <ul class="pk__trust" aria-label="Sécurité du paiement" data-reveal="fade" data-scrubber-avoid>
      {
        payment.trust.map((t) => (
          <li>
            <Icon name="check" />
            {t}
          </li>
        ))
      }
    </ul>

    {
      withSafety && (
        <aside class="pk__safety" aria-label="Sécurité" data-reveal="fade">
          <span class="pk__safety-icon" aria-hidden="true">
            <Icon name="shield" />
          </span>
          <p>{payment.safety}</p>
        </aside>
      )
    }
  </div>
</section>

<style>
  /* ── Section ────────────────────────────────── */
  .pk {
    isolation: isolate;
    /* La lueur qui respire ne doit pas créer de défilement horizontal */
    overflow-x: clip;
    border-top: 1px solid var(--line);
    scroll-margin-top: var(--header-h);
    /* Même découpe pour les lignes d'offres et le bloc final : colonne d'explication + offres */
    --pk-cols: minmax(15rem, 0.78fr) minmax(0, 2.22fr);
    --pk-gap: clamp(2rem, 4vw, 4.5rem);
  }

  .pk__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(ellipse 45% 40% at 50% 40%, rgb(229 22 42 / 0.1), transparent);
    pointer-events: none;
    animation: pk-breathe 9s ease-in-out infinite alternate;
  }

  /* La lueur derrière les offres respire lentement */
  @keyframes pk-breathe {
    from {
      opacity: 0.7;
      transform: scale(0.94);
    }
    to {
      opacity: 1;
      transform: scale(1.06);
    }
  }

  /* ── Accès direct aux deux modes (petit écran) ── */
  .pk__jump {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: -1rem;
    margin-bottom: 3rem;
  }

  .pk__jump a {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    min-height: 2.75rem;
    padding-inline: 0.95rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgb(255 255 255 / 0.025);
    color: var(--color-fog-100);
    font-size: 0.88rem;
    transition:
      border-color 0.3s ease,
      background-color 0.3s ease;
  }

  .pk__jump a:hover {
    border-color: rgb(255 77 90 / 0.5);
    background: rgb(229 22 42 / 0.1);
  }

  .pk__jump :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
    color: var(--color-rec-bright);
  }

  @media (min-width: 64rem) {
    .pk__jump {
      display: none;
    }
  }

  /* ── Lignes : un mode de paiement chacune ────── */
  .pk__modes {
    display: grid;
    gap: clamp(4rem, 8vw, 6.5rem);
  }

  .pk__mode {
    position: relative;
    display: grid;
    gap: 1.75rem;
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  /* Fin de mois : une bande à part, un ton plus claire et hachurée, pour qu'on ne la confonde pas
     avec le paiement en une fois. La bande va d'un bord à l'autre de l'écran. */
  .pk__mode--fin-de-mois {
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }

  .pk__mode--fin-de-mois::before {
    content: '';
    position: absolute;
    inset: 0 calc(50% - 50vw);
    z-index: -1;
    border-block: 1px solid var(--line);
    background:
      repeating-linear-gradient(-45deg, rgb(255 255 255 / 0.018) 0 1px, transparent 1px 14px),
      linear-gradient(180deg, var(--color-ink-900), rgb(10 10 12 / 0.6));
    pointer-events: none;
  }

  @media (min-width: 64rem) {
    .pk__mode {
      grid-template-columns: var(--pk-cols);
      column-gap: var(--pk-gap);
      row-gap: 2.25rem;
      align-items: start;
    }

    .pk__cadence {
      grid-column: 1 / -1;
    }

    .pk__mode-head {
      padding-top: 0.5rem;
    }
  }

  .pk__mode-title {
    font-size: clamp(2rem, 3.4vw, 3.1rem);
    font-weight: 560;
    letter-spacing: -0.04em;
    line-height: 1;
    text-wrap: balance;
  }

  .pk__mode-text {
    max-width: 36ch;
    margin-top: 1rem;
    color: var(--color-fog-300);
    font-size: 1.02rem;
    line-height: 1.55;
  }

  .pk__mode-note {
    max-width: 38ch;
    margin-top: 1.1rem;
    padding: 0.75rem 0.95rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--line-strong);
    background: rgb(255 255 255 / 0.03);
    color: var(--color-fog-100);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  .pk__mode-fit {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    max-width: 36ch;
    margin-top: 1.25rem;
    color: var(--color-fog-100);
    font-size: 0.95rem;
  }

  .pk__mode-fit :global(svg) {
    flex: none;
    width: 1.05rem;
    height: 1.05rem;
    margin-top: 0.2rem;
    color: var(--color-rec-bright);
  }

  /* ── Frise : quand tombe le paiement ─────────── */
  /* Des clips (le travail), puis un marqueur rouge (le paiement).
     En une fois : une vidéo, un paiement. En fin de mois : les prestations du mois, puis un seul paiement. */
  .pk__cadence-track {
    position: relative;
    padding-bottom: 0.8rem;
    /* Graduations de timeline */
    background:
      repeating-linear-gradient(90deg, var(--line-strong) 0 1px, transparent 1px 2.5%) left bottom / 100% 0.45rem
        no-repeat,
      linear-gradient(var(--line-strong), var(--line-strong)) left bottom / 100% 1px no-repeat;
  }

  .pk__group {
    position: relative;
    width: var(--w, 58%);
    padding-top: 2.1rem;
  }

  .pk__mode--fin-de-mois .pk__group {
    --w: 64%;
  }

  /* Accolade qui regroupe les clips */
  .pk__group::before {
    content: '';
    position: absolute;
    top: 1.3rem;
    left: 0;
    right: 0;
    height: 0.45rem;
    border: 1px solid var(--line-strong);
    border-bottom: 0;
    border-radius: 4px 4px 0 0;
  }

  /* Marqueur de paiement, juste après le dernier clip */
  .pk__group::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: -0.8rem;
    left: calc(100% + 0.35rem);
    width: 2px;
    border-radius: 2px;
    background: var(--color-rec);
    box-shadow: 0 0 12px rgb(229 22 42 / 0.75);
  }

  .pk__group-label,
  .pk__pay {
    position: absolute;
    top: 0;
    font-size: 0.6rem;
    white-space: nowrap;
  }

  .pk__group-label {
    left: 0;
    color: var(--color-fog-300);
  }

  .pk__pay {
    left: calc(100% + 0.85rem);
    color: var(--color-rec-bright);
  }

  .pk__clips {
    display: flex;
    gap: 0.35rem;
  }

  .pk__clip {
    flex: var(--grow, 1) 1 0;
    height: 1.8rem;
    border-radius: 6px;
    border: 1px solid var(--line-strong);
    background: linear-gradient(180deg, rgb(255 255 255 / 0.08), rgb(255 255 255 / 0.03));
  }

  /* ── Les deux offres d'un mode ──────────────── */
  .pk__offers {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1rem;
    perspective: 1400px;
  }

  @media (min-width: 44rem) {
    .pk__offers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      /* Lignes partagées : prix, descriptions et boutons alignés d'une carte à l'autre */
      grid-template-rows: repeat(4, auto) 1fr;
      gap: 0 1rem;
    }
  }

  /* ── Carte ──────────────────────────────────── */
  .pkg {
    display: grid;
    align-content: start;
    gap: 1.3rem;
    padding: clamp(1.5rem, 2.4vw, 2rem);
    border-radius: var(--radius-xl);
    transform-style: preserve-3d;
    transition:
      translate 0.7s var(--ease-expo),
      border-color 0.5s ease,
      box-shadow 0.7s var(--ease-expo);
  }

  @media (min-width: 44rem) {
    .pkg {
      grid-row: span 5;
      grid-template-rows: subgrid;
    }
  }

  .pkg:hover {
    translate: 0 -6px;
    border-color: var(--line-strong);
  }

  /* Une colonne : le bloc promo s'insère directement dans la carte (pas d'espace vide ailleurs).
     Deux colonnes : il occupe sa ligne pour garder les boutons alignés. */
  .pkg__extra {
    display: contents;
  }

  @media (min-width: 44rem) {
    .pkg__extra {
      display: block;
    }
  }

  /* Coins de viseur qui se resserrent au survol */
  .pkg__corners {
    inset: 0.9rem;
    opacity: 0.45;
    transition:
      inset 0.7s var(--ease-expo),
      opacity 0.5s ease;
  }

  .pkg:hover .pkg__corners {
    inset: 0.6rem;
    opacity: 1;
  }

  .pkg__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .pkg__format {
    margin-top: 0.6rem;
    color: var(--color-fog-400);
    font-size: 0.6rem;
  }

  /* ── Cadre au vrai format de la vidéo (9:16 debout, 16:9 couché), même hauteur ── */
