---
/**
 * Accueil : la sélection du portfolio (« Selected Works »).
 * Les projets `featured: true` de src/data/portfolio.ts, en grandes lignes, puis l'accès au
 * portfolio complet, par catégorie ou en entier. Chaque carte ouvre la page de son projet.
 */
import { categoryHref, featuredProjects, liveProjects, pad, usedCategories } from '../../lib/portfolio';
import TrackLabel from '../ui/TrackLabel.astro';
import Button from '../ui/Button.astro';
import Gallery from '../portfolio/Gallery.astro';
import PlayerDialog from '../portfolio/PlayerDialog.astro';

const total = liveProjects.length;
const cta = total > featuredProjects.length ? `Voir les ${pad(total)} projets` : 'Ouvrir le portfolio';
---

<section id="portfolio" class="section portfolio" data-chapter="Portfolio">
  <div class="wrap">
    <header class="section-head">
      <TrackLabel track="V2" index="02" label="Portfolio" />
      <h2 class="h2" data-reveal="lines">Selected <span class="serif">Works.</span></h2>
      <p class="lead" data-reveal="fade">
        Une sélection de vidéos que j’ai montées, de la crypto au gaming. Chaque projet a sa page : le contexte,
        les choix de montage et le travail réalisé, piste par piste.
      </p>
    </header>

    {featuredProjects.length > 0 && <Gallery projects={featuredProjects} label="Projets à la une" />}

    <div class="portfolio__more" data-reveal="fade">
      {
        usedCategories.length > 0 && (
          <nav class="portfolio__cats" aria-label="Parcourir le portfolio par catégorie">
            <p class="mono portfolio__cats-title">Par catégorie</p>
            <ul>
              {usedCategories.map((c) => (
                <li>
                  <a href={categoryHref(c.id)} class="cat-link" data-cut-label="Portfolio">
                    <span>{c.label}</span>
                    <span class="mono cat-link__count">{pad(c.count)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }
      <Button href="/portfolio" variant="primary" data-cut-label="Portfolio">{cta}</Button>
    </div>
  </div>
  <PlayerDialog />
</section>

<style>
  /* Le portfolio s'ouvre sur une lueur d'écran : on entre dans la salle de projection */
  .portfolio {
    isolation: isolate;
    border-top: 1px solid var(--line);
  }

  .portfolio::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: min(60rem, 100%);
    background:
      radial-gradient(ellipse 55% 42% at 50% 0%, rgb(229 22 42 / 0.13), transparent 70%),
      radial-gradient(ellipse 30% 20% at 50% 0%, rgb(255 255 255 / 0.05), transparent 70%);
    pointer-events: none;
  }

  /* ── Accès au portfolio complet ─────────────── */
  .portfolio__more {
    display: grid;
    gap: 2rem;
    margin-top: clamp(4.5rem, 9vw, 7.5rem);
    padding-top: clamp(1.75rem, 3vw, 2.5rem);
    border-top: 1px solid var(--line-strong);
  }

  @media (min-width: 64rem) {
    .portfolio__more {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: end;
      column-gap: 4rem;
    }
  }

  .portfolio__cats {
    display: grid;
    gap: 1rem;
  }

  .portfolio__cats-title {
    color: var(--color-fog-400);
    font-size: 0.62rem;
  }

  .portfolio__cats ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 2rem;
  }

  /* Un lien par catégorie : le trait se tire, le compteur s'allume */
  .cat-link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.6rem;
    min-height: 2.75rem;
    padding-block: 0.4rem;
    background: linear-gradient(var(--color-rec-bright), var(--color-rec-bright)) 0 100% / 0% 1px no-repeat;
    font-size: clamp(1.3rem, 2.2vw, 1.75rem);
    font-weight: 540;
    letter-spacing: -0.03em;
    transition:
      background-size 0.7s var(--ease-expo),
      color 0.3s ease;
  }

  .cat-link__count {
    color: var(--color-fog-400);
    font-size: 0.6rem;
    transition: color 0.3s ease;
  }

  .cat-link:hover,
  .cat-link:focus-visible {
    background-size: 100% 1px;
  }

  .cat-link:hover .cat-link__count,
  .cat-link:focus-visible .cat-link__count {
    color: var(--color-rec-bright);
  }
</style>
