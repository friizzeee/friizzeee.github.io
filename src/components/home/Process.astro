---
import { steps } from '../../data/process';
import TrackLabel from '../ui/TrackLabel.astro';
import Icon, { type IconName } from '../ui/Icon.astro';

const icons: IconName[] = ['chat', 'brief', 'scissors', 'send', 'wallet'];
const timecodes = ['00:00', '02:00', '04:00', '06:00', '08:00'];
---

<section id="process" class="section process-section" data-chapter="Process">
  <div class="wrap">
    <header class="section-head">
      <TrackLabel track="A2" index="04" label="Processus" />
      <h2 class="h2" data-reveal="lines">De votre idée à la <span class="serif">vidéo finale.</span></h2>
      <p class="lead" data-reveal="fade">
        Une collaboration simple, en cinq étapes, du premier message sur Discord jusqu’au paiement. Vous ne payez
        qu’une fois la vidéo livrée.
      </p>
    </header>

    <div class="process" data-process style="--progress: 0">
      <div class="process__rail" aria-hidden="true">
        <span class="process__fill"></span>
        <span class="process__head"><i></i></span>
      </div>

      <ol class="process__steps">
        {
          steps.map((step, i) => (
            <li class:list={['step', step.note && 'step--note']} data-process-step>
              <div class="step__marker">
                <span class="step__dot" aria-hidden="true" />
                <span class="mono step__tc" aria-hidden="true">{timecodes[i] ?? ''}</span>
                {step.note && <span class="step__note mono">{step.note}</span>}
              </div>
              <div class="step__clip card">
                <div class="step__top">
                  <span class="step__num">{String(i + 1).padStart(2, '0')}</span>
                  <span class="step__icon" aria-hidden="true">
                    <Icon name={icons[i] ?? 'arrow'} />
                  </span>
                </div>
                <h3 class="h3 step__title">{step.title}</h3>
                <p class="step__text">{step.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .process {
    position: relative;
    --rail-offset: 0.45rem;
  }

  /* ── Rail (vertical sur mobile, horizontal sur grand écran) ── */
  .process__rail {
    position: absolute;
    top: var(--rail-offset);
    bottom: 0;
    left: var(--rail-offset);
    width: 1px;
    background: var(--line-strong);
  }

  .process__fill {
    position: absolute;
    inset: 0;
    background: var(--color-rec);
    box-shadow: 0 0 12px rgb(229 22 42 / 0.6);
    transform: scaleY(var(--progress));
    transform-origin: top;
  }

  .process__head {
    position: absolute;
    left: 50%;
    top: calc(var(--progress) * 100%);
    width: 0.9rem;
    height: 0.9rem;
    border-radius: 50%;
    background: var(--color-rec);
    box-shadow: 0 0 0 5px rgb(229 22 42 / 0.2);
    transform: translate(-50%, -50%);
  }

  .process__steps {
    display: grid;
    gap: 1.25rem;
    padding-left: 2.25rem;
  }

  .step {
    position: relative;
    display: grid;
    gap: 0.9rem;
  }

  .step__marker {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .step__dot {
    position: absolute;
    left: calc(-2.25rem + var(--rail-offset));
    top: 0.45rem;
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--color-ink-950);
    border: 1px solid var(--line-strong);
    transform: translate(-50%, -50%);
    transition:
      background-color 0.5s ease,
      border-color 0.5s ease,
      box-shadow 0.5s ease;
  }

  .step__tc {
    color: var(--color-fog-400);
    font-size: 0.6rem;
    transition: color 0.5s ease;
  }

  .step__clip {
    display: grid;
    gap: 0.8rem;
    padding: 1.5rem 1.5rem 1.75rem;
    border-radius: var(--radius-lg);
    transition:
      border-color 0.6s ease,
      transform 0.8s var(--ease-expo),
      opacity 0.6s ease;
    opacity: 0.55;
  }

  .step__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .step__num {
    font-size: 2.75rem;
    font-weight: 560;
    letter-spacing: -0.06em;
    line-height: 1;
    color: var(--color-fog-400);
    transition: color 0.6s ease;
  }

  .step__note {
    padding: 0.3rem 0.6rem;
    border-radius: 999px;
    border: 1px solid rgb(255 77 90 / 0.4);
    /* fond opaque : le rail de la frise ne passe pas à travers */
    background: linear-gradient(rgb(229 22 42 / 0.14), rgb(229 22 42 / 0.14)), var(--color-ink-950);
    color: var(--color-rec-bright);
    font-size: 0.55rem;
    white-space: nowrap;
  }

  .step__icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--color-fog-300);
    transition:
      background-color 0.6s ease,
      border-color 0.6s ease,
      color 0.6s ease;
  }

  .step__icon :global(svg) {
    width: 1.15rem;
    height: 1.15rem;
  }

  .step__text {
    color: var(--color-fog-300);
    font-size: 0.97rem;
  }

  /* Étape « allumée » quand la tête de lecture l'atteint */
  .step:global(.is-lit) .step__clip {
    opacity: 1;
    border-color: rgb(255 77 90 / 0.35);
  }

  .step:global(.is-lit) .step__num {
    color: var(--color-fog-100);
  }

  .step:global(.is-lit) .step__icon {
    background: var(--color-rec);
    border-color: transparent;
    color: #fff;
  }

  .step:global(.is-lit) .step__dot {
    background: var(--color-rec);
    border-color: var(--color-rec);
    box-shadow: 0 0 0 5px rgb(229 22 42 / 0.18);
  }

  .step:global(.is-lit) .step__tc {
    color: var(--color-rec-bright);
  }

  /* Dernière étape (paiement) : lueur rouge quand la tête de lecture l'atteint */
  .step--note:global(.is-lit) .step__clip {
    border-color: rgb(255 77 90 / 0.55);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.05),
      0 30px 70px -35px rgb(229 22 42 / 0.55);
  }

  /* 5 étapes côte à côte : seulement sur les grands écrans, sinon frise verticale */
  @media (min-width: 80rem) {
    .process__rail {
      top: var(--rail-offset);
      left: 0;
      right: 0;
      bottom: auto;
      width: auto;
      height: 1px;
    }

    .process__fill {
      transform: scaleX(var(--progress));
      transform-origin: left;
    }

    .process__head {
      top: 50%;
      left: calc(var(--progress) * 100%);
    }

    .process__steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
      gap: 1rem;
      padding-left: 0;
    }

    .step__dot {
      position: static;
      transform: none;
      margin-top: calc(var(--rail-offset) - 0.325rem - 0.05rem);
    }

    .step__marker {
      align-items: flex-start;
      height: 2.5rem;
    }

    .step__clip {
      min-height: 17rem;
      align-content: start;
    }

    .step__text {
      margin-top: auto;
    }
  }
</style>
