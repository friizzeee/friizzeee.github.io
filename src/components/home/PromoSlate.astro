---
/**
 * Claquette des offres de lancement, au-dessus des offres : les promos en cours, leur date de fin
 * et un compte à rebours en jours (calculé dans le navigateur par src/scripts/modules/offers.ts,
 * sinon seule la date s'affiche). Disparaît d'elle-même une fois la date passée.
 */
import {
  payment,
  formats,
  billings,
  formatUsd,
  formatDay,
  activePromo,
  promoPrice,
} from '../../config/payment';
import Icon from '../ui/Icon.astro';

interface Props {
  /** id de la section : les liens « Voir l'offre » pointent vers `${id}-${offre}`. */
  id: string;
}

const { id } = Astro.props;

const promos = payment.packages.flatMap((p) => {
  const promo = activePromo(p);
  return promo ? [{ p, promo, price: promoPrice(p, promo) }] : [];
});

// shortcut: la claquette suppose une date de fin commune à toutes les promos ; avec des dates différentes, elle se masque.
const ends = [...new Set(promos.map((x) => x.promo.until))];
const until = ends.length === 1 ? ends[0] : undefined;
const [y, m, d] = until?.split('-') ?? [];
---

{
  until && (
    <aside class="slate" aria-labelledby={`${id}-promo-title`} data-slate data-promo-until={until} data-scrubber-avoid>
      <div class="clap" data-clap>
        <div class="clap__stick" aria-hidden="true" data-clap-stick />
        <div class="clap__board" data-clap-board>
          <div class="clap__stripes" aria-hidden="true" />
          <dl class="clap__grid">
            <div class="clap__cell clap__cell--wide">
              <dt class="mono">Prod.</dt>
              <dd class="clap__chalk">nether</dd>
            </div>
            <div class="clap__cell clap__cell--count">
              <dt class="mono">Fin des offres</dt>
              <dd class="clap__count">
                <span class="clap__fallback" data-countdown-fallback>
                  {d}.{m}.{y.slice(2)}
                </span>
                <span class="clap__days" data-countdown={until} hidden>
                  <span aria-hidden="true">
                    <span class="clap__j" data-countdown-prefix>
                      J−
                    </span>
                    <span data-countdown-days />
                  </span>
                  <span class="sr-only" data-countdown-spoken />
                </span>
              </dd>
            </div>
            <div class="clap__cell">
              <dt class="mono">Dernier jour</dt>
              <dd class="clap__chalk clap__chalk--date">
                <time datetime={until}>{formatDay(until, true)}</time>
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="slate__body">
        <h3 class="slate__title" id={`${id}-promo-title`}>
          {payment.launch.title}
        </h3>
        <p class="slate__text">
          {promos.length === 2 ? 'Deux réductions' : promos.length > 1 ? `${promos.length} réductions` : 'Une réduction'}, valables jusqu’au{' '}
          <strong>
            <time datetime={until}>{formatDay(until, true)}</time> inclus
          </strong>
          . {payment.launch.after}
        </p>

        <ul class="slate__tickets">
          {promos.map(({ p, promo, price }) => (
            <li class="ticket" data-ticket>
              <span class="ticket__stub">
                <span class="sr-only">Réduction de </span>−{promo.percent}&nbsp;%
              </span>
              <div class="ticket__main">
                <p class="ticket__what">
                  <span class="ticket__name">{formats[p.format].name}</span>
                  <span class="ticket__billing">{billings[p.billing].title}</span>
                </p>
                <p class="ticket__price">
                  <s>
                    <span class="sr-only">au lieu de </span>
                    {formatUsd(p.amount)}&nbsp;$
                  </s>
                  <strong>{formatUsd(price)}&nbsp;$</strong>
                </p>
                <div class="ticket__actions">
                  <button
                    type="button"
                    class="ticket__code"
                    data-copy={promo.code}
                    aria-label={`Copier le code ${promo.code}`}
                  >
                    <span class="ticket__code-value">{promo.code}</span>
                    <Icon name="copy" />
                    <span class="ticket__code-done" data-copy-label aria-live="polite" />
                  </button>
                  <a class="ticket__go" href={`#${id}-${p.id}`}>
                    Voir l’offre
                    <Icon name="arrow-down" />
                  </a>
                </div>
              </div>
            </li>
          ))}
        </ul>

        <p class="slate__fees">{payment.launch.fees}</p>
      </div>
    </aside>
  )
}

<style>
  /* ── Bloc : la claquette à gauche (même colonne que les titres des modes), les promos à droite ── */
  .slate {
    position: relative;
    display: grid;
    gap: clamp(2.25rem, 4vw, 3rem);
    margin-bottom: clamp(3.5rem, 7vw, 5rem);
    padding-block: clamp(2.25rem, 4.5vw, 3.5rem);
    border-block: 1px solid var(--line);
  }

  /* Lumière rouge qui sort de derrière la claquette */
  .slate::before {
    content: '';
    position: absolute;
    inset: 10% auto 10% -8%;
    z-index: -1;
    width: min(46rem, 80%);
    background: radial-gradient(closest-side, rgb(229 22 42 / 0.16), transparent);
    pointer-events: none;
  }

  /* Tablette : la claquette à côté du titre, les tickets sur toute la largeur en dessous */
  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .slate {
      grid-template-columns: minmax(0, 21rem) minmax(0, 1fr);
      column-gap: 2.5rem;
      row-gap: 0;
      align-items: center;
    }

    .slate__body {
      display: contents;
    }

    .clap {
      grid-row: 1 / span 2;
    }

    .slate__title {
      grid-column: 2;
      align-self: end;
    }

    .slate__text {
      grid-column: 2;
      align-self: start;
    }

    .slate__tickets,
    .slate__fees {
      grid-column: 1 / -1;
    }

    .slate__tickets {
      margin-top: 2.25rem;
    }
  }

  @media (min-width: 64rem) {
    .slate {
      grid-template-columns: var(--pk-cols);
      column-gap: var(--pk-gap);
      align-items: center;
    }
  }

  /* ── Claquette ──────────────────────────────── */
  .clap {
    --chalk: rgb(255 255 255 / 0.17);
    position: relative;
    width: min(100%, 25rem);
    padding-top: 0.5rem;
    filter: drop-shadow(0 28px 36px rgb(0 0 0 / 0.65));
  }

  /* Bras articulé, charnière à gauche */
  .clap__stick {
    position: relative;
    z-index: 1;
    height: 2.5rem;
    border-radius: 7px 7px 3px 3px;
    border: 1px solid rgb(255 255 255 / 0.3);
    background: repeating-linear-gradient(
      118deg,
      var(--color-fog-100) 0 1.3rem,
      var(--color-ink-950) 1.3rem 2.6rem
    );
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.5),
      0 10px 16px -8px rgb(0 0 0 / 0.85);
    transform-origin: 1.15rem 100%;
  }

  .clap__stick::after {
    content: '';
    position: absolute;
    left: 0.65rem;
    bottom: -0.55rem;
    width: 1rem;
    height: 1rem;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 30%, #e4e4ea, #5a5a62 70%);
    box-shadow: 0 0 0 2px var(--color-ink-950);
  }

  .clap__board {
    margin-top: 0.3rem;
    overflow: hidden;
    border-radius: 3px 3px 14px 14px;
    border: 1px solid var(--line-strong);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.035), transparent 45%),
      var(--color-ink-900);
  }

  .clap__stripes {
    height: 1.55rem;
    border-bottom: 1px solid rgb(255 255 255 / 0.3);
    background: repeating-linear-gradient(
      62deg,
      var(--color-ink-950) 0 1.3rem,
      var(--color-fog-100) 1.3rem 2.6rem
    );
  }

  /* Grille tracée à la craie, comme sur une vraie claquette */
  .clap__grid {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
  }

  .clap__cell {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    padding: 0.75rem 0.95rem 0.95rem;
  }

  .clap__cell--wide {
    grid-column: 1 / -1;
    grid-template-columns: auto 1fr;
    align-items: baseline;
    gap: 1rem;
    border-bottom: 1px solid var(--chalk);
  }

  .clap__cell--count {
    border-right: 1px solid var(--chalk);
  }

  .clap__cell dt {
    color: var(--color-fog-400);
    font-size: 0.6rem;
  }

  .clap__chalk {
    color: var(--color-fog-100);
    font-family: var(--font-serif);
    font-size: 1.45rem;
    font-style: italic;
    line-height: 1.05;
  }

  .clap__chalk--date {
    font-size: 1.3rem;
    text-wrap: balance;
  }

  .clap__count {
    color: var(--color-fog-100);
    font-size: clamp(3rem, 5vw, 4rem);
    font-weight: 600;
    letter-spacing: -0.05em;
    line-height: 0.95;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .clap__fallback {
    font-size: 0.62em;
    letter-spacing: -0.03em;
  }

  .clap__j {
    color: var(--color-rec-bright);
    letter-spacing: -0.02em;
  }

  .clap__j:empty {
    display: none;
  }

  /* ── Texte et tickets ────────────────────────── */
  .slate__title {
    font-size: clamp(2rem, 3.4vw, 3.1rem);
    font-weight: 560;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .slate__text {
    max-width: 56ch;
    margin-top: 1rem;
    color: var(--color-fog-300);
    font-size: 1.02rem;
    line-height: 1.55;
  }

  .slate__text strong {
    color: var(--color-fog-100);
    font-weight: 600;
    text-decoration: underline 2px var(--color-rec);
    text-underline-offset: 0.3em;
    text-decoration-skip-ink: none;
  }

  .slate__tickets {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  /* Un ticket : talon rouge avec la réduction, perforation, puis l'offre */
  .ticket {
    --stub: 6.25rem;
    display: grid;
    grid-template-columns: var(--stub) minmax(0, 1fr);
    border-radius: var(--radius-lg);
    border: 1px solid rgb(255 77 90 / 0.26);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.04), rgb(255 255 255 / 0.01)),
      var(--color-ink-850);
    /* Encoches de part et d'autre de la perforation */
    -webkit-mask:
      radial-gradient(circle 0.55rem at var(--stub) 0, #0000 97%, #000) top / 100% 51% no-repeat,
      radial-gradient(circle 0.55rem at var(--stub) 100%, #0000 97%, #000) bottom / 100% 51% no-repeat;
    mask:
      radial-gradient(circle 0.55rem at var(--stub) 0, #0000 97%, #000) top / 100% 51% no-repeat,
      radial-gradient(circle 0.55rem at var(--stub) 100%, #0000 97%, #000) bottom / 100% 51% no-repeat;
  }

  .ticket__stub {
    display: grid;
    place-items: center;
    border-right: 1.5px dashed rgb(255 77 90 / 0.45);
    background: radial-gradient(120% 90% at 0% 0%, rgb(229 22 42 / 0.3), rgb(229 22 42 / 0.1));
    color: var(--color-fog-100);
    font-size: clamp(1.35rem, 2vw, 1.65rem);
    font-weight: 600;
    letter-spacing: -0.04em;
    white-space: nowrap;
  }

  .ticket__main {
    display: grid;
    gap: 0.9rem 1.5rem;
    align-items: center;
    padding: 1rem 1rem 1rem 1.35rem;
  }

  @media (min-width: 40rem) {
    .ticket__main {
      grid-template-columns: minmax(0, 1fr) auto;
    }

    .ticket__actions {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 80rem) {
    .ticket__main {
      grid-template-columns: minmax(0, 1fr) auto auto;
    }

    .ticket__actions {
      grid-column: auto;
    }
  }

  .ticket__what {
    display: grid;
    gap: 0.15rem;
  }

  .ticket__name {
    color: var(--color-fog-100);
    font-size: 1.05rem;
    font-weight: 560;
    letter-spacing: -0.02em;
  }

  .ticket__billing {
    color: var(--color-fog-400);
    font-size: 0.88rem;
  }

  .ticket__price {
    display: flex;
    align-items: baseline;
    gap: 0.6rem;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .ticket__price s {
    color: var(--color-fog-400);
    font-size: 0.95rem;
    text-decoration-color: rgb(255 77 90 / 0.8);
    text-decoration-thickness: 1.5px;
  }

  .ticket__price strong {
    color: var(--color-fog-100);
    font-size: 1.45rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .ticket__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .ticket__code,
  .ticket__go {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding-inline: 0.95rem;
    border-radius: 999px;
    font-size: 0.88rem;
    transition:
      background-color 0.35s var(--ease-expo),
      border-color 0.35s var(--ease-expo),
      color 0.35s var(--ease-expo);
  }

  .ticket__code {
    border: 1px dashed rgb(255 77 90 / 0.6);
    background: rgb(229 22 42 / 0.08);
    color: var(--color-fog-100);
    cursor: pointer;
  }

  .ticket__code-value {
    font-family: var(--font-mono);
    font-weight: 500;
    letter-spacing: 0.1em;
  }

  .ticket__code :global(svg),
  .ticket__go :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
  }

  .ticket__code:hover,
  .ticket__code:focus-visible {
    border-style: solid;
    border-color: var(--color-rec-bright);
    background: rgb(229 22 42 / 0.18);
  }

  .ticket__code-done:empty {
    display: none;
  }

  .ticket__code[data-copied] {
    border-style: solid;
    border-color: #3ddc84;
    background: rgb(61 220 132 / 0.12);
  }

  .ticket__go {
    border: 1px solid var(--line-strong);
    color: var(--color-fog-100);
  }

  .ticket__go:hover,
  .ticket__go:focus-visible {
    border-color: transparent;
    background: var(--color-fog-100);
    color: var(--color-ink-950);
  }

  .slate__fees {
    margin-top: 1rem;
    color: var(--color-fog-400);
    font-size: 0.85rem;
  }

  @media (max-width: 39.99rem) {
    .ticket {
      --stub: 4.75rem;
    }

    .ticket__main {
      padding-left: 1.1rem;
    }
  }
</style>
