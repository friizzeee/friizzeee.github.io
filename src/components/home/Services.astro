---
import { services } from '../../data/services';
import TrackLabel from '../ui/TrackLabel.astro';
import Icon from '../ui/Icon.astro';
import { categoryHref, projectsIn } from '../../lib/portfolio';

/** Lien vers des exemples du portfolio, seulement si la catégorie contient un projet en ligne. */
const examplesOf = (category: string | undefined): string | null =>
  category && projectsIn(category).length > 0 ? categoryHref(category) : null;

const captionWords = ['Le', 'secret', 'du', 'hook'];
---

<section id="services" class="section services" data-chapter="Services">
  <div class="wrap">
    <header class="section-head">
      <TrackLabel track="V1" index="01" label="Services" />
      <h2 class="h2" data-reveal="lines">Un montage pensé pour <span class="serif">chaque format.</span></h2>
      <p class="lead" data-reveal="fade">
        Du long format YouTube aux vidéos verticales, chaque plateforme a son rythme. Ma spécialité : les vidéos
        de 10 minutes et plus, où chaque seconde doit donner envie de regarder la suivante.
      </p>
    </header>

    <div class="bento" data-reveal="cards" data-reveal-start="top 82%">
      {
        services.map((s, i) => (
          <article class:list={['service card', s.featured && 'service--featured', `service--${s.visual}`]} data-tilt={s.featured ? '2.5' : '4'}>
            <span class="service__index mono" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
              <span>/ {String(services.length).padStart(2, '0')}</span>
            </span>
            <div class="service__visual" aria-hidden="true">
              {s.visual === 'timeline' && (
                <div class="v-timeline">
                  <span class="v-timeline__big">
                    <span data-count="600" data-count-format="mmss" data-count-duration="2.4">10:00</span>
                    <span class="text-accent">+</span>
                  </span>
                  <div class="v-timeline__tracks">
                    <div class="v-timeline__chapters">
                      {['Hook', 'Acte I', 'Acte II', 'Climax', 'Outro'].map((c) => (
                        <span class="mono">{c}</span>
                      ))}
                    </div>
                    <div class="v-timeline__lane">
                      <i style="width:12%" />
                      <i style="width:24%" />
                      <i style="width:18%" />
                      <i style="width:28%" />
                      <i style="width:14%" />
                    </div>
                    <div class="v-timeline__lane v-timeline__lane--b">
                      <i style="width:8%;margin-left:10%" />
                      <i style="width:14%;margin-left:16%" />
                      <i style="width:10%;margin-left:20%" />
                    </div>
                    <div class="v-timeline__lane v-timeline__lane--audio">
                      <i style="width:100%" />
                    </div>
                    <span class="v-timeline__head" />
                  </div>
                </div>
              )}
              {s.visual === 'captions' && (
                <div class="v-phone">
                  <div class="v-phone__screen">
                    <span class="v-phone__ui mono">● 0:07</span>
                    <p class="v-captions">
                      {captionWords.map((w, i) => (
                        <span style={`--i:${i}`}>{w}</span>
                      ))}
                    </p>
                  </div>
                </div>
              )}
              {s.visual === 'loop' && (
                <div class="v-phone">
                  <div class="v-phone__screen v-loop">
                    <svg viewBox="0 0 100 100" class="v-loop__ring">
                      <circle cx="50" cy="50" r="38" pathLength="100" />
                      <circle cx="50" cy="50" r="38" pathLength="100" class="v-loop__progress" />
                    </svg>
                    <span class="v-loop__label mono">Loop</span>
                  </div>
                </div>
              )}
            </div>

            <div class="service__body">
              <div class="service__top">
                <span class="mono service__format">{s.format}</span>
                {s.featured && (
                  <span class="service__badge mono">
                    <span class="rec-dot" />
                    Spécialité
                  </span>
                )}
              </div>
              <h3 class="h3 service__title">{s.title}</h3>
              <p class="service__desc">{s.description}</p>
              {s.points.length > 0 && (
                <ul class="service__points">
                  {s.points.map((p) => (
                    <li>{p}</li>
                  ))}
                </ul>
              )}
              <ul class="service__tags" aria-label="Univers">
                {s.tags.map((t) => (
                  <li class="chip">{t}</li>
                ))}
              </ul>
              <div class="service__links">
                {examplesOf(s.examples) && (
                  <a
                    href={examplesOf(s.examples)}
                    class="service__link"
                    data-cut-label="Portfolio"
                    aria-label={`Voir des montages : ${s.title}`}
                  >
                    <span>Voir les montages</span>
                    <Icon name="arrow" />
                  </a>
                )}
                <a href="/#offres" class="service__link" aria-label={`Voir les offres pour : ${s.title}`}>
                  <span>Voir les offres</span>
                  <Icon name="arrow" />
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ── Grille en mosaïque ─────────────────────── */
  .bento {
    display: grid;
    gap: 1rem;
    perspective: 1400px;
  }

  @media (min-width: 48rem) {
    .bento {
      grid-template-columns: repeat(2, 1fr);
    }

    .service--featured {
      grid-column: 1 / -1;
    }
  }

  /* Grand écran : la spécialité en bandeau horizontal, les deux autres côte à côte dessous */
  @media (min-width: 72rem) {
    .bento .service--featured {
      grid-column: 1 / -1;
      flex-direction: row;
      min-height: 30rem;
    }

    /* Sélecteurs renforcés : ces règles passent avant celles de la carte vedette plus bas */
    .bento .service--featured .service__visual {
      flex: 1.15;
      padding: 4.25rem 2.5rem 2.5rem;
    }

    .bento .service--featured .v-timeline {
      align-content: center;
    }

    .bento .service--featured .service__body {
      flex: 1;
      align-content: center;
      padding: 3rem 3rem 3rem 1.5rem;
    }
  }

  .service {
    display: flex;
    flex-direction: column;
    min-height: 26rem;
    overflow: hidden;
    border-radius: var(--radius-xl);
    transform-style: preserve-3d;
    transition: border-color 0.5s ease;
  }

  .service:hover {
    border-color: var(--line-strong);
  }

  /* Numéro de clip, en haut à droite */
  .service__index {
    display: inline-flex;
    gap: 0.4em;
    position: absolute;
    top: 1.35rem;
    right: 1.5rem;
    z-index: 1;
    color: var(--color-fog-300);
    font-size: 0.62rem;
    font-variant-numeric: tabular-nums;
    transition: color 0.4s ease;
  }

  .service__index span {
    color: var(--color-fog-500);
  }

  .service:hover .service__index {
    color: var(--color-rec-bright);
  }

  /* Le badge « Spécialité » occupe déjà le coin : on décale le numéro dans la carte vedette */
  .service--featured .service__index {
    top: 1.75rem;
    left: 2.25rem;
    right: auto;
  }

  .service__visual {
    position: relative;
    flex: 1;
    min-height: 11rem;
    display: grid;
    place-items: center;
    padding: 1.5rem 1.5rem 0;
    overflow: hidden;
  }

  .service__body {
    display: grid;
    gap: 0.9rem;
    padding: 1.6rem 1.75rem 1.9rem;
  }

  .service--featured .service__body {
    padding: 2rem 2.25rem 2.4rem;
  }

  /* Carte vedette : le compteur en haut, les pistes en bas, sans vide au milieu */
  .service--featured .service__visual {
    place-items: stretch;
    padding: 3.75rem 2.25rem 0;
  }

  .service--featured .v-timeline {
    align-content: space-between;
    gap: 2rem;
  }

  /* Lueur rouge discrète derrière le compteur */
  .service--featured .service__visual::before {
    content: '';
    position: absolute;
    top: -12rem;
    left: -8rem;
    width: 32rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(229 22 42 / 0.14), transparent);
    pointer-events: none;
  }

  .service__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .service__format {
    color: var(--color-fog-400);
    font-size: 0.64rem;
  }

  .service__badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 1.75rem;
    padding-inline: 0.7rem;
    border-radius: 999px;
    background: rgb(229 22 42 / 0.14);
    border: 1px solid rgb(255 77 90 / 0.4);
    color: var(--color-rec-bright);
    font-size: 0.62rem;
  }

  .service__title {
    color: var(--color-fog-100);
  }

  .service--featured .service__title {
    font-size: clamp(1.9rem, 3vw, 2.75rem);
  }

  .service__desc {
    color: var(--color-fog-300);
    font-size: 0.97rem;
    max-width: 46ch;
  }

  .service__points {
    display: grid;
    gap: 0.45rem 1.5rem;
    margin-top: 0.25rem;
    color: var(--color-fog-100);
    font-size: 0.92rem;
  }

  @media (min-width: 40rem) {
    .service__points {
      grid-template-columns: 1fr 1fr;
    }
  }

  .service__points li {
    display: flex;
    gap: 0.6rem;
    align-items: baseline;
  }

  .service__points li::before {
    content: '';
    flex: none;
    width: 0.4rem;
    height: 1px;
    background: var(--color-rec-bright);
    transform: translateY(-0.25em);
  }

  .service__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.4rem;
  }

  .service__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1.75rem;
  }

  /* Liens « montages » et « offres » : un trait qui s'allonge, la flèche qui avance */
  .service__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    justify-self: start;
    min-height: 2.75rem;
    margin-top: 0.35rem;
    color: var(--color-fog-300);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    transition: color 0.4s ease;
  }

  .service__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0.6rem;
    height: 1px;
    background: var(--color-rec-bright);
    transform: scaleX(0.18);
    transform-origin: left;
    transition: transform 0.7s var(--ease-expo);
  }

  .service__link :global(svg) {
    width: 0.95rem;
    height: 0.95rem;
    transition: transform 0.6s var(--ease-expo);
  }

  .service__link:hover,
  .service__link:focus-visible {
    color: var(--color-fog-100);
  }

  .service__link:hover::after,
  .service__link:focus-visible::after {
    transform: scaleX(1);
  }

  .service__link:hover :global(svg),
  .service__link:focus-visible :global(svg) {
    transform: translateX(0.25rem);
  }

  /* Trame de règle derrière la grille, comme le fond d'une timeline */
  .services {
    isolation: isolate;
  }

  .services::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image: linear-gradient(90deg, rgb(255 255 255 / 0.028) 1px, transparent 1px);
    background-size: calc(100% / 12) 100%;
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 18%, #000 60%, transparent);
    mask-image: linear-gradient(180deg, transparent, #000 18%, #000 60%, transparent);
    pointer-events: none;
  }

  /* ── Visuel : timeline longue ───────────────── */
  .v-timeline {
    position: relative;
    width: 100%;
    display: grid;
    gap: 1.25rem;
  }

  .v-timeline__big {
    font-size: clamp(4.5rem, 10vw, 9rem);
    font-weight: 600;
    letter-spacing: -0.06em;
    line-height: 0.85;
    color: var(--color-fog-100);
    font-variant-numeric: tabular-nums;
  }

  .v-timeline__tracks {
    position: relative;
    display: grid;
    gap: 5px;
    padding: 0.8rem;
    border-radius: var(--radius-md);
    background: rgb(0 0 0 / 0.35);
    border: 1px solid var(--line);
  }

  .v-timeline__chapters {
    display: flex;
    justify-content: space-between;
    color: var(--color-fog-400);
  }

  .v-timeline__chapters .mono {
    font-size: 0.55rem;
  }

  .v-timeline__lane {
    display: flex;
    gap: 3px;
    height: 1.3rem;
  }

  .v-timeline__lane i {
    display: block;
    height: 100%;
    border-radius: 3px;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.16), rgb(255 255 255 / 0.08));
  }

  .v-timeline__lane--b i {
    background: rgb(229 22 42 / 0.3);
    box-shadow: inset 0 0 0 1px rgb(255 77 90 / 0.4);
  }

  .v-timeline__lane--audio i {
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.18) 0 2px, transparent 2px 5px) center / 100% 60% no-repeat,
      rgb(255 255 255 / 0.04);
  }

  .v-timeline__head {
    position: absolute;
    top: 0.5rem;
    bottom: 0.5rem;
    left: 0.8rem;
    width: 2px;
    background: var(--color-rec);
    box-shadow: 0 0 12px rgb(229 22 42 / 0.9);
    animation: playhead 9s linear infinite;
  }

  /* ── Visuel : téléphone ─────────────────────── */
  .v-phone {
    width: 8.5rem;
    aspect-ratio: 9 / 16;
    padding: 0.35rem;
    border-radius: 1.4rem;
    background: var(--color-ink-700);
    border: 1px solid var(--line-strong);
    box-shadow: 0 30px 50px -20px rgb(0 0 0 / 0.9);
    transform: translateY(1.5rem) rotate(-4deg);
    transition: transform 0.8s var(--ease-expo);
  }

  .service--loop .v-phone {
    transform: translateY(1.5rem) rotate(4deg);
  }

  .service:hover .v-phone {
    transform: translateY(0.5rem) rotate(0deg);
  }

  .v-phone__screen {
    position: relative;
    height: 100%;
    border-radius: 1.1rem;
    overflow: hidden;
    background:
      radial-gradient(circle at 30% 20%, rgb(229 22 42 / 0.35), transparent 60%),
      linear-gradient(160deg, #26262c, #0b0b0d);
  }

  .v-phone__ui {
    position: absolute;
    top: 0.7rem;
    left: 0.7rem;
    color: var(--color-fog-300);
    font-size: 0.5rem;
  }

  .v-captions {
    position: absolute;
    inset: auto 0.5rem 28%;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.15rem 0.4rem;
    font-size: 0.85rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    line-height: 1.05;
  }

  .v-captions span {
    color: #fff;
    text-shadow: 0 2px 0 #000;
    animation: caption 2.4s calc(var(--i) * 0.6s) infinite;
  }

  .v-loop {
    display: grid;
    place-items: center;
  }

  .v-loop__ring {
    width: 72%;
    transform: rotate(-90deg);
  }

  .v-loop__ring circle {
    fill: none;
    stroke: rgb(255 255 255 / 0.12);
    stroke-width: 3;
  }

  .v-loop__ring .v-loop__progress {
    stroke: var(--color-rec);
    stroke-linecap: round;
    stroke-dasharray: 100;
    animation: loop-ring 3.2s linear infinite;
  }

  .v-loop__label {
    position: absolute;
    color: var(--color-fog-300);
    font-size: 0.55rem;
  }


  @keyframes playhead {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(calc(100cqw - 1.6rem));
    }
  }

  .v-timeline__tracks {
    container-type: inline-size;
  }

  @keyframes caption {
    0%,
    100% {
      color: #fff;
      transform: scale(1);
    }
    12%,
    30% {
      color: #ffd84d;
      transform: scale(1.12);
    }
  }

  @keyframes loop-ring {
    from {
      stroke-dashoffset: 100;
    }
    to {
      stroke-dashoffset: 0;
    }
  }
</style>
