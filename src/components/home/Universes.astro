---
import { universes } from '../../data/services';
---

<section class="universes" aria-label="Univers de contenu">
  <div class="wrap universes__head">
    <p class="mono">Des univers différents, la même exigence</p>
    <p class="mono universes__count">{String(universes.length).padStart(2, '0')} univers</p>
  </div>

  <div class="marquee" data-marquee="48">
    <div class="marquee__track" data-marquee-track>
      {
        [0, 1].map((copy) => (
          <ul class="marquee__list" aria-hidden={copy === 1 ? 'true' : undefined}>
            {universes.map((name, i) => (
              <li class:list={['marquee__item', i % 2 === 1 && 'serif']}>
                {name}
                <span class="marquee__sep" aria-hidden="true" />
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>
</section>

<style>
  .universes {
    position: relative;
    padding-block: clamp(3rem, 6vw, 5rem);
    border-block: 1px solid var(--line);
    background: var(--color-ink-950);
  }

  .universes__head {
    display: flex;
    justify-content: space-between;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
    color: var(--color-fog-400);
  }

  .universes__count {
    color: var(--color-fog-400);
  }

  .marquee {
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee__track {
    display: flex;
    width: max-content;
    will-change: transform;
  }

  .marquee__list {
    display: flex;
    flex: none;
  }

  .marquee__item {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 2.75rem);
    padding-right: clamp(1.25rem, 3vw, 2.75rem);
    font-size: clamp(2.6rem, 7vw, 6.5rem);
    font-weight: 560;
    letter-spacing: -0.05em;
    line-height: 1.05;
    color: var(--color-fog-100);
    white-space: nowrap;
  }

  .marquee__item.serif {
    color: var(--color-fog-400);
    font-size: clamp(2.8rem, 7.6vw, 7rem);
  }

  .marquee__sep {
    width: 0.16em;
    height: 0.16em;
    border-radius: 50%;
    background: var(--color-rec);
    box-shadow: 0 0 0.3em rgb(229 22 42 / 0.7);
  }
</style>
