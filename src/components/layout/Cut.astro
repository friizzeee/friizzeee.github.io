---
/**
 * Transition entre les pages, comme une coupe de montage :
 * un volet noir balaie l'écran, avec le nom de la destination et un trait rouge.
 * L'élément est conservé d'une page à l'autre (transition:persist sur la racine ci-dessous :
 * posé sur <Cut /> dans le layout, il n'aurait aucun effet, un composant Astro n'ayant pas d'élément propre).
 */
---

<div class="cut" aria-hidden="true" data-cut transition:persist="cut">
  <div class="cut__panel" data-cut-panel>
    <span class="cut__edge"></span>
    <div class="cut__label">
      <span class="mono cut__meta"><span class="rec-dot"></span>Coupe · <span data-cut-tc>00:00:00:00</span></span>
      <span class="cut__title" data-cut-title></span>
      <span class="cut__bar"><i data-cut-bar></i></span>
    </div>
  </div>
</div>

<style>
  .cut {
    position: fixed;
    inset: 0;
    z-index: 160;
    pointer-events: none;
    visibility: hidden;
  }

  .cut__panel {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--color-ink-950);
    /* Pas de position de repos en CSS : la racine est masquée, le JS anime le volet en yPercent */
  }

  .cut__edge {
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: var(--color-rec);
    box-shadow: 0 0 24px 2px rgb(229 22 42 / 0.6);
  }

  .cut__label {
    display: grid;
    justify-items: center;
    gap: 0.8rem;
  }

  .cut__meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-fog-400);
  }

  .cut__title {
    font-size: clamp(2.4rem, 7vw, 6rem);
    font-weight: 560;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .cut__meta span {
    font-variant-numeric: tabular-nums;
  }

  /* Barre de chargement de la page suivante */
  .cut__bar {
    display: block;
    width: 9rem;
    height: 1px;
    margin-top: 0.4rem;
    background: var(--line-strong);
    overflow: hidden;
  }

  .cut__bar i {
    display: block;
    height: 100%;
    background: var(--color-rec);
    transform: scaleX(0);
    transform-origin: left;
  }
</style>
