---
/**
 * Pied de page en générique de fin : qui a fait quoi, comment me joindre, et les crédits
 * (musiques sous licence CC BY 4.0, décor 3D, polices). Puis « Fin ».
 */
import { site, discordHref, isDiscordConfigured } from '../../config/site';
import { about } from '../../data/about';
import { navigation, contactNav } from '../../data/navigation';

const year = new Date().getFullYear();
const profile = (label: string): string => about.profile.find((r) => r.label === label)?.value ?? '';
const external = isDiscordConfigured ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<footer class="gen">
  <div class="wrap gen__inner">
    <p class="label gen__title">Générique</p>

    <dl class="gen__roll">
      <div>
        <dt>Montage</dt>
        <dd>{site.name}</dd>
      </div>
      <div>
        <dt>Spécialité</dt>
        <dd>{profile('Spécialité')}</dd>
      </div>
      <div>
        <dt>Formats</dt>
        <dd>{profile('Formats')}</dd>
      </div>
      <div>
        <dt>Univers</dt>
        <dd>{profile('Univers')}</dd>
      </div>
      <div>
        <dt>Contact</dt>
        <dd>
          <a href={discordHref} {...external}>Discord{site.discord.handle && ` · ${site.discord.handle}`}</a>
          <br />
          <a href={`mailto:${site.email}`}>{site.email}</a>
        </dd>
      </div>
      <div>
        <dt>Paiement</dt>
        <dd>Après livraison, en crypto, sur Apa · <a href="/#tarifs">les tarifs</a></dd>
      </div>
      <div>
        <dt>Musiques des montages</dt>
        <dd>Kevin MacLeod (incompetech.com), licence CC BY 4.0 · Pixabay</dd>
      </div>
      <div>
        <dt>Décor 3D</dt>
        <dd>Poly Haven (CC0), rendu dans Blender</dd>
      </div>
      <div>
        <dt>Polices</dt>
        <dd>Archivo et Corinthia, licence OFL</dd>
      </div>
    </dl>

    <nav class="gen__nav" aria-label="Pied de page">
      {
        [...navigation, contactNav].map((item) => (
          <a class="pill" href={item.href}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <p class="gen__fin display" aria-hidden="true">Fin</p>
    <p class="gen__legal">© {year} {site.name}. {site.role}.</p>
  </div>
</footer>

<style>
  .gen {
    border-top: 1px solid var(--hair);
    background: var(--night);
    padding-block: clamp(4rem, 9vw, 7rem) 2rem;
  }

  .gen__inner {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  .gen__title {
    color: var(--fog);
  }

  /* Deux colonnes autour d'un axe, comme un générique de cinéma */
  .gen__roll {
    display: grid;
    gap: 0.9rem;
    width: min(100%, 46rem);
    margin: 2.25rem 0 0;
  }

  .gen__roll > div {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    align-items: baseline;
  }

  .gen__roll dt {
    text-align: right;
    color: var(--fog-2);
    font-size: 0.6875rem;
    font-weight: 620;
    font-stretch: 125%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .gen__roll dd {
    margin: 0;
    text-align: left;
    font-size: 0.95rem;
    font-weight: 560;
  }

  .gen__roll a {
    text-decoration: underline;
    text-decoration-color: var(--hair-strong);
    text-underline-offset: 0.3em;
    transition: text-decoration-color var(--dur-fast) ease;
  }

  .gen__roll a:hover {
    text-decoration-color: var(--cream);
  }

  .gen__nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 3rem;
  }

  .gen__fin {
    margin-top: clamp(3rem, 8vw, 6rem);
    font-size: clamp(4.5rem, 19vw, 16rem);
    color: var(--cream);
    opacity: 0.92;
  }

  .gen__legal {
    margin-top: 1.5rem;
    color: var(--fog-2);
    font-size: 0.8rem;
  }

  @media (max-width: 40rem) {
    .gen__roll > div {
      grid-template-columns: 1fr;
      gap: 0.2rem;
    }

    .gen__roll dt,
    .gen__roll dd {
      text-align: center;
    }
  }
</style>
