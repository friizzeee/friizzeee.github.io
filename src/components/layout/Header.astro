---
import { site } from '../../config/site';
import { navigation, contactNav } from '../../data/navigation';
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';
import DiscordButton from '../ui/DiscordButton.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isContact = path.startsWith('/contact');
/** Lien d'une page à part entière (pas une ancre de l'accueil) correspondant à la page affichée. */
const isPage = (href: string): boolean => !href.includes('#') && (path === href || path.startsWith(`${href}/`));
---

<header class="header" data-header>
  <div class="header__inner wrap">
    <a href="/#top" class="header__logo" aria-label={`${site.name}, retour à l’accueil`}>
      <Logo />
    </a>

    <nav class="header__nav" aria-label="Navigation principale" data-nav>
      <span class="nav-pill" aria-hidden="true" data-nav-pill></span>
      <ul>
        {
          navigation.map((item, i) => (
            <li>
              <a
                href={item.href}
                class="nav-link"
                data-nav-section={item.section}
                data-nav-page={isPage(item.href) ? '' : undefined}
                aria-current={isPage(item.href) ? 'page' : undefined}
              >
                <span class="nav-link__idx mono">0{i + 1}</span>
                <span>{item.label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header__right">
      {
        site.availability.show && (
          <span class="header__status">
            <span class="status-dot" aria-hidden="true" />
            {site.availability.label}
          </span>
        )
      }
      <a
        href={contactNav.href}
        class="header__contact"
        data-magnetic
        aria-current={isContact ? 'page' : undefined}
      >
        <span class="rec-dot" aria-hidden="true"></span>
        <span>{contactNav.label}</span>
      </a>
      <button
        type="button"
        class="header__burger"
        aria-controls="menu"
        aria-expanded="false"
        data-menu-open
      >
        <span class="sr-only">Ouvrir le menu</span>
        <i aria-hidden="true"></i>
        <i aria-hidden="true"></i>
      </button>
    </div>
  </div>
  <div class="header__progress" aria-hidden="true"><span data-progress-bar></span></div>
</header>

<dialog id="menu" class="menu" aria-label="Menu" data-menu>
  <div class="menu__glow" aria-hidden="true"></div>
  <div class="menu__top wrap">
    <Logo />
    <button type="button" class="menu__close" data-menu-close>
      <span class="sr-only">Fermer le menu</span>
      <Icon name="close" />
    </button>
  </div>

  <nav class="menu__nav wrap" aria-label="Menu mobile">
    <ol>
      {
        [...navigation, { label: contactNav.label, href: contactNav.href, section: 'contact' }].map((item, i) => (
          <li class="menu__item">
            <a href={item.href} class="menu__link" data-menu-link>
              <span class="menu__idx mono">0{i + 1}</span>
              <span class="menu__txt">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>

  <div class="menu__bottom wrap" data-menu-foot>
    <DiscordButton />
    <p class="mono menu__note">Contact sur Discord · paiement après livraison via Apa</p>
  </div>
</dialog>

<style>
  /* ── En-tête ────────────────────────────────── */
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 80;
    height: var(--header-h);
    transition:
      transform 0.7s var(--ease-expo),
      background-color 0.5s ease;
  }

  .header::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--line);
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  :global(html.is-scrolled) .header {
    background: rgb(6 6 7 / 0.72);
    backdrop-filter: blur(18px) saturate(150%);
    -webkit-backdrop-filter: blur(18px) saturate(150%);
  }

  :global(html.is-scrolled) .header::after {
    opacity: 1;
  }

  :global(html.header-hidden) .header {
    transform: translateY(-101%);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    height: 100%;
  }

  .header__logo {
    display: inline-flex;
    padding: 0.4rem 0;
  }

  .header__nav ul {
    display: flex;
    gap: 0.25rem;
  }

  .nav-link {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: baseline;
    gap: 0.45rem;
    padding: 0.55rem 0.9rem;
    border-radius: 999px;
    color: var(--color-fog-300);
    font-size: 0.92rem;
    letter-spacing: -0.01em;
    transition:
      color 0.3s ease,
      background-color 0.3s ease;
  }

  .nav-link__idx {
    font-size: 0.6rem;
    color: var(--color-fog-400);
    transition: color 0.3s ease;
  }

  .nav-link:hover {
    color: var(--color-fog-100);
  }

  /* Sans la pastille animée (JS absent), le survol garde un fond discret */
  .header__nav:not(.has-pill) .nav-link:hover {
    background: rgb(255 255 255 / 0.04);
  }

  .header__nav {
    position: relative;
  }

  .header__nav ul {
    position: relative;
  }

  /* Pastille qui glisse sous le lien survolé, ou se pose sur la section en cours */
  .nav-pill {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.055);
    box-shadow: inset 0 0 0 1px var(--line);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  /* Petit repère rouge, comme la tête de lecture */
  .nav-pill::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -0.45rem;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--color-rec);
    box-shadow: 0 0 8px rgb(229 22 42 / 0.9);
    translate: -50% 0;
  }

  .nav-link[aria-current='true'],
  .nav-link[aria-current='page'] {
    color: var(--color-fog-100);
  }

  .nav-link[aria-current='true'] .nav-link__idx,
  .nav-link[aria-current='page'] .nav-link__idx {
    color: var(--color-rec-bright);
  }

  .header__right {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .header__status {
    display: none;
    align-items: center;
    gap: 0.55rem;
    color: var(--color-fog-400);
    font-size: 0.8rem;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #3ddc84;
    box-shadow: 0 0 0 3px rgb(61 220 132 / 0.15);
  }

  .header__contact {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    height: 2.75rem;
    padding-inline: 1.15rem 1.35rem;
    border-radius: 999px;
    background: var(--color-rec);
    color: #fff;
    font-size: 0.92rem;
    font-weight: 560;
    box-shadow:
      0 10px 30px -10px rgb(229 22 42 / 0.8),
      inset 0 1px 0 rgb(255 255 255 / 0.25);
    transition:
      background-color 0.4s var(--ease-expo),
      color 0.4s var(--ease-expo);
  }

  .header__contact .rec-dot {
    background: #fff;
    box-shadow: 0 0 8px rgb(255 255 255 / 0.8);
  }

  .header__contact:hover,
  .header__contact[aria-current='page'] {
    background: var(--color-fog-100);
    color: var(--color-ink-950);
  }

  .header__contact:hover .rec-dot,
  .header__contact[aria-current='page'] .rec-dot {
    background: var(--color-rec);
  }

  .header__burger {
    display: grid;
    place-content: center;
    gap: 6px;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    cursor: pointer;
  }

  .header__burger i {
    display: block;
    width: 18px;
    height: 1.5px;
    background: var(--color-fog-100);
    transition: transform 0.4s var(--ease-expo);
  }

  .header__burger:hover i:first-of-type {
    transform: translateX(-3px);
  }

  .header__burger:hover i:last-of-type {
    transform: translateX(3px);
  }

  .header__progress {
    position: absolute;
    inset: auto 0 0;
    height: 2px;
  }

  .header__progress span {
    display: block;
    height: 100%;
    background: var(--color-rec);
    transform: scaleX(0);
    transform-origin: left;
  }

  .header__nav {
    display: none;
  }

  @media (min-width: 64rem) {
    .header__nav {
      display: block;
    }

    .header__burger,
    .header__progress {
      display: none;
    }
  }

  @media (min-width: 80rem) {
    .header__status {
      display: inline-flex;
    }
  }

  /* ── Menu mobile ────────────────────────────── */
  .menu {
    position: fixed;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    overflow: hidden auto;
    background: var(--color-ink-950);
    color: var(--color-fog-100);
  }

  .menu[open] {
    display: flex;
    flex-direction: column;
  }

  .menu::backdrop {
    background: transparent;
  }

  .menu__glow {
    position: absolute;
    inset: auto -20% -30% -20%;
    height: 70%;
    background: radial-gradient(closest-side, rgb(229 22 42 / 0.22), transparent);
    pointer-events: none;
  }

  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
    flex: none;
  }

  .menu__close {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    cursor: pointer;
  }

  .menu__close :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .menu__nav {
    flex: 1;
    display: flex;
    align-items: center;
    padding-block: 2rem;
  }

  .menu__nav ol {
    display: grid;
    gap: 0.25rem;
    width: 100%;
  }

  .menu__item {
    overflow: hidden;
    border-bottom: 1px solid var(--line);
  }

  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding-block: 0.65rem;
    font-size: clamp(2.4rem, 11vw, 4.5rem);
    font-weight: 560;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .menu__idx {
    color: var(--color-rec-bright);
    font-size: 0.7rem;
    transform: translateY(-1.6em);
  }

  .menu__txt {
    transition:
      translate 0.6s var(--ease-expo),
      color 0.3s ease;
  }

  /* Le lien glisse légèrement, comme un clip qu'on attrape */
  .menu__link:hover .menu__txt,
  .menu__link:focus-visible .menu__txt {
    translate: 0.3em 0;
    color: var(--color-fog-300);
  }

  .menu__bottom {
    display: grid;
    gap: 1rem;
    padding-bottom: max(2rem, env(safe-area-inset-bottom));
  }

  .menu__note {
    color: var(--color-fog-400);
    font-size: 0.66rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
