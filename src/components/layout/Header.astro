---
/**
 * En-tête : pastilles de navigation à gauche (la pastille crème suit la section affichée),
 * logo au centre, contact à droite, comme sur la référence. Téléphone et tablette : bouton « Menu ».
 * Comportement : src/scripts/modules/header.ts.
 */
import { site, discordHref, isDiscordConfigured } from '../../config/site';
import { navigation, contactNav } from '../../data/navigation';
import { pad } from '../../lib/portfolio';
import Logo from '../ui/Logo.astro';
import Icon from '../ui/Icon.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const current = path.startsWith('/portfolio') ? 'realisations' : path.startsWith('/contact') ? 'contact' : path === '/' ? 'top' : '';
const external = isDiscordConfigured ? { target: '_blank', rel: 'noopener noreferrer' } : {};
const menuItems = [...navigation, { label: contactNav.label, href: contactNav.href, section: 'contact' }];
---

<header class="hdr" data-header>
  <nav class="hdr__nav" aria-label="Navigation principale">
    <ul class="hdr__pills" data-pills>
      {
        navigation.map((item) => (
          <li>
            <a
              class:list={['hdr__pill', current === item.section && 'is-on']}
              href={item.href}
              data-spy-link={item.section}
              aria-current={current === item.section ? 'page' : undefined}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <a class="hdr__logo" href="/">
    <Logo />
  </a>

  <div class="hdr__right">
    <a
      class="hdr__link"
      href={contactNav.href}
      data-spy-link="contact"
      aria-current={current === 'contact' ? 'page' : undefined}>{contactNav.label}</a
    >
    <a class="hdr__link hdr__link--cta" href={discordHref} {...external}>
      Écrire sur Discord
      <Icon name="arrow" />
      <span class="sr-only">(nouvel onglet)</span>
    </a>
    <button type="button" class="hdr__menu pill" aria-controls="menu" aria-expanded="false" data-menu-open>Menu</button>
  </div>
</header>

<dialog id="menu" class="menu" aria-label="Menu" data-menu>
  <div class="menu__top">
    <Logo />
    <button type="button" class="pill" data-menu-close>
      Fermer
      <Icon name="close" />
    </button>
  </div>
  <nav aria-label="Menu">
    <ol class="menu__list">
      {
        menuItems.map((item, i) => (
          <li>
            <a class="menu__link" href={item.href} data-menu-link>
              <span class="label num">{pad(i + 1)}</span>
              <span class="menu__txt">{item.label}</span>
            </a>
          </li>
        ))
      }
    </ol>
  </nav>
  <div class="menu__foot">
    <a class="pill pill--solid pill--lg" href={discordHref} {...external}>
      <Icon name="discord" />
      Écrire sur Discord
    </a>
    <a class="menu__mail" href={`mailto:${site.email}`}>{site.email}</a>
  </div>
</dialog>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    height: var(--header-h);
    padding: 0 var(--gutter);
    border-bottom: 1px solid transparent;
    transition:
      background-color var(--dur-normal) ease,
      border-color var(--dur-normal) ease;
  }

  /* Fond presque opaque, sans flou : un flou d'arrière-plan serait recalculé à chaque image du plan-séquence */
  .hdr:global(.is-solid) {
    background: rgb(11 9 7 / 0.94);
    border-bottom-color: var(--hair);
  }

  /* ── Pastilles : la crème glisse d'une pastille à l'autre (clip-path posé par header.ts) ── */
  .hdr__pills {
    position: relative;
    display: flex;
    gap: 0.35rem;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hdr__pills::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 999px;
    background: var(--cream);
    clip-path: inset(0 calc(100% - var(--pill-r, 0px)) 0 var(--pill-l, 0px) round 999px);
    transition: clip-path var(--dur-slow) var(--ease-expo);
    pointer-events: none;
  }

  .hdr__pill {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-height: 2.25rem;
    padding: 0 1rem;
    border: 1px solid rgb(239 228 200 / 0.34);
    border-radius: 999px;
    color: var(--cream);
    font-size: 0.65rem;
    font-weight: 660;
    font-stretch: 125%;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    transition:
      color var(--dur-normal) ease,
      border-color var(--dur-fast) ease;
  }

  .hdr__pill:hover {
    border-color: var(--cream);
  }

  .hdr__pill:global(.is-on) {
    border-color: var(--cream);
    color: var(--night);
  }

  /* Sans JavaScript : la pastille de la page reste pleine */
  :global(html:not(.js)) .hdr__pill:global(.is-on) {
    background: var(--cream);
  }

  .hdr__logo {
    justify-self: center;
    padding: 0.4rem;
  }

  .hdr__right {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 1.4rem;
  }

  .hdr__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    color: var(--cream);
    font-size: 0.65rem;
    font-weight: 660;
    font-stretch: 125%;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    background: linear-gradient(currentColor, currentColor) left calc(50% + 0.8em) / 0 1px no-repeat;
    transition: background-size var(--dur-normal) var(--ease-out);
  }

  .hdr__link:hover,
  .hdr__link[aria-current],
  .hdr__link:global(.is-on) {
    background-size: 100% 1px;
  }

  .hdr__link--cta {
    background: none;
  }

  .hdr__link :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
    transition: transform var(--dur-normal) var(--ease-out);
  }

  .hdr__link--cta:hover :global(svg) {
    transform: translateX(3px);
  }

  .hdr__menu {
    display: none;
    min-height: 2.5rem;
  }

  @media (max-width: 64rem) {
    .hdr {
      grid-template-columns: 1fr auto;
    }

    .hdr__nav,
    .hdr__link {
      display: none;
    }

    .hdr__logo {
      justify-self: start;
      padding-left: 0;
    }

    .hdr__menu {
      display: inline-flex;
    }
  }

  /* ── Menu (téléphone, tablette) ── */
  .menu {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0 var(--gutter) max(1.5rem, env(safe-area-inset-bottom));
    border: 0;
    background: var(--night);
    color: var(--cream);
    opacity: 1;
    transition: opacity var(--dur-normal) var(--ease-out);
  }

  .menu[open] {
    display: flex;
    flex-direction: column;
  }

  @starting-style {
    .menu[open] {
      opacity: 0;
    }
  }

  .menu::backdrop {
    background: var(--night);
  }

  .menu__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-h);
  }

  .menu__list {
    display: grid;
    margin: clamp(1.5rem, 6vh, 3rem) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hair);
  }

  .menu__link {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--hair);
  }

  .menu__txt {
    font-size: clamp(2rem, 9vw, 3.4rem);
    font-weight: 820;
    font-stretch: 125%;
    letter-spacing: -0.03em;
    line-height: 1;
    text-transform: uppercase;
  }

  .menu__foot {
    display: grid;
    gap: 1rem;
    justify-items: start;
    margin-top: auto;
    padding-top: 2rem;
  }

  .menu__mail {
    color: var(--fog);
    text-decoration: underline;
    text-decoration-color: var(--hair-strong);
    text-underline-offset: 0.3em;
  }
</style>
