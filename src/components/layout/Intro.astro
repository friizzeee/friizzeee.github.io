---
/**
 * Intro jouée une seule fois par visite (< 1,3 s) :
 * le timecode défile, puis l'image s'ouvre comme deux bandes cinéma.
 * Ignorée si l'utilisateur préfère réduire les animations.
 */
import Logo from '../ui/Logo.astro';
---

<div class="intro" aria-hidden="true" data-intro>
  <div class="intro__bar intro__bar--top" data-intro-bar></div>
  <div class="intro__bar intro__bar--bottom" data-intro-bar></div>
  <div class="intro__center" data-intro-center>
    <Logo class="intro__logo" />
    <span class="intro__tc mono" data-intro-tc>00:00:00:00</span>
    <span class="intro__line"><i data-intro-line></i></span>
  </div>
</div>

<style>
  .intro {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
    pointer-events: none;
  }

  :global(html.intro) .intro {
    display: block;
    pointer-events: auto;
    /* Filet de sécurité si le JS ne démarre pas */
    animation: intro-failsafe 0s linear 4s forwards;
  }

  .intro__bar {
    position: absolute;
    left: 0;
    right: 0;
    height: 50.5%;
    background: var(--color-ink-950);
  }

  .intro__bar--top {
    top: 0;
  }

  .intro__bar--bottom {
    bottom: 0;
  }

  .intro__center {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1rem;
  }

  .intro__center :global(.intro__logo) {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
  }

  .intro__tc {
    color: var(--color-fog-400);
    font-variant-numeric: tabular-nums;
  }

  .intro__line {
    display: block;
    width: 9rem;
    height: 1px;
    background: var(--line-strong);
    overflow: hidden;
  }

  .intro__line i {
    display: block;
    height: 100%;
    background: var(--color-rec);
    transform: scaleX(0);
    transform-origin: left;
  }

  @keyframes intro-failsafe {
    to {
      visibility: hidden;
      opacity: 0;
    }
  }
</style>
