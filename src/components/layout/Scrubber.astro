---
/**
 * Signature du site : la page se lit comme une vidéo.
 * Barre de lecture fixe (ordinateur) avec timecode, chapitres cliquables
 * et nom du chapitre en cours. Les chapitres sont créés en JS à partir
 * des sections portant l'attribut data-chapter.
 */
---

<nav class="scrubber" aria-label="Chapitres de la page" data-scrubber>
  <span class="scrubber__tc mono">
    <span class="rec-dot" aria-hidden="true"></span>
    <span data-scrubber-tc>00:00:00:00</span>
  </span>
  <ol class="scrubber__track" data-scrubber-track></ol>
  <span class="scrubber__chapter mono" aria-live="polite" data-scrubber-label></span>
</nav>

<style>
  .scrubber {
    position: fixed;
    left: 50%;
    bottom: 1.25rem;
    z-index: 70;
    display: none;
    align-items: center;
    gap: 1.1rem;
    width: min(46rem, calc(100% - 4rem));
    height: 3rem;
    padding-inline: 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    background: rgb(10 10 12 / 0.7);
    backdrop-filter: blur(16px) saturate(140%);
    -webkit-backdrop-filter: blur(16px) saturate(140%);
    box-shadow: 0 20px 50px -20px rgb(0 0 0 / 0.9);
    transform: translateX(-50%);
    transition:
      opacity 0.5s ease,
      transform 0.7s var(--ease-expo);
  }

  :global(html.intro) .scrubber,
  :global(html.scrubber-hidden) .scrubber {
    opacity: 0;
    transform: translate(-50%, 140%);
    pointer-events: none;
  }

  @media (min-width: 64rem) {
    :global(html.js) .scrubber {
      display: flex;
    }
  }

  .scrubber__tc {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    flex: none;
    min-width: 8.6rem;
    color: var(--color-fog-100);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
  }

  .scrubber__track {
    display: flex;
    flex: 1;
    gap: 3px;
    height: 100%;
    align-items: center;
  }

  .scrubber__track :global(li) {
    display: flex;
    align-items: center;
    height: 100%;
    min-width: 6px;
  }

  .scrubber__track :global(button) {
    position: relative;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }

  .scrubber__track :global(.seg) {
    position: absolute;
    inset: 50% 0 auto;
    height: 3px;
    border-radius: 2px;
    overflow: hidden;
    background: rgb(255 255 255 / 0.14);
    transform: translateY(-50%);
    transition: height 0.3s var(--ease-expo);
  }

  .scrubber__track :global(.seg i) {
    position: absolute;
    inset: 0;
    background: var(--color-rec);
    transform: scaleX(var(--p, 0));
    transform-origin: left;
  }

  .scrubber__track :global(button:hover .seg),
  .scrubber__track :global(button:focus-visible .seg) {
    height: 7px;
  }

  .scrubber__track :global(button .tip) {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 0.4rem);
    padding: 0.35rem 0.6rem;
    border-radius: 6px;
    background: var(--color-fog-100);
    color: var(--color-ink-950);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    white-space: nowrap;
    opacity: 0;
    transform: translate(-50%, 4px);
    transition:
      opacity 0.25s ease,
      transform 0.35s var(--ease-expo);
    pointer-events: none;
  }

  .scrubber__track :global(button:hover .tip),
  .scrubber__track :global(button:focus-visible .tip) {
    opacity: 1;
    transform: translate(-50%, 0);
  }

  .scrubber__chapter {
    flex: none;
    min-width: 8.5rem;
    text-align: right;
    color: var(--color-fog-300);
    font-size: 0.66rem;
  }
</style>
