---
/**
 * « Behind the Edit » : l'emplacement réservé à la vidéo des coulisses du montage.
 * Données : `behindTheEdit` dans src/data/portfolio.ts.
 *  - Sans vidéo : un emplacement « en préparation », rien d'autre (aucun faux contenu).
 *  - Avec une vidéo : une vraie carte de projet, et la page /portfolio/behind-the-edit
 *    (outils et étapes y apparaissent s'ils sont renseignés).
 */
import { behind } from '../../lib/portfolio';
import TrackLabel from '../ui/TrackLabel.astro';
import ProjectCard from './ProjectCard.astro';

interface Props {
  index?: string;
}

const { index = '03' } = Astro.props;
const lead = behind.ready ? behind.description || behind.teaser : behind.teaser;
---

<section id="coulisses" class="section bte" data-chapter="Coulisses">
  <div class="wrap">
    <header class="section-head">
      <TrackLabel track="REC" index={index} label="Coulisses" />
      <h2 class="h2" data-reveal="lines" set:html={behind.titleHtml} />
      {lead && <p class="lead" data-reveal="fade">{lead}</p>}
    </header>

    {
      behind.ready ? (
        <div class="bte__card" data-slot="lead">
          <ProjectCard project={behind} index={1} total={1} heading="h3" />
        </div>
      ) : (
        <div class="bte__slot" role="note" aria-label="Vidéo en préparation" data-reveal="clip">
          <span class="corners bte__corners" aria-hidden="true">
            <i />
            <i />
            <i />
            <i />
          </span>
          <span class="bte__tc mono" aria-hidden="true">
            --:--:--:--
          </span>
          <p class="bte__status mono">
            <span class="rec-dot" aria-hidden="true" />
            En préparation
          </p>
          <div class="bte__lanes" aria-hidden="true">
            {['V2', 'V1', 'A1'].map((id) => (
              <div class="bte__lane">
                <span class="mono">{id}</span>
                <i />
              </div>
            ))}
          </div>
          <p class="bte__soon mono">Bientôt en ligne</p>
        </div>
      )
    }
  </div>
</section>

<style>
  .bte {
    border-top: 1px solid var(--line);
  }

  /* Un écran éteint : le motif « média hors ligne », des pistes encore vides */
  .bte__slot {
    position: relative;
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 1.5rem;
    min-height: clamp(18rem, 36vw, 28rem);
    padding: clamp(3.5rem, 6vw, 4.5rem) clamp(1.25rem, 4vw, 3rem) clamp(2rem, 4vw, 3rem);
    border-radius: var(--radius-xl);
    border: 1px dashed rgb(255 77 90 / 0.3);
    background-color: rgb(229 22 42 / 0.035);
    background-image: repeating-linear-gradient(-45deg, rgb(255 77 90 / 0.05) 0 1px, transparent 1px 14px);
  }

  .bte__corners {
    inset: 1.1rem;
  }

  .bte__tc {
    position: absolute;
    top: 2.1rem;
    left: 2.4rem;
    color: var(--color-fog-400);
    font-size: 0.6rem;
  }

  .bte__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.45rem 0.85rem;
    border-radius: 999px;
    border: 1px solid rgb(255 77 90 / 0.45);
    background: var(--color-ink-950);
    color: var(--color-rec-bright);
    font-size: 0.66rem;
  }

  .bte__lanes {
    display: grid;
    gap: 6px;
    width: min(100%, 40rem);
  }

  .bte__lane {
    display: grid;
    grid-template-columns: 2.2rem 1fr;
    gap: 0.6rem;
    align-items: center;
    color: var(--color-fog-400);
  }

  .bte__lane .mono {
    font-size: 0.56rem;
  }

  .bte__lane i {
    height: 1.4rem;
    border-radius: 4px;
    border: 1px dashed rgb(255 255 255 / 0.14);
    background: rgb(6 6 7 / 0.6);
  }

  .bte__soon {
    color: var(--color-fog-400);
    font-size: 0.6rem;
  }
</style>
