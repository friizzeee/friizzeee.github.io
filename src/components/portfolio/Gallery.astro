---
/**
 * Galerie éditoriale : grandes lignes et paires en quinconce (règle : src/lib/portfolio/layout.ts),
 * avec, sur la page Portfolio, des filtres par catégorie.
 * Les filtres, leur animation et l'adresse (/portfolio?categorie=gaming) sont gérés par
 * src/scripts/modules/portfolio.ts : la grille se recompose avec la même règle qu'au build.
 */
import { pad, usedCategories, type Project } from '../../lib/portfolio';
import { arrange } from '../../lib/portfolio/layout';
import ProjectCard from './ProjectCard.astro';

interface Props {
  projects: Project[];
  /** Affiche les filtres (à partir de deux catégories représentées). */
  filters?: boolean;
  heading?: 'h2' | 'h3';
  label?: string;
}

const { projects, filters = false, heading = 'h3', label = 'Projets' } = Astro.props;
const placements = arrange(projects.map((p) => ({ vertical: p.format === '9:16' })));
const live = projects.filter((p) => p.ready);
const counts = usedCategories
  .map((c) => ({ ...c, count: live.filter((p) => p.categories.some((pc) => pc.id === c.id)).length }))
  .filter((c) => c.count > 0);
const showFilters = filters && counts.length >= 2;
---

<div class="gallery" data-gallery={showFilters ? '' : undefined}>
  {
    showFilters && (
      <div class="filters" role="group" aria-label="Filtrer les projets par catégorie" data-filters>
        <span class="filters__pill" aria-hidden="true" data-filter-pill />
        <button type="button" class="filter" data-filter="all" aria-pressed="true">
          <span data-filter-label>Tous les projets</span>
          <span class="filter__count mono">{pad(live.length)}</span>
        </button>
        {counts.map((c) => (
          <button type="button" class="filter" data-filter={c.id} aria-pressed="false">
            <span data-filter-label>{c.label}</span>
            <span class="filter__count mono">{pad(c.count)}</span>
          </button>
        ))}
      </div>
    )
  }
  {showFilters && <p class="sr-only" aria-live="polite" data-filter-status />}

  <ol class="works" aria-label={label} data-works>
    {
      projects.map((p, i) => {
        const place = placements[i];
        return (
          <li
            class="works__item"
            data-project-item
            data-cats={p.categories.map((c) => c.id).join(' ')}
            data-slot={place?.slot ?? 'lead'}
            data-offset={place?.offset ? '' : undefined}
            data-vertical={p.format === '9:16' ? '' : undefined}
          >
            <ProjectCard
              project={p}
              index={i + 1}
              total={projects.length}
              heading={heading}
              large={place?.slot.startsWith('lead') ?? true}
            />
          </li>
        );
      })
    }
  </ol>

  {
    showFilters && (
      <div class="works__empty" data-works-empty hidden>
        <p>Aucun projet dans cette catégorie pour l’instant.</p>
        <button type="button" class="works__reset" data-filter-reset>
          Voir tous les projets
        </button>
      </div>
    )
  }
</div>

<style>
  /* ── Filtres ────────────────────────────────── */
  .filters {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: clamp(2.75rem, 6vw, 4.5rem);
  }

  /* Pastille qui glisse sous le filtre actif */
  .filters__pill {
    position: absolute;
    top: 0;
    left: 0;
    width: 0;
    height: 0;
    border-radius: 999px;
    background: var(--color-fog-100);
    box-shadow: 0 12px 30px -14px rgb(237 237 240 / 0.45);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
  }

  .filter {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-height: 2.75rem;
    padding-inline: 1.15rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--color-fog-300);
    font-size: 0.92rem;
    letter-spacing: -0.01em;
    cursor: pointer;
    transition:
      color 0.45s var(--ease-expo),
      border-color 0.4s ease,
      background-color 0.45s var(--ease-expo);
  }

  .filter__count {
    color: var(--color-fog-400);
    font-size: 0.58rem;
    transition: color 0.4s ease;
  }

  .filter:hover {
    border-color: rgb(255 255 255 / 0.32);
    color: var(--color-fog-100);
  }

  .filter[aria-pressed='true'] {
    border-color: transparent;
    background: var(--color-fog-100);
    color: var(--color-ink-950);
  }

  .filters:global(.has-pill) .filter[aria-pressed='true'] {
    background: transparent;
  }

  .filter[aria-pressed='true'] .filter__count {
    color: var(--color-rec);
  }

  .filter:active {
    scale: 0.97;
  }

  /* ── Grille éditoriale ──────────────────────── */
  .works {
    display: grid;
    gap: clamp(4.5rem, 9vw, 8rem) clamp(1rem, 2vw, 1.75rem);
  }

  @media (min-width: 64rem) {
    .works {
      grid-template-columns: repeat(12, minmax(0, 1fr));
      align-items: start;
    }

    .works__item[data-slot^='lead'] {
      grid-column: 1 / -1;
    }

    .works__item[data-slot='wide'] {
      grid-column: span 7;
    }

    .works__item[data-slot='narrow'] {
      grid-column: span 5;
    }

    .works__item[data-slot='tall'] {
      grid-column: span 4;
    }

    .works__item[data-offset] {
      margin-top: clamp(4rem, 9vw, 9rem);
    }
  }

  /* ── Aucun résultat ─────────────────────────── */
  .works__empty {
    display: grid;
    justify-items: start;
    gap: 1rem;
    padding: clamp(1.75rem, 4vw, 2.75rem);
    border-radius: var(--radius-xl);
    border: 1px dashed var(--line-strong);
    color: var(--color-fog-300);
  }

  .works__reset {
    min-height: 2.75rem;
    padding-inline: 1.2rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--color-fog-100);
    cursor: pointer;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }

  .works__reset:hover {
    background: var(--color-fog-100);
    color: var(--color-ink-950);
  }
</style>
