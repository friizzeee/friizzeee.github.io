---
/**
 * « Méthode » : les cinq étapes d'un montage (textes : src/data/method.ts).
 * À côté des étapes, une timeline reste à l'écran et change d'état à chaque étape :
 *  1. les rushs bruts sont posés ;
 *  2. les meilleurs moments sont repérés dedans ;
 *  3. ils se resserrent en montage, l'habillage, les textes, le son et la musique arrivent ;
 *  4. la tête de lecture repasse tout, chaque piste est validée ;
 *  5. l'export se remplit : la vidéo est livrée.
 * Illustration (aria-hidden) : les étapes, à gauche, portent le contenu.
 * L'étape active est posée par src/scripts/modules/portfolio.ts (data-stage).
 */
import { method } from '../../data/method';
import TrackLabel from '../ui/TrackLabel.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  index?: string;
}

const { index = '02' } = Astro.props;
const pad = (n: number): string => String(n).padStart(2, '0');

/* Positions en % de la piste. `sx/sw` : le moment repéré dans les rushs ; `px/pw` : sa place une fois monté. */
const rushes = [
  { x: 0, w: 37, label: 'Rush 01' },
  { x: 38, w: 30, label: 'Rush 02' },
  { x: 69, w: 31, label: 'Rush 03' },
];
const segments = [
  { sx: 5, sw: 7, px: 0, pw: 7, label: 'Hook' },
  { sx: 17, sw: 9, px: 7.4, pw: 9, label: 'Story' },
  { sx: 41, sw: 11, px: 16.8, pw: 11, label: 'Acte II' },
  { sx: 56, sw: 6, px: 28.2, pw: 6, label: 'Gag' },
  { sx: 77, sw: 10, px: 34.6, pw: 10, label: 'Outro' },
];
/** Fin du montage, en % : il est plus court que les rushs. */
const end = 44.6;
const texts = [
  { x: 0.5, w: 5.5, label: 'Titre' },
  { x: 8.6, w: 9, label: 'Sous-titres' },
  { x: 23, w: 8.5, label: 'Sous-titres' },
  { x: 38, w: 6, label: 'Fin' },
];
const gfx = [
  { x: 3, w: 8, label: 'Zoom' },
  { x: 18, w: 6.5, label: 'Logo' },
  { x: 31, w: 7.5, label: 'Schéma' },
];
const sfx = [6.2, 15.8, 27.4, 36.8];
const ruler = ['00:00', '02:00', '04:00', '06:00', '08:00', '10:00'];
---

<section id="methode" class="section method" data-chapter="Méthode" data-method>
  <div class="wrap">
    <header class="section-head">
      <TrackLabel track="V1" index={index} label="Méthode" />
      <h2 class="h2" data-reveal="lines">{method.title[0]} <span class="serif">{method.title[1]}</span></h2>
      <p class="lead" data-reveal="fade">{method.lead}</p>
    </header>

    <div class="method__body">
      <div class="method__board-col">
        <div class="mboard" data-method-board data-stage="1" style={`--end:${end}`} aria-hidden="true">
          <div class="mboard__bar mono">
            <span class="mboard__src"><i class="mboard__led"></i>Séquence 01</span>
            <span class="mboard__status">
              {method.steps.map((s) => <span>{s.status}</span>)}
            </span>
          </div>

          <div class="mboard__ruler mono">
            <span></span>
            <span class="mboard__marks">{ruler.map((m) => <span>{m}</span>)}</span>
          </div>

          <div class="mboard__tracks">
            <div class="mtrack">
              <span class="mtrack__id mono">V3<i class="mtrack__ok"><Icon name="check" /></i></span>
              <span class="mtrack__lane">
                {
                  texts.map((c, i) => (
                    <span class="mc mc--txt" style={`--x:${c.x};--w:${c.w};--i:${i}`}>
                      <span class="mono">{c.label}</span>
                    </span>
                  ))
                }
              </span>
            </div>
            <div class="mtrack">
              <span class="mtrack__id mono">V2<i class="mtrack__ok"><Icon name="check" /></i></span>
              <span class="mtrack__lane">
                {
                  gfx.map((c, i) => (
                    <span class="mc mc--gfx" style={`--x:${c.x};--w:${c.w};--i:${i}`}>
                      <span class="mono">{c.label}</span>
                    </span>
                  ))
                }
              </span>
            </div>
            <div class="mtrack">
              <span class="mtrack__id mono">V1<i class="mtrack__ok"><Icon name="check" /></i></span>
              <span class="mtrack__lane">
                {
                  rushes.map((c) => (
                    <span class="mc mc--rush" style={`--x:${c.x};--w:${c.w}`}>
                      <span class="mono">{c.label}</span>
                    </span>
                  ))
                }
                {
                  segments.map((c, i) => (
                    <span class="mc mc--seg" style={`--sx:${c.sx};--sw:${c.sw};--px:${c.px};--pw:${c.pw};--i:${i}`}>
                      <span class="mono">{c.label}</span>
                    </span>
                  ))
                }
              </span>
            </div>
            <div class="mtrack">
              <span class="mtrack__id mono">A1<i class="mtrack__ok"><Icon name="check" /></i></span>
              <span class="mtrack__lane">
                {sfx.map((x, i) => <span class="mc mc--sfx" style={`--x:${x};--w:1.3;--i:${i}`} />)}
              </span>
            </div>
            <div class="mtrack">
              <span class="mtrack__id mono">A2<i class="mtrack__ok"><Icon name="check" /></i></span>
              <span class="mtrack__lane">
                <span class="mc mc--music" style={`--x:0;--w:${end};--i:0`}>
                  <span class="mono">Musique</span>
                </span>
              </span>
            </div>
            <span class="mboard__head"><i></i></span>
          </div>

          <div class="mboard__export">
            <span class="mono">Export</span>
            <span class="mboard__meter"><i></i></span>
            <span class="mboard__done mono"><Icon name="check" />Livré</span>
          </div>
        </div>
      </div>

      <ol class="method__steps">
        {
          method.steps.map((s, i) => (
            <li class:list={['mstep', i === 0 && 'is-active']} data-method-step>
              <span class="mstep__num mono">{pad(i + 1)}</span>
              <div class="mstep__text">
                <h3 class="mstep__title">{s.title}</h3>
                <p>{s.text}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .method {
    isolation: isolate;
    border-top: 1px solid var(--line);
  }

  /* ── Disposition : étapes à gauche, timeline qui reste à l'écran à droite ── */
  .method__body {
    display: flex;
    flex-direction: column;
  }

  .method__board-col {
    position: sticky;
    top: calc(var(--header-h) + 0.5rem);
    z-index: 2;
    padding-bottom: 1rem;
    background: var(--color-ink-950);
    /* Masque aussi la bande au-dessus quand l'en-tête se replie */
    box-shadow: 0 -6rem 0 0 var(--color-ink-950);
  }

  /* Les étapes passent sous la timeline en s'effaçant */
  .method__board-col::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 2.5rem;
    background: linear-gradient(var(--color-ink-950), transparent);
    pointer-events: none;
  }

  @media (min-width: 64rem) {
    .method__body {
      display: grid;
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: clamp(2.5rem, 5vw, 5rem);
      align-items: start;
    }

    .method__board-col {
      grid-column: 2;
      grid-row: 1;
      top: max(calc(var(--header-h) + 1.5rem), calc(50svh - 12rem));
      padding-bottom: 0;
      background: none;
      box-shadow: none;
    }

    .method__board-col::after {
      display: none;
    }

    .method__steps {
      grid-column: 1;
      grid-row: 1;
    }
  }

  /* ── Étapes ─────────────────────────────────── */
  .mstep {
    display: grid;
    grid-template-columns: 2.75rem minmax(0, 1fr);
    gap: 1rem;
    align-content: center;
    min-height: 44svh;
    padding-block: 2rem;
    border-top: 1px solid var(--line);
    opacity: 0.36;
    transition: opacity 0.6s ease;
  }

  .mstep:last-child {
    border-bottom: 1px solid var(--line);
  }

  @media (min-width: 64rem) {
    .mstep {
      min-height: 56svh;
    }
  }

  .mstep.is-active,
  :global(html:not(.js)) .mstep,
  :global(html.motion-failed) .mstep {
    opacity: 1;
  }

  .mstep__num {
    padding-top: 0.6rem;
    color: var(--color-fog-400);
    font-size: 0.72rem;
    font-variant-numeric: tabular-nums;
    transition: color 0.5s ease;
  }

  .mstep.is-active .mstep__num {
    color: var(--color-rec-bright);
  }

  .mstep__title {
    font-size: clamp(1.6rem, 2.6vw, 2.4rem);
    font-weight: 560;
    letter-spacing: -0.035em;
    line-height: 1.05;
    text-wrap: balance;
  }

  .mstep__text p {
    max-width: 42ch;
    margin-top: 0.9rem;
    color: var(--color-fog-300);
  }

  /* ── Timeline ───────────────────────────────── */
  .mboard {
    --gut: 2.6rem;
    position: relative;
    display: grid;
    gap: 0.8rem;
    padding: 0.9rem 1rem 1rem;
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-strong);
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.035), transparent 40%),
      var(--color-ink-900);
    box-shadow:
      inset 0 1px 0 rgb(255 255 255 / 0.06),
      0 40px 90px -40px rgb(0 0 0 / 0.95),
      0 60px 120px -60px rgb(229 22 42 / 0.35);
  }

  @media (min-width: 64rem) {
    .mboard {
      gap: 1.1rem;
      padding: 1.25rem 1.4rem 1.4rem;
      border-radius: var(--radius-xl);
    }
  }

  .mboard__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    color: var(--color-fog-400);
    font-size: 0.56rem;
  }

  .mboard__src {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-fog-300);
  }

  .mboard__led {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: var(--color-rec);
    box-shadow: 0 0 8px rgb(229 22 42 / 0.9);
  }

  /* Le statut change à chaque étape */
  .mboard__status {
    display: grid;
    justify-items: end;
  }

  .mboard__status span {
    grid-area: 1 / 1;
    color: var(--color-rec-bright);
    opacity: 0;
    translate: 0 0.4rem;
    transition:
      opacity 0.4s ease,
      translate 0.6s var(--ease-expo);
  }

  .mboard[data-stage='1'] .mboard__status span:nth-child(1),
  .mboard[data-stage='2'] .mboard__status span:nth-child(2),
  .mboard[data-stage='3'] .mboard__status span:nth-child(3),
  .mboard[data-stage='4'] .mboard__status span:nth-child(4),
  .mboard[data-stage='5'] .mboard__status span:nth-child(5) {
    opacity: 1;
    translate: 0 0;
  }

  .mboard__ruler,
  .mtrack {
    display: grid;
    grid-template-columns: var(--gut) minmax(0, 1fr);
    gap: 0.6rem;
    align-items: center;
  }

  .mboard__marks {
    display: flex;
    justify-content: space-between;
    color: var(--color-fog-400);
    font-size: 0.5rem;
  }

  .mboard__tracks {
    position: relative;
    display: grid;
    gap: 6px;
  }

  .mtrack__id {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-fog-400);
    font-size: 0.55rem;
  }

  .mtrack__ok {
    display: grid;
    place-items: center;
    width: 0.85rem;
    height: 0.85rem;
    border-radius: 50%;
    background: var(--color-rec);
    color: #fff;
    opacity: 0;
    scale: 0.4;
    transition:
      opacity 0.4s ease,
      scale 0.6s var(--ease-expo);
  }

  .mtrack__ok :global(svg) {
    width: 0.6rem;
    height: 0.6rem;
  }

  .mtrack:nth-child(2) .mtrack__ok {
    transition-delay: 0.15s;
  }
  .mtrack:nth-child(3) .mtrack__ok {
    transition-delay: 0.3s;
  }
  .mtrack:nth-child(4) .mtrack__ok {
    transition-delay: 0.45s;
  }
  .mtrack:nth-child(5) .mtrack__ok {
    transition-delay: 0.6s;
  }

  .mtrack__lane {
    position: relative;
    height: 1.35rem;
    border-radius: 4px;
    background: rgb(255 255 255 / 0.03);
    overflow: hidden;
  }

  @media (min-width: 64rem) {
    .mtrack__lane {
      height: 2rem;
    }
  }

  /* Un clip : position et longueur en % de la piste (--x, --w) */
  .mc {
    position: absolute;
    top: 0;
    bottom: 0;
    left: calc(var(--x) * 1%);
    width: calc(var(--w) * 1%);
    display: flex;
    align-items: center;
    padding-inline: 0.4rem;
    border-radius: 4px;
    overflow: hidden;
    white-space: nowrap;
    transition:
      left 0.9s var(--ease-expo),
      width 0.9s var(--ease-expo),
      opacity 0.6s ease,
      transform 0.8s var(--ease-expo),
      background-color 0.6s ease,
      box-shadow 0.6s ease,
      color 0.6s ease;
  }

  .mc .mono {
    font-size: 0.5rem;
    letter-spacing: 0.06em;
  }

  @media (max-width: 40rem) {
    .mc .mono {
      display: none;
    }
  }

  /* Rushs bruts : longs, rayés */
  .mc--rush {
    background: repeating-linear-gradient(-45deg, rgb(255 255 255 / 0.1) 0 2px, rgb(255 255 255 / 0.045) 2px 8px);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.12);
    color: var(--color-fog-400);
    transform-origin: center;
  }

  /* Moments repérés, puis montés */
  .mc--seg {
    --x: var(--sx);
    --w: var(--sw);
    opacity: 0;
    background: rgb(229 22 42 / 0.2);
    box-shadow: inset 0 0 0 1.5px var(--color-rec-bright);
    color: var(--color-rec-bright);
  }

  /* Habillage et textes : de petits clips rouges */
  .mc--gfx,
  .mc--txt {
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left center;
    color: var(--color-rec-bright);
  }

  .mc--gfx {
    background: rgb(229 22 42 / 0.12);
    box-shadow: inset 0 0 0 1px rgb(255 77 90 / 0.45);
  }

  .mc--txt {
    background: rgb(229 22 42 / 0.26);
    box-shadow: inset 0 0 0 1px rgb(255 77 90 / 0.3);
    color: #ffd2d6;
  }

  /* Effets sonores : de courtes impulsions */
  .mc--sfx {
    padding: 0;
    background: var(--color-fog-300);
    opacity: 0;
    transform: scaleY(0);
  }

  /* Musique : une forme d'onde */
  .mc--music {
    background:
      repeating-linear-gradient(90deg, rgb(255 255 255 / 0.2) 0 2px, transparent 2px 5px) center / 100% 55% no-repeat,
      rgb(255 255 255 / 0.05);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
    color: var(--color-fog-300);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left center;
  }

  /* Étape 2 : la sélection, repérée dans les rushs */
  .mboard[data-stage='2'] .mc--rush {
    opacity: 0.32;
  }

  .mboard[data-stage='2'] .mc--seg {
    opacity: 1;
  }

  /* Étapes 3 à 5 : le montage est posé, plus court que les rushs */
  .mboard:is([data-stage='3'], [data-stage='4'], [data-stage='5']) .mc--rush {
    opacity: 0;
    transform: scaleY(0.3);
  }

  .mboard:is([data-stage='3'], [data-stage='4'], [data-stage='5']) .mc--seg {
    --x: var(--px);
    --w: var(--pw);
    opacity: 1;
    background: linear-gradient(180deg, rgb(255 255 255 / 0.17), rgb(255 255 255 / 0.08));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.14);
    color: var(--color-fog-300);
    transition-delay: calc(var(--i) * 0.06s);
  }

  .mboard:is([data-stage='3'], [data-stage='4'], [data-stage='5']) :is(.mc--gfx, .mc--txt, .mc--music) {
    opacity: 1;
    transform: scaleX(1);
    transition-delay: calc(0.35s + var(--i) * 0.08s);
  }

  .mboard:is([data-stage='3'], [data-stage='4'], [data-stage='5']) .mc--sfx {
    opacity: 1;
    transform: scaleY(1);
    transition-delay: calc(0.5s + var(--i) * 0.07s);
  }

  /* Étapes 4 et 5 : chaque piste est validée */
  .mboard:is([data-stage='4'], [data-stage='5']) .mtrack__ok {
    opacity: 1;
    scale: 1;
  }

  /* ── Tête de lecture ── */
  .mboard__head {
    --ph: 0;
    position: absolute;
    top: -4px;
    bottom: -4px;
    left: calc(var(--gut) + 0.6rem + (100% - var(--gut) - 0.6rem) * var(--ph));
    width: 2px;
    margin-left: -1px;
    background: var(--color-rec);
    box-shadow: 0 0 12px rgb(229 22 42 / 0.85);
    pointer-events: none;
    transition: --ph 0.9s var(--ease-expo);
  }

  .mboard__head i {
    position: absolute;
    top: -2px;
    left: 50%;
    width: 10px;
    height: 10px;
    background: var(--color-rec);
    clip-path: polygon(0 0, 100% 0, 100% 60%, 50% 100%, 0 60%);
    translate: -50% 0;
  }

  /* 2 : la tête parcourt les rushs ; 3 et 5 : elle se pose en fin de montage ; 4 : elle repasse le montage */
  .mboard[data-stage='2'] .mboard__head {
    animation: mb-scan 3.6s ease-in-out infinite alternate;
  }

  .mboard:is([data-stage='3'], [data-stage='5']) .mboard__head {
    --ph: calc(var(--end) / 100);
  }

  .mboard[data-stage='4'] .mboard__head {
    animation: mb-check 2.6s linear infinite;
  }

  /* ── Export ── */
  .mboard__export {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.8rem;
    align-items: center;
    padding-top: 0.8rem;
    border-top: 1px solid var(--line);
    color: var(--color-fog-400);
    font-size: 0.55rem;
    opacity: 0.4;
    transition: opacity 0.5s ease;
  }

  .mboard__meter {
    position: relative;
    height: 4px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.08);
    overflow: hidden;
  }

  .mboard__meter i {
    position: absolute;
    inset: 0;
    background: var(--color-rec);
    box-shadow: 0 0 10px rgb(229 22 42 / 0.8);
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 1.6s var(--ease-quart);
  }

  .mboard__done {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--color-rec-bright);
    opacity: 0;
    transition: opacity 0.4s ease 1.2s;
  }

  .mboard__done :global(svg) {
    width: 0.8rem;
    height: 0.8rem;
  }

  .mboard[data-stage='5'] .mboard__export {
    opacity: 1;
  }

  .mboard[data-stage='5'] .mboard__meter i {
    transform: scaleX(1);
  }

  .mboard[data-stage='5'] .mboard__done {
    opacity: 1;
  }

  @property --ph {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  @keyframes mb-scan {
    from {
      --ph: 0;
    }
    to {
      --ph: 1;
    }
  }

  @keyframes mb-check {
    from {
      --ph: 0;
    }
    to {
      --ph: calc(var(--end) / 100);
    }
  }
</style>
