---
/**
 * Carte d'un projet (page Portfolio et sélection de l'accueil).
 *  - Image : la miniature, puis une boucle muette au survol (à l'écran sur mobile), chargée à ce moment-là.
 *  - Image ou titre : ouvre la page du projet ; l'image s'y transporte (transition entre pages, src/scripts/modules/cut.ts).
 *  - « Lire » : ouvre directement le lecteur ; les parties d'un même projet s'enchaînent.
 * La place de la carte (grande ligne, large, étroite) vient de l'attribut data-slot posé par la galerie.
 */
import { pad, posterOf, type Project } from '../../lib/portfolio';
import Poster from './Poster.astro';
import PlayTrigger from './PlayTrigger.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  project: Project;
  /** Numéro de la carte et nombre de cartes, affichés sur l'image (« 01 / 02 »). */
  index: number;
  total: number;
  heading?: 'h2' | 'h3';
  /** Grande carte : sert seulement à choisir la taille d'image téléchargée. */
  large?: boolean;
}

const { project: p, index, total, heading = 'h3', large = true } = Astro.props;
const Heading = heading;
const vertical = p.format === '9:16';
const poster = await posterOf(p);
const [first, ...others] = p.playable;
const parts = p.playable.length;
const shown = p.work.slice(0, 4);
const more = p.work.length - shown.length;
const sizes = vertical
  ? '(min-width: 64rem) 30vw, 92vw'
  : large
    ? '(min-width: 64rem) 62vw, 92vw'
    : '(min-width: 64rem) 52vw, 92vw';
const playText = parts > 1 ? `Lire · ${parts} parties` : (first?.playLabel ?? '');
const playAria = parts > 1 ? `Lire « ${p.title} », ${parts} parties` : `${playText} : « ${p.title} »`;
---

<article
  class:list={['pj', vertical && 'pj--vertical', !p.ready && 'pj--pending']}
  data-project
  data-preview-card={p.preview ? '' : undefined}
>
  {
    p.ready ? (
      <a
        href={p.href}
        class="pj__media card"
        tabindex="-1"
        aria-hidden="true"
        data-morph
        data-morph-media
        data-cut-label={p.title}
        data-follow-area
        data-tilt="2"
        data-reveal="clip"
        data-reveal-start="top 86%"
      >
        <span class="pj__frame" data-zoom="1.08">
          <Poster source={poster} alt="" sizes={sizes} class="pj__poster" />
          {p.preview && (
            <video class="pj__preview" muted loop playsinline preload="none" data-src={p.preview} aria-hidden="true" />
          )}
        </span>
        <span class="pj__shade" />
        <span class="corners pj__corners">
          <i />
          <i />
          <i />
          <i />
        </span>
        <span class="pj__tag pj__tag--index mono">
          <span class="rec-dot" />
          {pad(index)} / {pad(total)}
        </span>
        {p.duration && <span class="pj__tag pj__tag--len mono">{p.duration}</span>}
        <span class="pj__view" data-follow>
          <span>Voir le projet</span>
          <Icon name="arrow" />
        </span>
        {p.preview && (
          <span class="pj__progress">
            <i data-preview-progress />
          </span>
        )}
      </a>
    ) : (
      <div class="pj__media pj__media--pending hatch" role="note">
        <span class="corners pj__corners" aria-hidden="true">
          <i />
          <i />
          <i />
          <i />
        </span>
        <span class="pj__pending-title">Vidéo à ajouter</span>
        <span class="mono pj__pending-path">src/data/portfolio.ts → {p.slug}</span>
        <span class="pj__pending-note">Visible en développement uniquement.</span>
      </div>
    )
  }

  <div class="pj__info" data-reveal="stagger" data-reveal-start="top 86%">
    <p class="pj__meta mono">
      <span>{p.creator}</span>
      {
        p.categories[0] && (
          <>
            <span class="pj__sep" aria-hidden="true" />
            <span class="pj__cat">{p.categories[0].label}</span>
          </>
        )
      }
      <span class="pj__sep" aria-hidden="true"></span>
      <span>{p.editType}</span>
      {
        p.date && (
          <>
            <span class="pj__sep" aria-hidden="true" />
            <time datetime={p.date.iso}>{p.date.label}</time>
          </>
        )
      }
    </p>
    <Heading class="pj__title">
      {
        p.ready ? (
          <a href={p.href} class="pj__link" data-morph data-cut-label={p.title} set:html={p.titleHtml} />
        ) : (
          <span set:html={p.titleHtml} />
        )
      }
    </Heading>
    {p.description && <p class="pj__desc">{p.description}</p>}
    {
      shown.length > 0 && (
        <ul class="pj__tags" aria-label="Travail réalisé">
          {shown.map((w) => (
            <li class="chip">{w.label}</li>
          ))}
          {more > 0 && (
            <li class="chip pj__more">
              <span aria-hidden="true">+{more}</span>
              <span class="sr-only">et {more} autres</span>
            </li>
          )}
        </ul>
      )
    }
    <div class="pj__foot">
      {
        p.ready && (
          <span class="pj__go" aria-hidden="true">
            Voir le projet
            <Icon name="arrow" />
          </span>
        )
      }
      {
        first && (
          <PlayTrigger project={p} video={first} class="pj__play" aria-label={playAria}>
            <span class="pj__play-icon" aria-hidden="true">
              <Icon name="play" />
            </span>
            <span>{playText}</span>
          </PlayTrigger>
        )
      }
      {
        others.length > 0 && (
          <div hidden>
            {others.map((v) => (
              <PlayTrigger project={p} video={v} tabindex="-1" />
            ))}
          </div>
        )
      }
    </div>
  </div>
</article>

<style>
  .pj {
    position: relative;
    display: grid;
    gap: 1.6rem;
    align-content: start;
  }

  /* Grande ligne : l'image à gauche, la fiche à droite (en miroir pour « lead-alt ») */
  @media (min-width: 64rem) {
    :global([data-slot^='lead']) > .pj {
      grid-template-columns: minmax(0, 8fr) minmax(0, 4fr);
      align-items: end;
      column-gap: clamp(2rem, 4vw, 4.5rem);
    }

    :global([data-slot='lead-alt']) > .pj {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    }

    :global([data-slot='lead-alt']) > .pj .pj__media {
      order: 2;
    }
  }

  /* ── Image ──────────────────────────────────── */
  .pj__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: var(--radius-xl);
    background: var(--color-ink-800);
  }

  .pj--vertical .pj__media {
    aspect-ratio: 9 / 16;
  }

  .pj__frame {
    position: absolute;
    inset: 0;
    display: block;
    will-change: transform;
  }

  .pj__media :global(.pj__poster),
  .pj__preview {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      scale 1.4s var(--ease-expo),
      opacity 0.6s ease,
      filter 0.8s ease;
  }

  .pj__media :global(.pj__poster) {
    filter: saturate(0.9) contrast(1.04);
  }

  .pj__preview {
    opacity: 0;
  }

  .pj:global(.is-previewing) .pj__preview {
    opacity: 1;
  }

  .pj:hover .pj__media :global(.pj__poster),
  .pj:hover .pj__preview,
  .pj:focus-within .pj__media :global(.pj__poster) {
    scale: 1.045;
  }

  .pj:hover .pj__media :global(.pj__poster) {
    filter: saturate(1) contrast(1.04);
  }

  .pj__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgb(6 6 7 / 0.55), transparent 30%, transparent 64%, rgb(6 6 7 / 0.62));
    pointer-events: none;
    transition: opacity 0.6s ease;
  }

  .pj:global(.is-previewing) .pj__shade {
    opacity: 0.55;
  }

  .pj__corners {
    inset: 1rem;
  }

  .pj__corners :global(i) {
    border-color: rgb(255 255 255 / 0.55);
    transition: translate 0.7s var(--ease-expo);
  }

  .pj:hover .pj__corners :global(i:nth-child(1)) {
    translate: 6px 6px;
  }
  .pj:hover .pj__corners :global(i:nth-child(2)) {
    translate: -6px 6px;
  }
  .pj:hover .pj__corners :global(i:nth-child(3)) {
    translate: 6px -6px;
  }
  .pj:hover .pj__corners :global(i:nth-child(4)) {
    translate: -6px -6px;
  }

  .pj__tag {
    position: absolute;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.35rem 0.6rem;
    border-radius: 6px;
    background: rgb(0 0 0 / 0.7);
    color: #fff;
    font-size: 0.6rem;
    pointer-events: none;
  }

  /* Étiquettes en bas de l'image : le haut reste libre pour ce que la vidéo affiche déjà (pastille LIVE, pop-ups) */
  .pj__tag--index {
    left: 1.6rem;
    bottom: 1.6rem;
  }

  .pj__tag--len {
    right: 1.6rem;
    bottom: 1.6rem;
    font-variant-numeric: tabular-nums;
  }

  /* Pastille « Voir le projet » qui suit la souris au-dessus de l'image */
  .pj__view {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.75rem 1.15rem;
    border-radius: 999px;
    border: 1px solid rgb(255 255 255 / 0.22);
    background: rgb(10 10 12 / 0.62);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);
    color: #fff;
    font-size: 0.9rem;
    font-weight: 500;
    white-space: nowrap;
    opacity: 0;
    translate: -50% -50%;
    scale: 0.85;
    pointer-events: none;
    transition:
      opacity 0.4s ease,
      scale 0.6s var(--ease-expo);
  }

  .pj__view :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  @media (hover: hover) and (pointer: fine) {
    .pj:hover .pj__view {
      opacity: 1;
      scale: 1;
    }
  }

  .pj__progress {
    position: absolute;
    inset: auto 0 0;
    z-index: 1;
    height: 3px;
    background: rgb(255 255 255 / 0.12);
    opacity: 0;
    transition: opacity 0.4s ease;
    pointer-events: none;
  }

  .pj__progress i {
    position: absolute;
    inset: 0;
    background: var(--color-rec);
    box-shadow: 0 0 10px rgb(229 22 42 / 0.9);
    transform: scaleX(var(--vp, 0));
    transform-origin: left;
  }

  .pj:global(.is-previewing) .pj__progress {
    opacity: 1;
  }

  /* ── Fiche ──────────────────────────────────── */
  .pj__info {
    position: relative;
    display: grid;
    gap: 1rem;
    align-content: end;
  }

  .pj__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem 0.65rem;
    color: var(--color-fog-400);
    font-size: 0.62rem;
  }

  .pj__sep {
    width: 0.9rem;
    height: 1px;
    background: var(--line-strong);
  }

  .pj__cat {
    color: var(--color-rec-bright);
  }

  .pj__title {
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    font-weight: 560;
    letter-spacing: -0.04em;
    line-height: 1;
    text-wrap: balance;
  }

  :global([data-slot^='lead']) > .pj .pj__title {
    font-size: clamp(2.25rem, 4.4vw, 4.4rem);
    line-height: 0.96;
    letter-spacing: -0.045em;
  }

  .pj__title :global(.serif) {
    font-size: 1.07em;
    color: var(--color-fog-300);
  }

  .pj__link {
    background: linear-gradient(currentColor, currentColor) 0 100% / 0% 1px no-repeat;
    padding-bottom: 0.06em;
    transition: background-size 0.8s var(--ease-expo);
  }

  /* Toute la fiche ouvre la page du projet */
  .pj__link::after {
    content: '';
    position: absolute;
    inset: -0.5rem;
    z-index: 1;
  }

  .pj:hover .pj__link,
  .pj__link:focus-visible {
    background-size: 100% 1px;
  }

  .pj__link:focus-visible {
    outline: none;
  }

  .pj:has(.pj__link:focus-visible) .pj__media {
    outline: 2px solid var(--color-rec-bright);
    outline-offset: 4px;
  }

  .pj__desc {
    max-width: 46ch;
    color: var(--color-fog-300);
    font-size: 0.98rem;
  }

  .pj__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .pj__more {
    color: var(--color-fog-400);
  }

  .pj__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.25rem;
    margin-top: 0.4rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }

  .pj__go {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-fog-100);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .pj__go :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--color-rec-bright);
    transition: translate 0.6s var(--ease-expo);
  }

  .pj:hover .pj__go :global(svg) {
    translate: 0.3rem 0;
  }

  /* « Lire » : au-dessus du lien de la fiche */
  .pj__play {
    position: relative;
    z-index: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 2.75rem;
    padding: 0.3rem 1.1rem 0.3rem 0.3rem;
    border-radius: 999px;
    border: 1px solid var(--line-strong);
    color: var(--color-fog-100);
    font-size: 0.88rem;
    font-weight: 500;
    cursor: pointer;
    transition:
      background-color 0.4s var(--ease-expo),
      border-color 0.4s ease,
      color 0.4s ease;
  }

  .pj__play-icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--color-rec);
    color: #fff;
  }

  .pj__play-icon :global(svg) {
    width: 0.8rem;
    height: 0.8rem;
    margin-left: 2px;
  }

  .pj__play:hover,
  .pj__play:focus-visible {
    border-color: transparent;
    background: var(--color-fog-100);
    color: var(--color-ink-950);
  }

  .pj__play:active {
    scale: 0.97;
  }

  /* ── Projet à compléter (développement uniquement) ── */
  .pj__media--pending {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.6rem;
    padding: 2rem;
    border: 1px dashed rgb(255 216 77 / 0.45);
    text-align: center;
  }

  .pj__pending-title {
    color: #ffd84d;
    font-size: 1.2rem;
    font-weight: 560;
  }

  .pj__pending-path,
  .pj__pending-note {
    color: var(--color-fog-400);
    font-size: 0.85rem;
  }

  .pj__pending-path {
    font-size: 0.6rem;
  }
</style>
