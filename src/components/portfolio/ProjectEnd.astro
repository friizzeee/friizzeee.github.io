---
/**
 * Fin d'une page projet : l'appel au contact (Discord, offres) puis le projet suivant.
 * Avec deux projets, « précédent » et « suivant » désignent le même : un seul lien s'affiche.
 */
import { posterOf, type Project } from '../../lib/portfolio';
import DiscordCta from '../ui/DiscordCta.astro';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import Poster from './Poster.astro';

interface Props {
  prev: Project | null;
  next: Project | null;
}

const { prev, next } = Astro.props;

const links = [
  prev && prev.slug !== next?.slug ? { dir: 'prev' as const, label: 'Projet précédent', project: prev } : null,
  next ? { dir: 'next' as const, label: 'Projet suivant', project: next } : null,
].filter((link) => link !== null);

const thumbs = await Promise.all(links.map(async (link) => ({ ...link, poster: await posterOf(link.project) })));
---

<section id="contact-projet" class="section pend" data-chapter="Contact">
  <div class="pend__glow" aria-hidden="true"></div>
  <div class="wrap">
    <div class="pend__cta">
      <div class="pend__text">
        <h2 class="pend__title" data-reveal="lines">
          Votre prochaine vidéo, <span class="serif">montée avec le même soin.</span>
        </h2>
        <p class="lead" data-reveal="fade">
          Expliquez-moi votre projet sur Discord : on en parle, je vous confirme le délai et le tarif, puis on
          démarre. Vous payez une fois la vidéo livrée.
        </p>
        <div class="pend__links" data-reveal="fade">
          <Button href="/#offres" data-cut-label="Offres">Voir les offres</Button>
          <Button href="/portfolio" data-cut-label="Portfolio">Tout le portfolio</Button>
        </div>
      </div>
      <div class="pend__discord" data-reveal="fade" data-scrubber-avoid>
        <DiscordCta label="Me parler de votre projet" />
      </div>
    </div>

    {
      thumbs.length > 0 && (
        <nav class="pnav" aria-label="Autres projets">
          {thumbs.map((t) => (
            <a
              href={t.project.href}
              class:list={['pnav__link', `pnav__link--${t.dir}`]}
              data-cut-label={t.project.title}
            >
              <span class="pnav__thumb">
                <Poster source={t.poster} alt="" sizes="(min-width: 64rem) 16rem, 36vw" widths={[320, 480, 640]} />
              </span>
              <span class="pnav__text">
                <span class="mono pnav__dir">{t.label}</span>
                <span class="pnav__title" set:html={t.project.titleHtml} />
                <span class="mono pnav__meta">
                  {t.project.creator} · {t.project.categories[0]?.label}
                </span>
              </span>
              <span class="pnav__arrow" aria-hidden="true">
                <Icon name="arrow" />
              </span>
            </a>
          ))}
        </nav>
      )
    }
  </div>
</section>

<style>
  .pend {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    border-top: 1px solid var(--line);
  }

  .pend__glow {
    position: absolute;
    left: 70%;
    top: 30%;
    z-index: -1;
    width: min(56rem, 120vw);
    aspect-ratio: 1.5;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(229 22 42 / 0.22), transparent);
    filter: blur(30px);
    translate: -50% -50%;
    pointer-events: none;
  }

  .pend__cta {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
  }

  @media (min-width: 64rem) {
    .pend__cta {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      align-items: end;
      column-gap: 4rem;
    }
  }

  .pend__text {
    display: grid;
    gap: 1.75rem;
  }

  .pend__title {
    max-width: 17ch;
    font-size: clamp(2.4rem, 5.4vw, 5rem);
    font-weight: 560;
    letter-spacing: -0.045em;
    line-height: 0.96;
  }

  .pend__title .serif {
    font-size: 1.07em;
    color: var(--color-fog-300);
  }

  .pend__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* ── Projet suivant ── */
  .pnav {
    display: grid;
    gap: 1rem;
    margin-top: clamp(4rem, 8vw, 6.5rem);
  }

  @media (min-width: 64rem) {
    .pnav:has(.pnav__link--prev) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .pnav__link {
    position: relative;
    display: grid;
    grid-template-columns: clamp(6.5rem, 22vw, 14rem) minmax(0, 1fr) auto;
    gap: clamp(1rem, 2.5vw, 2rem);
    align-items: center;
    padding: 0.75rem clamp(0.75rem, 2vw, 1.5rem) 0.75rem 0.75rem;
    border-radius: var(--radius-xl);
    border: 1px solid var(--line);
    background: var(--color-ink-900);
    transition:
      border-color 0.5s ease,
      background-color 0.5s ease;
  }

  .pnav__link:hover,
  .pnav__link:focus-visible {
    border-color: var(--line-strong);
    background: var(--color-ink-850);
  }

  .pnav__thumb {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--color-ink-800);
  }

  .pnav__thumb :global(img),
  .pnav__thumb :global(.poster-none) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 1.2s var(--ease-expo);
  }

  .pnav__link:hover .pnav__thumb :global(img) {
    scale: 1.06;
  }

  .pnav__text {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }

  .pnav__dir,
  .pnav__meta {
    color: var(--color-fog-400);
    font-size: 0.6rem;
  }

  .pnav__dir {
    color: var(--color-rec-bright);
  }

  .pnav__title {
    font-size: clamp(1.3rem, 2.6vw, 2.4rem);
    font-weight: 560;
    letter-spacing: -0.04em;
    line-height: 1;
    text-wrap: balance;
  }

  .pnav__title :global(.serif) {
    color: var(--color-fog-300);
  }

  .pnav__arrow {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    transition:
      background-color 0.4s var(--ease-expo),
      border-color 0.4s ease,
      color 0.4s ease,
      translate 0.6s var(--ease-expo);
  }

  .pnav__arrow :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .pnav__link--prev .pnav__arrow :global(svg) {
    rotate: 180deg;
  }

  .pnav__link:hover .pnav__arrow,
  .pnav__link:focus-visible .pnav__arrow {
    border-color: transparent;
    background: var(--color-rec);
    color: #fff;
    translate: 0.25rem 0;
  }

  .pnav__link--prev:hover .pnav__arrow {
    translate: -0.25rem 0;
  }

  @media (max-width: 30rem) {
    .pnav__arrow {
      display: none;
    }

    .pnav__link {
      grid-template-columns: 6.5rem minmax(0, 1fr);
    }
  }
</style>
