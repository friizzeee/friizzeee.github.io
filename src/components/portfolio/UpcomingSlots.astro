---
/**
 * Emplacements « Prochains montages » : visibles tant que la galerie compte moins de 6 projets.
 * Liste : `upcomingSlots` dans src/data/portfolio.ts (videz-la pour tout masquer).
 */
import { upcomingSlots } from '../../data/portfolio';
import Icon from '../ui/Icon.astro';

interface Props {
  /** Nombre de projets en ligne. */
  count: number;
}

const { count } = Astro.props;
const show = upcomingSlots.length > 0 && count < 6;
---

{
  show && (
    <div class="upcoming">
      <div class="upcoming__head" data-reveal="fade">
        <p class="mono">Prochains montages</p>
        <p class="upcoming__note">La galerie s’enrichit au fil des projets.</p>
      </div>
      <ul class="upcoming__grid" data-reveal="cards">
        {upcomingSlots.map((slot) => (
          <li class:list={['slot hatch', slot.format === '9:16' ? 'slot--vertical' : 'slot--wide']}>
            <div class="corners">
              <i />
              <i />
              <i />
              <i />
            </div>
            <span class="mono slot__tc">--:--:--:--</span>
            <span class="slot__plus" aria-hidden="true">
              <Icon name="plus" />
            </span>
            <span class="slot__label">{slot.label}</span>
            <span class="mono slot__soon">Bientôt en ligne</span>
          </li>
        ))}
      </ul>
    </div>
  )
}

<style>
  .upcoming {
    margin-top: clamp(5rem, 10vw, 8rem);
  }

  .upcoming__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-bottom: 1.25rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
    color: var(--color-fog-400);
  }

  .upcoming__note {
    color: var(--color-fog-400);
    font-size: 0.92rem;
  }

  .upcoming__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    perspective: 1400px;
  }

  @media (min-width: 64rem) {
    .upcoming__grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .slot {
    position: relative;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.75rem;
    min-height: 15rem;
    padding: 1.5rem;
    border-radius: var(--radius-lg);
    border: 1px dashed rgb(255 255 255 / 0.12);
    text-align: center;
  }

  .slot--wide {
    grid-column: 1 / -1;
  }

  @media (min-width: 64rem) {
    .slot {
      min-height: 19rem;
    }

    .slot--wide {
      grid-column: auto;
    }
  }

  .slot .corners {
    inset: 0.9rem;
  }

  .slot__tc {
    position: absolute;
    top: 1.3rem;
    left: 1.4rem;
    color: var(--color-fog-400);
    font-size: 0.6rem;
  }

  .slot__plus {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    border: 1px solid var(--line-strong);
    color: var(--color-fog-400);
  }

  .slot__plus :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  .slot__label {
    color: var(--color-fog-300);
    font-weight: 500;
  }

  .slot__soon {
    color: var(--color-fog-400);
    font-size: 0.6rem;
  }
</style>
