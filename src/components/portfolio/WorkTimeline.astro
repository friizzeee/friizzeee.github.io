---
/**
 * Page projet, « Mon travail » : ce qui a été fait sur la vidéo, rangé par piste comme dans
 * un logiciel de montage (V3 textes, V2 habillage, V1 montage, A1 son, A2 musique).
 * Seules les lignes renseignées dans le champ `work` du projet apparaissent (src/data/portfolio.ts).
 * Au défilement, une tête de lecture traverse les pistes et allume chaque travail à son passage
 * (src/scripts/modules/portfolio.ts).
 */
import type { Project, TrackId } from '../../lib/portfolio';
import TrackLabel from '../ui/TrackLabel.astro';

interface Props {
  project: Project;
  track: string;
  index: string;
}

const { project: p, track, index } = Astro.props;
const kind: Record<TrackId, 'text' | 'gfx' | 'video' | 'audio'> = {
  V3: 'text',
  V2: 'gfx',
  V1: 'video',
  A1: 'audio',
  A2: 'audio',
};
---

<section id="travail" class="section wt-sec" data-chapter="Mon travail">
  <div class="wrap">
    <header class="ps-head">
      <TrackLabel track={track} index={index} label="Mon travail" />
      <h2 class="ps-title" data-reveal="lines">Mon <span class="serif">travail.</span></h2>
      <p class="lead" data-reveal="fade">
        Ce que j’ai fait sur cette vidéo, rangé par piste comme dans un logiciel de montage : de l’image au son.
      </p>
    </header>

    <div class="wt" data-work-timeline>
      <ol class="wt__tracks">
        {
          p.tracks.map((t) => (
            <li class:list={['wt__track', `wt__track--${kind[t.id]}`]}>
              <div class="wt__head">
                <span class="wt__id mono">{t.id}</span>
                <span class="wt__name">{t.name}</span>
              </div>
              <ul class="wt__lane" aria-label={`Piste ${t.id} : ${t.name}`}>
                {t.items.map((w) => (
                  <li class="wt__clip" data-wt-clip>
                    <h3 class="wt__label">{w.label}</h3>
                    {w.detail && <p class="wt__detail">{w.detail}</p>}
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
      <span class="wt__playhead" aria-hidden="true"><i></i></span>
    </div>
  </div>
</section>

<style>
  .wt-sec {
    border-top: 1px solid var(--line);
  }

  .wt {
    --head: 0rem;
    position: relative;
  }

  .wt__tracks {
    display: grid;
    gap: 0.6rem;
  }

  .wt__track {
    display: grid;
    gap: 0.6rem;
  }

  @media (min-width: 48rem) {
    .wt {
      --head: 10.5rem;
    }

    .wt__track {
      grid-template-columns: var(--head) minmax(0, 1fr);
      gap: 0.75rem;
    }
  }

  /* En-tête de piste, comme dans la colonne de gauche d'une timeline */
  .wt__head {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 1rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
    background: var(--color-ink-900);
  }

  @media (min-width: 48rem) {
    .wt__head {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.6rem;
    }
  }

  .wt__id {
    display: inline-grid;
    place-items: center;
    min-width: 2.2rem;
    height: 1.55rem;
    padding-inline: 0.45rem;
    border-radius: 4px;
    border: 1px solid rgb(255 77 90 / 0.45);
    background: rgb(229 22 42 / 0.1);
    color: var(--color-rec-bright);
    font-size: 0.66rem;
  }

  .wt__name {
    color: var(--color-fog-100);
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  .wt__lane {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding: 0.5rem;
    border-radius: var(--radius-md);
    border: 1px solid var(--line);
    background: rgb(255 255 255 / 0.018);
  }

  /* Un travail = un clip posé sur la piste ; il s'allume quand la tête de lecture l'atteint */
  .wt__clip {
    position: relative;
    display: grid;
    flex: 1 1 15rem;
    align-content: start;
    gap: 0.45rem;
    min-height: 6.5rem;
    padding: 1.05rem 1.1rem 1.15rem;
    border-radius: 0.7rem;
    overflow: hidden;
    opacity: 0.4;
    transition:
      opacity 0.6s ease,
      background-color 0.6s ease,
      box-shadow 0.6s ease;
  }

  /* Bande de couleur en haut du clip, comme dans un logiciel de montage */
  .wt__clip::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 2px;
    background: var(--clip-band, var(--color-fog-300));
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.9s var(--ease-expo);
  }

  .wt__clip:global(.is-lit),
  :global(html:not(.js)) .wt__clip,
  :global(html.motion-failed) .wt__clip {
    opacity: 1;
  }

  .wt__clip:global(.is-lit)::before {
    transform: scaleX(1);
  }

  .wt__track--video .wt__clip {
    background: linear-gradient(180deg, rgb(255 255 255 / 0.085), rgb(255 255 255 / 0.03));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.1);
  }

  .wt__track--gfx .wt__clip {
    --clip-band: var(--color-rec);
    background: rgb(229 22 42 / 0.09);
    box-shadow: inset 0 0 0 1px rgb(255 77 90 / 0.28);
  }

  .wt__track--text .wt__clip {
    --clip-band: var(--color-rec-bright);
    background: rgb(229 22 42 / 0.05);
    box-shadow: inset 0 0 0 1px rgb(255 77 90 / 0.4);
  }

  /* Pistes son : une forme d'onde court au pied du clip */
  .wt__track--audio .wt__clip {
    --clip-band: var(--color-fog-100);
    padding-bottom: 2.1rem;
    background: rgb(255 255 255 / 0.03);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.08);
  }

  .wt__track--audio .wt__clip::after {
    content: '';
    position: absolute;
    left: 1.1rem;
    right: 1.1rem;
    bottom: 0.8rem;
    height: 0.75rem;
    background: repeating-linear-gradient(90deg, rgb(255 255 255 / 0.22) 0 2px, transparent 2px 5px);
    -webkit-mask-image: linear-gradient(90deg, #000 0 20%, rgb(0 0 0 / 0.45) 35%, #000 55%, rgb(0 0 0 / 0.5) 75%, #000);
    mask-image: linear-gradient(90deg, #000 0 20%, rgb(0 0 0 / 0.45) 35%, #000 55%, rgb(0 0 0 / 0.5) 75%, #000);
  }

  .wt__track--video .wt__clip:global(.is-lit) {
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.2);
  }

  .wt__track--gfx .wt__clip:global(.is-lit),
  .wt__track--text .wt__clip:global(.is-lit) {
    box-shadow: inset 0 0 0 1px rgb(255 77 90 / 0.55);
  }

  .wt__label {
    font-size: 1.02rem;
    font-weight: 560;
    letter-spacing: -0.015em;
    line-height: 1.2;
  }

  .wt__detail {
    color: var(--color-fog-300);
    font-size: 0.9rem;
    line-height: 1.5;
  }

  /* ── Tête de lecture (grand écran) ── */
  .wt__playhead {
    display: none;
  }

  @media (min-width: 48rem) {
    .wt__playhead {
      position: absolute;
      top: -0.75rem;
      bottom: -0.75rem;
      left: calc(var(--head) + 0.75rem + (100% - var(--head) - 0.75rem) * var(--wt-p, 0));
      display: block;
      width: 2px;
      margin-left: -1px;
      background: var(--color-rec);
      box-shadow: 0 0 14px rgb(229 22 42 / 0.85);
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.4s ease;
    }

    .wt:global(.is-scrubbing) .wt__playhead {
      opacity: 1;
    }

    .wt__playhead i {
      position: absolute;
      top: -2px;
      left: 50%;
      width: 11px;
      height: 11px;
      background: var(--color-rec);
      clip-path: polygon(0 0, 100% 0, 100% 60%, 50% 100%, 0 60%);
      translate: -50% 0;
    }
  }
</style>
