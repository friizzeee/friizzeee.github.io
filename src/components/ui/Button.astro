---
/**
 * Bouton-lien avec texte qui « roule » au survol, icône qui pivote,
 * remplissage qui monte et attraction magnétique (souris uniquement).
 */
import type { HTMLAttributes } from 'astro/types';
import Icon, { type IconName } from './Icon.astro';

interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  href: string;
  variant?: 'primary' | 'ghost';
  size?: 'md' | 'lg';
  icon?: IconName;
  /** L'icône pivote à 45° au survol (flèche → flèche diagonale). */
  rotateIcon?: boolean;
  external?: boolean;
  magnetic?: boolean;
}

const {
  href,
  variant = 'ghost',
  size = 'md',
  icon = 'arrow',
  rotateIcon = true,
  external = false,
  magnetic = true,
  class: className,
  ...rest
} = Astro.props;

const label = await Astro.slots.render('default');
---

<a
  href={href}
  class:list={['btn', variant === 'primary' && 'btn--primary', size === 'lg' && 'btn--lg', className]}
  data-magnetic={magnetic ? '' : undefined}
  data-no-rotate={rotateIcon ? undefined : ''}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  {...rest}
>
  <span class="btn__label">
    <span set:html={label} />
    <span aria-hidden="true" set:html={label} />
  </span>
  <span class="btn__icon" aria-hidden="true"><Icon name={icon} /></span>
</a>
