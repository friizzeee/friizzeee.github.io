---
/**
 * Grand bouton Discord de la page Contact (variante « tuile » de DiscordButton).
 * Même lien que tous les boutons Discord du site : src/config/site.ts (discord.url).
 *
 * Survol : le blanc se répand depuis le point d'entrée de la souris, le logo s'anime,
 * la flèche pivote. Les ondes autour du logo signalent un canal « en direct ».
 */
import Icon from './Icon.astro';
import { discordHref, isDiscordConfigured } from '../../config/site';

interface Props {
  label?: string;
  class?: string;
}

const { label = 'Me contacter sur Discord', class: className } = Astro.props;
const sub = isDiscordConfigured ? 'Discord · message privé · nouvel onglet' : 'Discord · lien à configurer';
---

<span class:list={['dcta-wrap', className]}>
  <a
    href={discordHref}
    class="dcta"
    target={isDiscordConfigured ? '_blank' : undefined}
    rel={isDiscordConfigured ? 'noopener noreferrer' : undefined}
    data-discord-link
    data-fill-origin
    data-magnetic="0.12"
  >
    <span class="dcta__icon" aria-hidden="true">
      <span class="dcta__waves"><i></i><i></i></span>
      <Icon name="discord" />
    </span>
    <span class="dcta__text">
      <span class="dcta__label">{label}</span>
      <span class="dcta__sub mono">{sub}</span>
    </span>
    <span class="dcta__arrow" aria-hidden="true"><Icon name="arrow" /></span>
  </a>
  <span class="dcta__ring" aria-hidden="true"></span>
  <ul class="dcta__facts" aria-label="Comment ça se passe">
    <li><Icon name="check" />Message privé</li>
    <li><Icon name="check" />Délai et tarif confirmés avant de démarrer</li>
    <li><Icon name="check" />Paiement après livraison</li>
  </ul>
  {
    import.meta.env.DEV && !isDiscordConfigured && (
      <span class="dcta__warn mono" role="note">
        ⚠ Lien Discord à renseigner dans src/config/site.ts
      </span>
    )
  }
</span>

<style>
  .dcta-wrap {
    display: grid;
    gap: 0.9rem;
  }

  .dcta,
  .dcta__ring {
    grid-area: 1 / 1;
  }

  /* Lumière blanche qui fait lentement le tour de la tuile : c'est l'action principale de la page */
  .dcta__ring {
    position: relative;
    z-index: 1;
    margin: -1px;
    border-radius: calc(var(--radius-lg) + 1px);
    padding: 1.5px;
    background: conic-gradient(
      from var(--dcta-angle),
      transparent 0deg 250deg,
      rgb(255 255 255 / 0.95) 320deg,
      transparent 360deg
    );
    -webkit-mask:
      linear-gradient(#000 0 0) content-box,
      linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    animation: dcta-orbit 6s linear infinite;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  /* Au survol, la tuile a sa propre animation : l'anneau s'efface */
  .dcta:hover + .dcta__ring,
  .dcta:focus-visible + .dcta__ring {
    opacity: 0;
  }

  .dcta__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1.4rem;
    color: var(--color-fog-300);
    font-size: 0.86rem;
  }

  .dcta__facts li {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .dcta__facts :global(svg) {
    flex: none;
    width: 0.95rem;
    height: 0.95rem;
    color: var(--color-rec-bright);
  }

  @property --dcta-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  @keyframes dcta-orbit {
    to {
      --dcta-angle: 360deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dcta__ring {
      display: none;
    }
  }

  .dcta {
    --fg: #fff;
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    gap: 1.1rem;
    min-height: 5.25rem;
    padding: 0.85rem 0.85rem 0.85rem 0.95rem;
    border-radius: var(--radius-lg);
    background: var(--color-rec);
    color: var(--fg);
    overflow: hidden;
    box-shadow:
      0 24px 60px -24px rgb(229 22 42 / 0.85),
      inset 0 1px 0 rgb(255 255 255 / 0.25),
      inset 0 -1px 0 rgb(0 0 0 / 0.2);
    transition:
      color 0.5s var(--ease-expo),
      box-shadow 0.6s var(--ease-expo),
      scale 0.3s var(--ease-expo);
  }

  /* Remplissage blanc depuis le point d'entrée de la souris (--bx / --by en JS) */
  .dcta::before {
    content: '';
    position: absolute;
    left: var(--bx, 50%);
    top: var(--by, 100%);
    z-index: -1;
    width: max(240%, 30rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-fog-100);
    transform: translate(-50%, -50%) scale(0);
    transition: transform 0.8s var(--ease-expo);
    pointer-events: none;
  }

  /* Reflet qui traverse la tuile */
  .dcta::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 2;
    background: linear-gradient(105deg, transparent 38%, rgb(255 255 255 / 0.3) 50%, transparent 62%);
    translate: -110% 0;
    pointer-events: none;
  }

  .dcta:hover,
  .dcta:focus-visible {
    --fg: var(--color-ink-950);
    box-shadow:
      0 28px 70px -24px rgb(229 22 42 / 0.7),
      0 0 0 1px rgb(255 255 255 / 0.6);
  }

  .dcta:hover::before,
  .dcta:focus-visible::before {
    transform: translate(-50%, -50%) scale(1);
  }

  .dcta:hover::after {
    translate: 110% 0;
    transition: translate 1.1s var(--ease-expo);
  }

  .dcta:active {
    scale: 0.98;
  }

  /* ── Logo + ondes ───────────────────────────── */
  .dcta__icon {
    position: relative;
    display: grid;
    place-items: center;
    flex: none;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.22);
    color: #fff;
    transition: background-color 0.5s var(--ease-expo);
  }

  .dcta__icon :global(svg) {
    position: relative;
    width: 1.55rem;
    height: 1.55rem;
  }

  .dcta:hover .dcta__icon,
  .dcta:focus-visible .dcta__icon {
    background: var(--color-rec);
  }

  .dcta:hover .dcta__icon :global(svg) {
    animation: dcta-wave 0.9s var(--ease-expo);
  }

  .dcta__waves i {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.55);
    opacity: 0;
    animation: dcta-ring 2.8s ease-out infinite;
  }

  .dcta__waves i:nth-child(2) {
    animation-delay: 1.4s;
  }

  .dcta:hover .dcta__waves i {
    border-color: rgb(229 22 42 / 0.6);
  }

  /* ── Texte ──────────────────────────────────── */
  .dcta__text {
    display: grid;
    flex: 1;
    gap: 0.3rem;
    min-width: 0;
  }

  .dcta__label {
    font-size: clamp(1.05rem, 1.6vw, 1.2rem);
    font-weight: 560;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .dcta__sub {
    font-size: 0.58rem;
    opacity: 0.78;
  }

  /* ── Flèche ─────────────────────────────────── */
  .dcta__arrow {
    display: grid;
    place-items: center;
    flex: none;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    border: 1px solid rgb(255 255 255 / 0.35);
    transition:
      transform 0.6s var(--ease-expo),
      border-color 0.5s ease,
      background-color 0.5s ease;
  }

  .dcta__arrow :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }

  .dcta:hover .dcta__arrow,
  .dcta:focus-visible .dcta__arrow {
    border-color: transparent;
    background: var(--color-ink-950);
    color: #fff;
    transform: rotate(-45deg);
  }

  .dcta__warn {
    justify-self: start;
    padding: 0.3rem 0.6rem;
    border-radius: 6px;
    background: #ffd84d;
    color: #111;
    font-size: 0.62rem;
  }

  @media (max-width: 26rem) {
    .dcta {
      gap: 0.8rem;
    }

    .dcta__icon {
      width: 3rem;
      height: 3rem;
    }

    .dcta__arrow {
      display: none;
    }

    .dcta__sub {
      letter-spacing: 0.06em;
    }
  }

  @keyframes dcta-ring {
    0% {
      opacity: 0.8;
      transform: scale(1);
    }
    100% {
      opacity: 0;
      transform: scale(1.75);
    }
  }

  @keyframes dcta-wave {
    0% {
      transform: rotate(0);
    }
    25% {
      transform: rotate(-14deg) scale(1.1);
    }
    55% {
      transform: rotate(10deg) scale(1.1);
    }
    100% {
      transform: rotate(0);
    }
  }
</style>
