---
/**
 * Petites icônes SVG en ligne (aucune requête réseau).
 */
export type IconName =
  | 'arrow'
  | 'arrow-down'
  | 'discord'
  | 'play'
  | 'copy'
  | 'check'
  | 'close'
  | 'plus'
  | 'shield'
  | 'chat'
  | 'brief'
  | 'scissors'
  | 'send'
  | 'wallet'
  /* Commandes du lecteur vidéo */
  | 'pause'
  | 'volume'
  | 'mute'
  | 'expand'
  | 'compress'
  | 'replay'
  | 'next';

interface Props {
  name: IconName;
  class?: string;
  size?: number;
}

const { name, class: className, size } = Astro.props;
const dims = size ? { width: size, height: size } : {};
---

{
  name === 'discord' ? (
    <svg class={className} {...dims} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
      <path d="M20.32 4.37a19.8 19.8 0 0 0-4.89-1.52.07.07 0 0 0-.08.04c-.21.38-.44.87-.61 1.25a18.27 18.27 0 0 0-5.49 0 12.64 12.64 0 0 0-.62-1.25.08.08 0 0 0-.08-.04 19.74 19.74 0 0 0-4.88 1.52.07.07 0 0 0-.03.03C.53 9.05-.32 13.58.1 18.06a.08.08 0 0 0 .03.06 19.9 19.9 0 0 0 5.99 3.03.08.08 0 0 0 .08-.03c.46-.63.87-1.3 1.23-1.99a.08.08 0 0 0-.04-.11 13.1 13.1 0 0 1-1.87-.89.08.08 0 0 1 0-.13l.37-.29a.07.07 0 0 1 .08-.01c3.93 1.79 8.18 1.79 12.06 0a.07.07 0 0 1 .08 0c.12.1.24.2.37.3a.08.08 0 0 1 0 .13c-.6.35-1.22.64-1.87.89a.08.08 0 0 0-.04.1c.36.7.77 1.36 1.22 2a.08.08 0 0 0 .09.02 19.84 19.84 0 0 0 6-3.03.08.08 0 0 0 .03-.05c.5-5.18-.84-9.67-3.55-13.66a.06.06 0 0 0-.03-.03ZM8.02 15.33c-1.18 0-2.16-1.08-2.16-2.42 0-1.33.96-2.42 2.16-2.42 1.21 0 2.18 1.1 2.16 2.42 0 1.34-.96 2.42-2.16 2.42Zm7.97 0c-1.18 0-2.15-1.08-2.15-2.42 0-1.33.95-2.42 2.15-2.42 1.22 0 2.18 1.1 2.16 2.42 0 1.34-.94 2.42-2.16 2.42Z" />
    </svg>
  ) : (
    <svg
      class={className}
      {...dims}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.6"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      {name === 'arrow' && <path d="M4 12h15m-6-6 6 6-6 6" />}
      {name === 'arrow-down' && <path d="M12 4v15m-6-6 6 6 6-6" />}
      {name === 'play' && <path d="M8 5.5v13l11-6.5-11-6.5Z" fill="currentColor" stroke="none" />}
      {name === 'copy' && (
        <>
          <rect x="8" y="8" width="12" height="12" rx="2.5" />
          <path d="M16 8V6.5A2.5 2.5 0 0 0 13.5 4h-7A2.5 2.5 0 0 0 4 6.5v7A2.5 2.5 0 0 0 6.5 16H8" />
        </>
      )}
      {name === 'check' && <path d="m5 12.5 4.5 4.5L19 7.5" />}
      {name === 'close' && <path d="M6 6l12 12M18 6 6 18" />}
      {name === 'plus' && <path d="M12 5v14M5 12h14" />}
      {name === 'shield' && (
        <>
          <path d="M12 3.5 5 6v5.5c0 4.3 2.9 7.9 7 9 4.1-1.1 7-4.7 7-9V6l-7-2.5Z" />
          <path d="m9 12 2.2 2.2L15.5 10" />
        </>
      )}
      {name === 'chat' && <path d="M5 18.5V7a2.5 2.5 0 0 1 2.5-2.5h9A2.5 2.5 0 0 1 19 7v6.5a2.5 2.5 0 0 1-2.5 2.5H9l-4 2.5ZM9 9h6M9 12h4" />}
      {name === 'brief' && <path d="M7 3.5h7l4 4V19a1.5 1.5 0 0 1-1.5 1.5h-9.5A1.5 1.5 0 0 1 5.5 19V5A1.5 1.5 0 0 1 7 3.5ZM13.5 3.5V8h4.5M8.5 12h7M8.5 15.5h5" />}
      {name === 'scissors' && (
        <>
          <circle cx="6.5" cy="6.5" r="2.5" />
          <circle cx="6.5" cy="17.5" r="2.5" />
          <path d="M8.6 7.9 19 17M8.6 16.1 19 7" />
        </>
      )}
      {name === 'send' && <path d="M20 4 3.5 10.5l6.5 2.5 2.5 6.5L20 4ZM10 13l4.5-4.5" />}
      {name === 'wallet' && (
        <>
          <path d="M4 7.5A2.5 2.5 0 0 1 6.5 5H18v3.5" />
          <path d="M4 7.5V17a2 2 0 0 0 2 2h13a1 1 0 0 0 1-1v-8.5a1 1 0 0 0-1-1H6.5A2.5 2.5 0 0 1 4 7.5Z" />
          <circle cx="16" cy="13.75" r="1" fill="currentColor" stroke="none" />
        </>
      )}
      {name === 'pause' && (
        <>
          <rect x="6.75" y="5.5" width="3.75" height="13" rx="1" fill="currentColor" stroke="none" />
          <rect x="13.5" y="5.5" width="3.75" height="13" rx="1" fill="currentColor" stroke="none" />
        </>
      )}
      {name === 'volume' && (
        <>
          <path d="M4.5 9.75h3l4.5-4v12.5l-4.5-4h-3v-4.5Z" />
          <path d="M15.5 9.25a4 4 0 0 1 0 5.5M18 6.75a7.5 7.5 0 0 1 0 10.5" />
        </>
      )}
      {name === 'mute' && (
        <>
          <path d="M4.5 9.75h3l4.5-4v12.5l-4.5-4h-3v-4.5Z" />
          <path d="m15.75 9.75 4.5 4.5m0-4.5-4.5 4.5" />
        </>
      )}
      {name === 'expand' && <path d="M4.5 9V4.5H9M15 4.5h4.5V9M19.5 15v4.5H15M9 19.5H4.5V15" />}
      {name === 'compress' && <path d="M9 4.5V9H4.5M19.5 9H15V4.5M15 19.5V15h4.5M4.5 15H9v4.5" />}
      {name === 'replay' && (
        <>
          <path d="M4 12a8 8 0 1 0 8-8 8.6 8.6 0 0 0-5.95 2.45L4 8.5" />
          <path d="M4 4.25V8.5h4.25" />
        </>
      )}
      {name === 'next' && (
        <>
          <path d="M6 5.5v13l10-6.5-10-6.5Z" fill="currentColor" stroke="none" />
          <path d="M18.5 6v12" />
        </>
      )}
    </svg>
  )
}
