---
/**
 * Logotype : deux plans séparés par une coupe, le nom, le métier en dessous
 * (comme « Halflight / Glencoe » dans la référence).
 */
import { site } from '../../config/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<span class:list={['logo', className]}>
  <svg class="logo__mark" viewBox="0 0 30 16" aria-hidden="true">
    <rect x="0" y="0" width="17" height="16" rx="2.5"></rect>
    <rect x="21.75" y="0.75" width="7.5" height="14.5" rx="2"></rect>
  </svg>
  <span class="logo__text">
    <span class="logo__name">{site.name}</span>
    <span class="logo__sub">monteur vidéo</span>
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--cream);
  }

  .logo__mark {
    width: 1.55rem;
    height: auto;
    flex: none;
  }

  .logo__mark rect:first-child {
    fill: currentColor;
  }

  .logo__mark rect:last-child {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }

  .logo__text {
    display: grid;
    line-height: 1;
  }

  .logo__name {
    font-size: 1rem;
    font-weight: 780;
    font-stretch: 125%;
    letter-spacing: -0.01em;
  }

  .logo__sub {
    margin-top: 0.2rem;
    font-size: 0.625rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--fog);
  }
</style>
