---
/**
 * Étiquette de section façon piste de timeline : [V1] 01 — Services ────
 */
interface Props {
  track: string;
  index: string;
  label: string;
  class?: string;
}

const { track, index, label, class: className } = Astro.props;
---

<div class:list={['track', className]} data-reveal="track">
  <span class="track__id mono">{track}</span>
  <span class="track__label mono"><span class="track__index">{index}</span> — {label}</span>
  <span class="track__line" aria-hidden="true"></span>
</div>

<style>
  .track {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    color: var(--color-fog-400);
  }

  .track__id {
    display: inline-grid;
    place-items: center;
    min-width: 2.2rem;
    height: 1.55rem;
    padding-inline: 0.45rem;
    border-radius: 4px;
    border: 1px solid rgb(255 77 90 / 0.45);
    background: rgb(229 22 42 / 0.1);
    color: var(--color-rec-bright);
    font-size: 0.66rem;
  }

  .track__index {
    color: var(--color-fog-100);
  }

  .track__line {
    flex: 1;
    height: 1px;
    max-width: 14rem;
    background: linear-gradient(90deg, var(--line-strong), transparent);
  }
</style>
