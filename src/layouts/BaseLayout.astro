---
import '../styles/global.css';

import { site, isDiscordConfigured } from '../config/site';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import PlayerDialog from '../components/portfolio/PlayerDialog.astro';

interface Props {
  /** Titre de la page (sans le nom de la marque). Laissez vide pour la page d'accueil. */
  title?: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = site.seo.description, noindex = false } = Astro.props;

const fullTitle = title ? `${title} — ${site.name}` : site.seo.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(site.seo.ogImage, Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: site.name,
  description: site.seo.description,
  url: Astro.site?.href,
  image: ogImage.href,
  serviceType: 'Montage vidéo',
  knowsLanguage: 'fr',
  email: site.email,
  ...(isDiscordConfigured ? { sameAs: [site.discord.url] } : {}),
};
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="theme-color" content="#0b0907" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href="/fonts/archivo-var-latin.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/corinthia-400-latin.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        // Filet de sécurité : si les scripts ne démarrent pas, rien ne reste caché.
        setTimeout(function () {
          if (!d.classList.contains('reveal-ready')) d.classList.add('reveal-off');
        }, 3000);
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body>
    <a class="skip-link" href="#main">Aller au contenu</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <PlayerDialog />

    <script>
      import '../scripts/main';
    </script>
  </body>
</html>
