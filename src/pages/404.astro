---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/ui/Icon.astro';
---

<BaseLayout title="Plan introuvable" noindex>
  <section class="lost">
    <img class="lost__bg" src="/plan/16x9/poster.webp" alt="" width="1600" height="900" decoding="async" />
    <span class="lost__shade" aria-hidden="true"></span>
    <div class="wrap lost__content">
      <p class="label">Erreur 404</p>
      <h1 class="lost__title display">Plan <span class="script">introuvable.</span></h1>
      <p class="lede">Ce plan n’existe pas, ou il a été coupé au montage. Revenez à la séquence principale.</p>
      <div class="lost__actions">
        <a class="pill pill--solid pill--lg" href="/">Retour à l’accueil <Icon name="arrow" /></a>
        <a class="pill pill--lg" href="/contact">Me contacter</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .lost {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 100svh;
    padding: calc(var(--header-h) + 2rem) 0 clamp(3rem, 8vw, 6rem);
    overflow: hidden;
  }

  .lost__bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.7) brightness(0.45);
  }

  .lost__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, var(--night), transparent 70%);
  }

  .lost__content {
    position: relative;
    display: grid;
    gap: 1.5rem;
    justify-items: start;
  }

  .lost__title {
    font-size: clamp(3.2rem, 11vw, 10rem);
  }

  .lost__title .script {
    font-size: 0.7em;
    color: var(--tungsten);
  }

  .lost__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
</style>
