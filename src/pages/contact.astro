---
import BaseLayout from '../layouts/BaseLayout.astro';
import { services } from '../data/services';
import DiscordCard from '../components/contact/DiscordCard.astro';
import OrderSteps from '../components/contact/OrderSteps.astro';
import Packages from '../components/home/Packages.astro';
import TrackLabel from '../components/ui/TrackLabel.astro';
import DiscordButton from '../components/ui/DiscordButton.astro';
import Button from '../components/ui/Button.astro';
---

<BaseLayout
  title="Contact"
  description="Contactez nether sur Discord pour le montage de vos vidéos YouTube, TikTok ou Reels. Paiement en une fois ou en fin de mois, via Apa."
>
  <section id="contact" class="c-hero" data-chapter="Contact" data-hero-root>
    <div class="c-hero__bg" aria-hidden="true"></div>
    <div class="wrap c-hero__grid">
      <div class="c-hero__intro">
        <p class="c-hero__eyebrow mono" data-hero>
          <span class="rec-dot" aria-hidden="true"></span>Contact · réponse sur Discord
        </p>
        <h1 class="c-hero__title h-display" data-hero aria-label="Parlons de votre prochaine vidéo.">
          <span class="c-line" aria-hidden="true"><span data-hero-line>Parlons de votre</span></span>
          <span class="c-line" aria-hidden="true"><span data-hero-line><em class="serif">prochaine vidéo.</em></span></span>
        </h1>
        <p class="lead" data-hero>
          Monteur vidéo freelance pour créateurs YouTube, TikTok et Instagram, avec une spécialité : les vidéos
          longues de 10 minutes et plus.
        </p>

        <div class="c-services" data-hero>
          <p class="mono c-services__title">Prestations</p>
          <ul>
            {
              services.map((s) => (
                <li>
                  <span class="c-services__name">{s.title}</span>
                  <span class="mono c-services__format">{s.format}</span>
                  {s.featured && <span class="c-services__badge mono">Spécialité</span>}
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <DiscordCard />
    </div>
  </section>

  <OrderSteps />
  <Packages id="paiement" chapter="Paiement" track="A1" index="03" withSafety />

  <section class="c-end" data-chapter="À bientôt">
    <div class="wrap c-end__inner">
      <TrackLabel track="REC" index="04" label="Fin" />
      <h2 class="c-end__text" data-reveal="lines">
        Une question avant de vous lancer&nbsp;? <span class="serif">Écrivez-moi, simplement.</span>
      </h2>
      <div class="c-end__actions" data-reveal="fade" data-scrubber-avoid>
        <DiscordButton />
        <Button href="/portfolio">Revoir le portfolio</Button>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .c-hero {
    position: relative;
    isolation: isolate;
    padding-top: calc(var(--header-h) + clamp(3rem, 8vw, 6rem));
    padding-bottom: clamp(5rem, 10vw, 8rem);
    overflow: hidden;
  }

  .c-hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 50% 45% at 85% 20%, rgb(229 22 42 / 0.16), transparent),
      linear-gradient(90deg, rgb(255 255 255 / 0.03) 1px, transparent 1px) 0 0 / calc(100% / 12) 100%;
    -webkit-mask-image: linear-gradient(180deg, #000 60%, transparent);
    mask-image: linear-gradient(180deg, #000 60%, transparent);
  }

  .c-hero__grid {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
  }

  @media (min-width: 64rem) {
    .c-hero__grid {
      grid-template-columns: 1.1fr 1fr;
      align-items: start;
    }
  }

  .c-hero__intro {
    display: grid;
    gap: 1.75rem;
    align-content: start;
  }

  .c-hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--color-fog-400);
  }

  .c-hero__title {
    font-size: clamp(2.8rem, 5.4vw, 6rem);
  }

  .c-line {
    display: block;
    overflow: hidden;
    padding: 0.02em 0.1em 0.1em;
    margin: -0.02em -0.1em -0.1em;
  }

  .c-line > span {
    display: block;
  }

  .c-services {
    margin-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .c-services__title {
    padding-block: 1rem 0.5rem;
    color: var(--color-fog-400);
    font-size: 0.6rem;
  }

  .c-services ul {
    display: grid;
  }

  .c-services li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    padding-block: 0.95rem;
    border-bottom: 1px solid var(--line);
  }

  .c-services__name {
    flex: 1;
    min-width: 12rem;
    font-size: 1.1rem;
    font-weight: 500;
    letter-spacing: -0.015em;
  }

  .c-services__format {
    color: var(--color-fog-400);
    font-size: 0.6rem;
  }

  .c-services__badge {
    padding: 0.25rem 0.55rem;
    border-radius: 999px;
    background: rgb(229 22 42 / 0.14);
    color: var(--color-rec-bright);
    font-size: 0.55rem;
  }

  .c-end {
    padding-block: clamp(5rem, 10vw, 9rem) clamp(4rem, 8vw, 6rem);
    border-top: 1px solid var(--line);
  }

  .c-end__inner {
    display: grid;
    gap: 2rem;
  }

  .c-end__text {
    max-width: 18ch;
    font-size: clamp(2.2rem, 5vw, 4.5rem);
    font-weight: 560;
    letter-spacing: -0.045em;
    line-height: 1;
  }

  .c-end__text .serif {
    color: var(--color-fog-300);
  }

  .c-end__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 0.85rem;
  }
</style>
