---
/**
 * Page d'un projet : générée pour chaque projet en ligne de src/data/portfolio.ts (et les coulisses).
 * Les sections sans contenu ne s'affichent pas : un nouveau projet n'a besoin que de ce qu'il a réellement.
 */
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { site, discordHref, isDiscordConfigured } from '../../config/site';
import { categoryHref, neighbors, pad, posterOf, projectPages, type Project } from '../../lib/portfolio';
import Poster from '../../components/portfolio/Poster.astro';
import PlayTrigger from '../../components/portfolio/PlayTrigger.astro';
import BeforeAfter from '../../components/portfolio/BeforeAfter.astro';
import Icon from '../../components/ui/Icon.astro';

export const getStaticPaths = (() =>
  projectPages.map((project) => ({ params: { slug: project.slug }, props: { project } }))) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project: p } = Astro.props;
const nav = neighbors(p.slug);
const poster = await posterOf(p);
const vertical = p.format === '9:16';
const external = isDiscordConfigured ? { target: '_blank', rel: 'noopener noreferrer' } : {};
const playText = (i: number): string => {
  const v = p.playable[i];
  if (!v) return '';
  if (p.playable.length === 1) return v.excerpt ? v.playLabel : `${v.playLabel} · ${v.duration ?? ''}`;
  return `${vertical ? 'Extrait' : 'Partie'} ${i + 1} · ${v.duration ?? ''}`;
};
const rows = [
  { label: 'Créateur', value: p.creator },
  { label: 'Type de montage', value: p.editType },
  p.duration && { label: 'Durée', value: p.playable.length > 1 && !vertical ? `${p.duration} · ${p.playable.length} parties` : p.duration },
  p.date && { label: 'Publication', value: p.date.label },
  p.platform && { label: 'Plateforme', value: p.platform },
].filter((r): r is { label: string; value: string } => Boolean(r));
const showVideos = p.playable.length > 1 || p.playable.some((v) => v.chapters.length > 0 || v.description);
const tall = vertical ? p.playable.filter((v) => v.poster).slice(0, 2) : [];
---

<BaseLayout title={p.title} description={p.description || `${p.title} : un montage réalisé par ${site.name}.`}>
  <section class="ph" aria-labelledby="ph-title">
    <div class:list={['ph__media', vertical && 'ph__media--tall']} aria-hidden="true">
      {
        vertical && tall.length > 0 ? (
          tall.map((v) => <Image src={v.poster!} alt="" widths={[360, 540]} sizes="(min-width: 48rem) 20rem, 44vw" loading="eager" />)
        ) : (
          <Poster source={poster} alt="" sizes="100vw" widths={[960, 1280, 1600, 1920]} loading="eager" fetchpriority="high" />
        )
      }
    </div>
    <span class="ph__shade" aria-hidden="true"></span>

    <div class="ph__content wrap">
      <nav class="ph__crumbs label" aria-label="Fil d’Ariane">
        <a href="/portfolio"><Icon name="arrow" /> Réalisations</a>
        {p.categories[0] && <a href={categoryHref(p.categories[0].id)}>{p.categories[0].label}</a>}
        {nav.total > 1 && <span class="num">{pad(nav.position)} / {pad(nav.total)}</span>}
      </nav>
      <h1 class="ph__title" id="ph-title" set:html={p.titleHtml} />
      {p.subtitle && <p class="ph__subtitle">{p.subtitle}</p>}

      <div class="ph__card glass">
        {p.description && <p class="ph__lede">{p.description}</p>}
        <dl class="ph__facts">
          {
            rows.map((r) => (
              <div>
                <dt>{r.label}</dt>
                <dd>{r.value}</dd>
              </div>
            ))
          }
          <div>
            <dt>Univers</dt>
            <dd class="ph__cats">
              {p.categories.map((c) => <a href={categoryHref(c.id)}>{c.label}</a>)}
            </dd>
          </div>
          <div>
            <dt>Montage</dt>
            <dd>{site.name}</dd>
          </div>
        </dl>
        <div class="ph__actions">
          {
            p.playable.map((v, i) => (
              <PlayTrigger project={p} video={v} anchor class:list={['pill', i === 0 ? 'pill--solid' : 'pill--glass']}>
                <Icon name="play" />
                {playText(i)}
              </PlayTrigger>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  {
    (p.context.length > 0 || p.facts.length > 0 || p.compression) && (
      <section class="pp" aria-labelledby="pp-context">
        <div class="wrap pp__grid">
          <div>
            <p class="label">Le contexte</p>
            <h2 class="pp__title" id="pp-context">
              Ce qu’il fallait <span class="script">raconter.</span>
            </h2>
          </div>
          <div class="pp__text">
            {p.context.map((t) => <p>{t}</p>)}
            {p.compression && (
              <div class="pp__cut" aria-label={`Rush de ${p.compression.raw}, montage de ${p.compression.final}`}>
                <p class="label">
                  Rush {p.compression.raw} → montage {p.compression.final}
                </p>
                <span class="pp__cut-raw">
                  <i style={`--kept:${(p.compression.finalSeconds / p.compression.rawSeconds).toFixed(4)}`} />
                </span>
              </div>
            )}
          </div>
          {p.facts.length > 0 && (
            <dl class="pp__facts">
              {p.facts.map((f) => (
                <div>
                  <dt>{f.label}</dt>
                  <dd class="num">{f.value}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </section>
    )
  }

  {
    showVideos && (
      <section class="pp" aria-labelledby="pp-videos">
        <div class="wrap">
          <p class="label">Les vidéos</p>
          <h2 class="pp__title" id="pp-videos">
            {p.playable.length > 1 ? `${p.playable.length} ${vertical ? 'extraits' : 'parties'}, à lire dans l’ordre.` : 'La vidéo.'}
          </h2>
          <ol class="pv">
            {p.playable.map((v, i) => (
              <li class:list={['pv__item', vertical && 'pv__item--tall']}>
                <PlayTrigger project={p} video={v} class="pv__thumb" aria-label={`Lire : ${v.title}`}>
                  {v.poster && <Image src={v.poster} alt="" widths={vertical ? [240, 360] : [480, 720]} sizes="(min-width: 48rem) 22rem, 100vw" />}
                  <span class="pv__play" aria-hidden="true">
                    <Icon name="play" />
                  </span>
                </PlayTrigger>
                <div class="pv__body">
                  <p class="label num">
                    {pad(i + 1)} {v.duration && `· ${v.duration}`}
                  </p>
                  <h3 class="pv__title">{v.title}</h3>
                  {v.description && <p class="muted">{v.description}</p>}
                  {v.chapters.length > 0 && (
                    <ol class="pv__chapters">
                      {v.chapters.map((c) => (
                        <li>
                          <span class="num">{c.time}</span> {c.label}
                        </li>
                      ))}
                    </ol>
                  )}
                  {v.credits && <p class="pv__credits">{v.credits}</p>}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </section>
    )
  }

  {
    p.tracks.length > 0 && (
      <section class="pp" aria-labelledby="pp-work">
        <div class="wrap">
          <p class="label">Ce que j’ai fait</p>
          <h2 class="pp__title" id="pp-work">
            Piste par <span class="script">piste.</span>
          </h2>
          <div class="tracks">
            {p.tracks.map((track) => (
              <div class="tracks__row">
                <p class="tracks__name">
                  <span class="num">{track.id}</span> {track.name}
                </p>
                <ul class="tracks__items">
                  {track.items.map((item) => (
                    <li>
                      <strong>{item.label}</strong>
                      {item.detail && <span class="muted"> {item.detail}</span>}
                    </li>
                  ))}
                </ul>
              </div>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    (p.outline.length > 0 || p.frames.length > 0) && (
      <section class="pp" aria-labelledby="pp-structure">
        <div class="wrap">
          <p class="label">La structure</p>
          <h2 class="pp__title" id="pp-structure">
            {p.outline.length} chapitres, une <span class="script">histoire.</span>
          </h2>
          {p.outline.length > 0 && (
            <ol class="outline">
              {p.outline.map((c) => (
                <li style={`--share:${(c.to - c.from).toFixed(4)}`}>
                  <span class="num">{c.time}</span>
                  <span>{c.label}</span>
                </li>
              ))}
            </ol>
          )}
          {p.frames.length > 0 && (
            <ul class="frames">
              {p.frames.map((f) => (
                <li>
                  <Image src={f.image} alt={`${f.label}, à ${f.time}`} widths={[480, 720]} sizes="(min-width: 48rem) 30vw, 100vw" />
                  <p>
                    <span class="num">{f.time}</span> {f.label}
                  </p>
                </li>
              ))}
            </ul>
          )}
        </div>
      </section>
    )
  }

  {
    p.beforeAfter && (
      <section class="pp" aria-labelledby="pp-compare">
        <div class="wrap">
          <p class="label">Avant / après</p>
          <h2 class="pp__title" id="pp-compare">
            Avant, <span class="script">après.</span>
          </h2>
          <div class="pp__compare">
            <BeforeAfter {...p.beforeAfter} title={p.title} />
          </div>
        </div>
      </section>
    )
  }

  {
    (p.process.length > 0 || p.tools.length > 0) && (
      <section class="pp" aria-labelledby="pp-process">
        <div class="wrap">
          <p class="label">Les étapes</p>
          <h2 class="pp__title" id="pp-process">
            Ce qu’on voit <span class="script">à l’écran.</span>
          </h2>
          <ol class="steps">
            {p.process.map((s, i) => (
              <li>
                <span class="label num">{pad(i + 1)}</span>
                <h3>{s.title}</h3>
                <p class="muted">{s.text}</p>
              </li>
            ))}
          </ol>
          {p.tools.length > 0 && <p class="pp__tools">Outil : {p.tools.join(', ')}</p>}
        </div>
      </section>
    )
  }

  <section class="pend" aria-label="Suite">
    <div class="wrap pend__grid">
      {
        nav.prev && (
          <a class="pend__link" href={nav.prev.href}>
            <span class="label">Projet précédent</span>
            <span class="pend__name" set:html={nav.prev.titleHtml} />
          </a>
        )
      }
      {
        nav.next && (
          <a class="pend__link pend__link--next" href={nav.next.href}>
            <span class="label">Projet suivant</span>
            <span class="pend__name" set:html={nav.next.titleHtml} />
          </a>
        )
      }
      <div class="pend__cta">
        <h2 class="h-title">Un projet du même genre ?</h2>
        <a class="pill pill--solid pill--lg" href={discordHref} {...external}>
          <Icon name="discord" />
          Écrire sur Discord
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .ph {
    position: relative;
    display: grid;
    align-items: end;
    min-height: 100svh;
    padding: calc(var(--header-h) + 2rem) 0 var(--gutter);
    overflow: hidden;
  }

  .ph__media {
    position: absolute;
    inset: 0;
  }

  .ph__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ph__media--tall {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 1.25rem;
    padding: calc(var(--header-h) + 1rem) var(--gutter) var(--gutter);
    background: radial-gradient(ellipse 60% 70% at 70% 50%, var(--night-3), var(--night));
  }

  .ph__media--tall :global(img) {
    width: min(20rem, 30vw);
    height: auto;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius-md);
  }

  /* Voile appuyé : les affiches portent souvent du texte incrusté, le titre doit rester lisible par-dessus */
  .ph__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgb(11 9 7 / 0.7), rgb(11 9 7 / 0.35) 30%),
      linear-gradient(0deg, rgb(11 9 7 / 0.94), rgb(11 9 7 / 0.62) 55%, rgb(11 9 7 / 0.2));
  }

  .ph__content {
    position: relative;
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .ph__crumbs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    color: var(--fog);
  }

  .ph__crumbs a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.75rem;
    color: var(--cream);
  }

  .ph__crumbs :global(svg) {
    width: 0.9rem;
    height: 0.9rem;
    rotate: 180deg;
  }

  .ph__crumbs .num {
    display: inline-flex;
    align-items: center;
  }

  .ph__title {
    max-width: 16ch;
    font-size: clamp(2.8rem, 7.5vw, 7rem);
    font-weight: 820;
    font-stretch: 122%;
    letter-spacing: -0.04em;
    line-height: 0.92;
    text-wrap: balance;
  }

  .ph__title :global(em),
  .pend__name :global(em) {
    font-family: var(--script);
    font-size: 1.25em;
    font-style: normal;
    font-weight: 400;
    letter-spacing: 0;
    color: var(--tungsten);
  }

  .ph__subtitle {
    color: var(--fog);
    font-weight: 560;
  }

  .ph__card {
    display: grid;
    gap: 1rem;
    width: min(100%, 34rem);
    margin-top: 1rem;
    padding: 1.3rem 1.4rem;
  }

  .ph__lede {
    font-weight: 540;
    line-height: 1.45;
  }

  .ph__facts {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem 1.25rem;
    margin: 0;
  }

  .ph__facts dt,
  .pp__facts dt {
    color: var(--fog-2);
    font-size: 0.6875rem;
    font-weight: 620;
    font-stretch: 125%;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .ph__facts dd {
    margin: 0.15rem 0 0;
    font-weight: 560;
  }

  .ph__cats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
  }

  .ph__cats a {
    text-decoration: underline;
    text-decoration-color: var(--hair-strong);
    text-underline-offset: 0.25em;
  }

  .ph__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  /* ── Sections ── */
  .pp {
    padding-block: clamp(4rem, 8vw, 7rem);
    border-top: 1px solid var(--hair);
  }

  .pp__grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 2rem clamp(2rem, 6vw, 6rem);
  }

  .pp__title {
    margin-top: 0.6rem;
    font-size: clamp(2rem, 3.8vw, 3.2rem);
    font-weight: 740;
    font-stretch: 116%;
    letter-spacing: -0.035em;
    line-height: 1.02;
  }

  .pp__title .script {
    font-size: 1.3em;
    font-weight: 400;
    color: var(--tungsten);
  }

  .pp__text {
    display: grid;
    gap: 1rem;
    max-width: 44rem;
    color: var(--fog);
    font-size: 1.05rem;
  }

  .pp__cut {
    display: grid;
    gap: 0.6rem;
    margin-top: 0.5rem;
  }

  .pp__cut-raw {
    position: relative;
    display: block;
    height: 0.9rem;
    border-radius: 0.3rem;
    background: repeating-linear-gradient(90deg, rgb(239 228 200 / 0.3) 0 3px, rgb(239 228 200 / 0.1) 3px 9px);
  }

  .pp__cut-raw i {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--kept) * 100%);
    border-radius: inherit;
    background: var(--cream);
  }

  .pp__facts {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    margin: 1rem 0 0;
    border-top: 1px solid var(--hair-strong);
  }

  .pp__facts > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.4rem;
    padding: 1.25rem 1.5rem 0 0;
  }

  .pp__facts dd {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 840;
    font-stretch: 125%;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .pv {
    display: grid;
    gap: 2rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .pv__item {
    display: grid;
    grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    gap: clamp(1.25rem, 3vw, 2.5rem);
    padding-top: 2rem;
    border-top: 1px solid var(--hair);
  }

  .pv__item--tall {
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
  }

  .pv__thumb {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    overflow: hidden;
    border: 0;
    border-radius: var(--radius-md);
    background: var(--night-2);
  }

  .pv__thumb :global(img) {
    width: 100%;
    transition: transform var(--dur-crawl) var(--ease-expo);
  }

  .pv__thumb:hover :global(img) {
    transform: scale(1.04);
  }

  .pv__play {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: var(--cream);
    color: var(--night);
  }

  .pv__play :global(svg) {
    width: 1rem;
    height: 1rem;
    margin-left: 2px;
  }

  .pv__body {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .pv__title {
    font-size: clamp(1.3rem, 2vw, 1.7rem);
    font-weight: 720;
    font-stretch: 112%;
    letter-spacing: -0.025em;
    line-height: 1.1;
  }

  .pv__chapters {
    display: grid;
    gap: 0.3rem;
    margin: 0.4rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.92rem;
  }

  .pv__chapters .num {
    display: inline-block;
    min-width: 3rem;
    color: var(--tungsten);
    font-weight: 620;
  }

  .pv__credits {
    color: var(--fog-2);
    font-size: 0.8rem;
  }

  .tracks {
    margin-top: 2.5rem;
    border-top: 1px solid var(--hair-strong);
  }

  .tracks__row {
    display: grid;
    grid-template-columns: minmax(0, 12rem) minmax(0, 1fr);
    gap: 1.5rem;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--hair);
  }

  .tracks__name {
    font-weight: 720;
    font-stretch: 112%;
  }

  .tracks__name .num {
    display: inline-grid;
    place-items: center;
    min-width: 2.2rem;
    margin-right: 0.5rem;
    padding: 0.15rem 0.4rem;
    border-radius: 0.35rem;
    background: var(--cream);
    color: var(--night);
    font-size: 0.75rem;
  }

  .tracks__items {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .outline {
    display: flex;
    gap: 3px;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .outline li {
    flex: var(--share) 1 0;
    min-width: 0;
    padding: 0.7rem 0.6rem;
    border-radius: 0.4rem;
    background: rgb(239 228 200 / 0.08);
    box-shadow: inset 0 0 0 1px var(--hair);
    font-size: 0.78rem;
    line-height: 1.3;
    overflow: hidden;
  }

  .outline .num {
    display: block;
    color: var(--tungsten);
    font-weight: 620;
  }

  .frames {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.25rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .frames :global(img) {
    width: 100%;
    border-radius: var(--radius-md);
  }

  .frames p {
    margin-top: 0.6rem;
    font-size: 0.9rem;
  }

  .frames .num {
    color: var(--tungsten);
    font-weight: 620;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.5rem;
    margin: 2.5rem 0 0;
    padding: 0;
    list-style: none;
  }

  .steps li {
    display: grid;
    gap: 0.5rem;
    padding-top: 1.2rem;
    border-top: 1px solid var(--hair-strong);
  }

  .steps h3 {
    font-size: 1.3rem;
    font-weight: 720;
    font-stretch: 112%;
  }

  .pp__tools {
    margin-top: 2rem;
    color: var(--fog);
  }

  .pend {
    padding-block: clamp(4rem, 8vw, 6rem);
    border-top: 1px solid var(--hair);
  }

  .pend__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2rem;
  }

  .pend__link {
    display: grid;
    gap: 0.5rem;
    padding: 1.5rem 0;
    border-top: 1px solid var(--hair-strong);
  }

  .pend__link--next {
    text-align: right;
  }

  .pend__name {
    font-size: clamp(1.5rem, 3vw, 2.4rem);
    font-weight: 760;
    font-stretch: 116%;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }

  .pend__link:hover .pend__name {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.15em;
  }

  .pend__cta {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-top: 2rem;
  }

  @media (max-width: 48rem) {
    .ph__media--tall {
      justify-content: center;
