---
/**
 * Page Réalisations : tous les projets de src/data/portfolio.ts, filtrables par catégorie,
 * puis les coulisses (le film FilmCraft) et le contact.
 * Ajouter un projet dans src/data/portfolio.ts suffit : il apparaît ici, avec sa page et ses filtres.
 */
import { getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { behind, galleryProjects, liveProjects, pad, toClock, toSeconds, usedCategories } from '../../lib/portfolio';
import { discordHref, isDiscordConfigured } from '../../config/site';
import ProjectRow from '../../components/portfolio/ProjectRow.astro';
import PlayTrigger from '../../components/portfolio/PlayTrigger.astro';
import Icon from '../../components/ui/Icon.astro';

/* Chiffres de l'en-tête : calculés à partir des projets en ligne, rien n'est saisi à la main. */
const editedSeconds = liveProjects.reduce((total, p) => total + toSeconds(p.duration), 0);
const stats = [
  { label: 'Réalisations', value: pad(liveProjects.length) },
  { label: 'Catégories', value: pad(usedCategories.length) },
  ...(editedSeconds > 0 ? [{ label: 'De vidéo montée', value: toClock(editedSeconds) }] : []),
];
const behindPoster = behind.ready && behind.poster ? (await getImage({ src: behind.poster, width: 1280, format: 'webp' })).src : null;
const external = isDiscordConfigured ? { target: '_blank', rel: 'noopener noreferrer' } : {};
---

<BaseLayout
  title="Réalisations"
  description="Les montages vidéo de nether, projet par projet : crypto et trading, gaming, YouTube long format, formats courts. Le contexte, les choix de montage et le travail réalisé."
>
  <section class="works" aria-labelledby="works-title">
    <div class="wrap">
      <header class="works__head">
        <p class="label">Réalisations</p>
        <h1 class="works__title display" id="works-title">Ce que j’ai <span class="script">monté.</span></h1>
        <p class="lede muted works__lead">
          Des vidéos que j’ai montées pour des créateurs, de la crypto au gaming. Chaque projet a sa page : le
          contexte, les choix de montage et le travail réalisé, piste par piste.
        </p>
        <dl class="works__stats">
          {
            stats.map((s) => (
              <div>
                <dt class="label">{s.label}</dt>
                <dd class="num">{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </header>

      {
        usedCategories.length > 1 && (
          <div class="works__filters" role="group" aria-label="Filtrer par catégorie" data-filters>
            <button type="button" class="pill" data-filter="tout" aria-pressed="true">
              Tout <span class="num">{pad(liveProjects.length)}</span>
            </button>
            {usedCategories.map((c) => (
              <button type="button" class="pill" data-filter={c.id} aria-pressed="false">
                {c.label} <span class="num">{pad(c.count)}</span>
              </button>
            ))}
            <p class="works__status" aria-live="polite" data-filter-status />
          </div>
        )
      }

      <div class="works__list">
        {galleryProjects.map((p, i) => <ProjectRow project={p} index={i} flip={i % 2 === 1} />)}
      </div>
    </div>
  </section>

  {
    behind.ready && behind.playable[0] && (
      <section class="bte" aria-labelledby="bte-title">
        <div class="wrap bte__grid">
          <a class="bte__media" href={behind.href} tabindex="-1" aria-hidden="true">
            {behindPoster && <img src={behindPoster} alt="" width="1280" height="720" loading="lazy" decoding="async" />}
          </a>
          <div class="bte__body">
            <p class="label">Coulisses</p>
            <h2 class="bte__title" id="bte-title">
              <a href={behind.href} set:html={behind.titleHtml} />
            </h2>
            <p class="muted">{behind.description}</p>
            <div class="bte__actions">
              <PlayTrigger project={behind} video={behind.playable[0]} class="pill pill--solid">
                <Icon name="play" />
                Regarder avec le son · 0:42
              </PlayTrigger>
              <a class="pill" href={behind.href}>
                Les étapes
                <Icon name="arrow" />
              </a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="works-cta" aria-labelledby="works-cta-title">
    <div class="wrap works-cta__inner">
      <h2 class="h-title" id="works-cta-title">Un projet du même genre ?</h2>
      <a class="pill pill--solid pill--lg" href={discordHref} {...external}>
        <Icon name="discord" />
        Écrire sur Discord
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .works {
    padding-top: calc(var(--header-h) + clamp(3rem, 8vw, 6rem));
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .works__head {
    display: grid;
    gap: 1.25rem;
  }

  .works__title {
    font-size: clamp(3.2rem, 10.5vw, 9.5rem);
    color: var(--cream);
  }

  .works__title .script {
    margin-left: 0.04em;
    font-size: 0.82em;
    color: var(--tungsten);
  }

  .works__lead {
    max-width: 40rem;
  }

  .works__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem clamp(2rem, 5vw, 4rem);
    margin: 0.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--hair-strong);
  }

  .works__stats > div {
    display: flex;
    flex-direction: column-reverse;
    gap: 0.35rem;
  }

  .works__stats dd {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    font-weight: 820;
    font-stretch: 125%;
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .works__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: clamp(2.5rem, 5vw, 4rem);
  }

  .works__filters .pill[aria-pressed='true'] {
    border-color: var(--cream);
    background: var(--cream);
    color: var(--night);
  }

  .works__filters .num {
    opacity: 0.6;
  }

  .works__status {
    margin-left: auto;
    color: var(--fog-2);
    font-size: 0.85rem;
  }

  .works__list {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
  }

  .bte {
    padding-block: clamp(3rem, 7vw, 6rem);
    border-top: 1px solid var(--hair);
    background:
      radial-gradient(ellipse 50% 60% at 20% 50%, rgb(255 138 61 / 0.08), transparent 70%),
      var(--night);
  }

  .bte__grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 6fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: center;
  }

  .bte__media img {
    width: 100%;
    border-radius: var(--radius-md);
  }

  .bte__body {
    display: grid;
    gap: 1rem;
    justify-items: start;
  }

  .bte__title {
    font-size: clamp(2rem, 4vw, 3.4rem);
    font-weight: 760;
    font-stretch: 118%;
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .bte__title :global(em) {
    font-family: var(--script);
    font-style: normal;
    font-weight: 400;
    font-size: 1.3em;
    color: var(--tungsten);
  }

  .bte__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .works-cta {
    padding-block: clamp(4rem, 8vw, 6rem);
    border-top: 1px solid var(--hair);
  }

  .works-cta__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  @media (max-width: 56rem) {
    .bte__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
